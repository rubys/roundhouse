load("@compare_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")

exports_files(["Cargo.toml", "Cargo.lock"])

rust_binary(
    name = "roundhouse-compare",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

# Read by the suites (docs_references checks the paths the docs name).
filegroup(
    name = "all_files",
    srcs = glob(["**"], exclude = ["target/**"]),
    visibility = ["//visibility:public"],
)
