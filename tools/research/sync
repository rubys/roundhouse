#!/usr/bin/env python3
"""Render docs/research/frontiers.yaml into the README's dashboard and each brief's header.

frontiers.yaml is the single source for each frontier's status, stands, skills,
next action, latest facts and claims. This script rewrites only the text between
the markers below, in docs/research/README.md and in each brief. With --check it
writes nothing, prints the drift and exits 1 if any generated part is out of date.
It warns, without failing, about active or review claims whose lease has expired.

The reader accepts only the file's restricted YAML shape: block mappings and
sequences indented with spaces, double-quoted or plain scalars, null, and
one-line flow sequences of plain scalars. A plain scalar that YAML would read as
anything but text, or that holds ": " or " #", must be quoted. Anything else is
an error, never a guess. Needs Python 3.9 or later and nothing outside its
standard library.
"""
import argparse
import datetime
import difflib
import os
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
DOCS = ROOT / 'docs' / 'research'
SOURCE = DOCS / 'frontiers.yaml'
README = DOCS / 'README.md'
BEGIN = '<!-- generated by tools/research/sync -->'
END = '<!-- end generated -->'
ISSUES = 'https://github.com/rubys/roundhouse/issues/'

FIELDS = ('id', 'name', 'brief', 'status', 'stands', 'facts', 'skills', 'next',
          'check', 'check_public', 'pins')
CLAIM_FIELDS = ('who', 'scope', 'status', 'since', 'expires', 'pr', 'source')
STATUS = ('open', 'blocked', 'solved')
PUBLIC = ('public', 'partial', 'unavailable')
CLAIM_STATUS = ('active', 'review', 'done', 'released')
LIVE = ('active', 'review')
TIME = '%Y-%m-%dT%H:%MZ'


class Invalid(ValueError):
    pass


# The restricted YAML reader.

KEY = re.compile(r'([A-Za-z_][A-Za-z0-9_]*):(?: |$)')
SPECIAL = re.compile(
    r'(?:~|null|true|false|yes|no|on|off|y|n'
    r'|[-+]?(?:\d[\d_]*(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?'
    r'|0x[0-9a-f_]+|0o[0-7_]+|[-+]?\.inf|\.nan'
    r'|\d{4}-\d\d?-\d\d?.*)$', re.IGNORECASE)


def lines_of(text):
    rows = []
    for number, raw in enumerate(text.splitlines(), 1):
        if '\t' in raw:
            raise Invalid('line {}: indent with spaces, not tabs'.format(number))
        body = raw.strip()
        if body and not body.startswith('#'):
            rows.append([number, len(raw) - len(raw.lstrip(' ')), body])
    return rows


def parse(text):
    rows = lines_of(text)
    if not rows:
        raise Invalid('the file is empty')
    value, i = block(rows, 0, rows[0][1])
    if i != len(rows):
        raise Invalid('line {}: unexpected indentation'.format(rows[i][0]))
    return value


def block(rows, i, indent):
    if rows[i][2] == '-' or rows[i][2].startswith('- '):
        return sequence(rows, i, indent)
    return mapping(rows, i, indent)


def sequence(rows, i, indent):
    items = []
    while i < len(rows) and rows[i][1] == indent and (rows[i][2] == '-' or rows[i][2].startswith('- ')):
        number, _, body = rows[i]
        rest = body[1:].lstrip(' ')
        if not rest:
            if i + 1 == len(rows) or rows[i + 1][1] <= indent:
                raise Invalid('line {}: empty item'.format(number))
            value, i = block(rows, i + 1, rows[i + 1][1])
        elif KEY.match(rest):
            rows[i] = [number, indent + len(body) - len(rest), rest]
            value, i = mapping(rows, i, rows[i][1])
        else:
            value = scalar(rest, number)
            i += 1
        items.append(value)
    return items, i


def mapping(rows, i, indent):
    result = {}
    while i < len(rows) and rows[i][1] == indent:
        number, _, body = rows[i]
        match = KEY.match(body)
        if not match:
            raise Invalid('line {}: expected "key: value"'.format(number))
        key = match.group(1)
        if key in result:
            raise Invalid('line {}: {} appears twice'.format(number, key))
        rest = body[match.end():].strip()
        i += 1
        if rest and not rest.startswith('#'):
            result[key] = scalar(rest, number)
        elif i < len(rows) and rows[i][1] > indent:
            result[key], i = block(rows, i, rows[i][1])
        elif i < len(rows) and rows[i][1] == indent and rows[i][2].startswith('-'):
            raise Invalid('line {}: indent the items under {}'.format(rows[i][0], key))
        else:
            raise Invalid('line {}: {} has no value'.format(number, key))
    return result, i


def scalar(text, number):
    if text.startswith('"'):
        out, i = [], 1
        while i < len(text) and text[i] != '"':
            if text[i] == '\\':
                if text[i + 1:i + 2] not in ('"', '\\'):
                    raise Invalid('line {}: only \\" and \\\\ escapes are supported'.format(number))
                i += 1
            out.append(text[i])
            i += 1
        if i == len(text):
            raise Invalid('line {}: unterminated string'.format(number))
        rest, value = text[i + 1:], ''.join(out)
    elif text.startswith('['):
        close = text.find(']')
        if close < 0:
            raise Invalid('line {}: unterminated list'.format(number))
        inner = text[1:close].strip()
        rest, value = text[close + 1:], [plain(item.strip(), number) for item in inner.split(',')] if inner else []
    else:
        return plain(text, number)
    rest = rest.strip()
    if rest and not rest.startswith('#'):
        raise Invalid('line {}: unexpected text after the value'.format(number))
    return value


def plain(text, number):
    if text == 'null':
        return None
    if (not text or text[0] in '-?:,[]{}#&*!|>\'"%@`' or ': ' in text or text.endswith(':')
            or ' #' in text or SPECIAL.match(text)):
        raise Invalid('line {}: quote this value: {}'.format(number, text))
    return text


# Checking the record.

def need(condition, where, message):
    if not condition:
        raise Invalid('{}: {}'.format(where, message))


def text(value):
    return isinstance(value, str) and value.strip() != ''


def moment(value, where):
    need(isinstance(value, str), where, 'expected a quoted UTC time such as "2026-10-09T07:40Z"')
    try:
        parsed = datetime.datetime.strptime(value, TIME)
    except ValueError:
        raise Invalid('{}: expected a UTC time such as "2026-10-09T07:40Z", got {}'.format(where, value))
    return parsed.replace(tzinfo=datetime.timezone.utc)


def validate(frontiers):
    need(isinstance(frontiers, list) and frontiers, 'frontiers.yaml', 'expected a list of frontiers')
    seen = set()
    for f in frontiers:
        need(isinstance(f, dict), 'frontiers.yaml', 'each frontier must be a mapping')
        where = 'frontier {}'.format(f.get('id'))
        missing = [k for k in FIELDS if k not in f]
        extra = [k for k in f if k not in FIELDS + ('claims',)]
        need(not missing, where, 'missing ' + ', '.join(missing))
        need(not extra, where, 'unknown ' + ', '.join(extra))
        need(text(f['id']) and f['id'] not in seen, where, 'id must be unique text')
        seen.add(f['id'])
        for key in ('name', 'brief', 'stands', 'next', 'check'):
            need(text(f[key]), where, key + ' must be text')
        need((DOCS / f['brief']).is_file(), where, 'no brief at ' + f['brief'])
        need(f['check'].startswith(f['brief'] + '#'), where, 'check must link into the brief')
        need(f['status'] in STATUS, where, 'status must be one of ' + ', '.join(STATUS))
        need(f['check_public'] in PUBLIC, where, 'check_public must be one of ' + ', '.join(PUBLIC))
        need(isinstance(f['facts'], list) and all(re.fullmatch(r'F\d+', str(x)) for x in f['facts']),
             where, 'facts must list IDs such as F5')
        need(isinstance(f['skills'], list) and f['skills'] and all(text(x) for x in f['skills']),
             where, 'skills must list text')
        need(isinstance(f['pins'], dict) and all(text(v) for v in f['pins'].values()),
             where, 'pins must map names to commits')
        claims = f.setdefault('claims', [])
        need(isinstance(claims, list), where, 'claims must be a list')
        for c in claims:
            need(isinstance(c, dict), where, 'each claim must be a mapping')
            at = '{}, claim by {}'.format(where, c.get('who'))
            missing = [k for k in CLAIM_FIELDS if k not in c]
            extra = [k for k in c if k not in CLAIM_FIELDS + ('note',)]
            need(not missing, at, 'missing ' + ', '.join(missing))
            need(not extra, at, 'unknown ' + ', '.join(extra))
            for key in ('who', 'scope', 'source'):
                need(text(c[key]), at, key + ' must be text')
            need(c['status'] in CLAIM_STATUS, at, 'status must be one of ' + ', '.join(CLAIM_STATUS))
            need(moment(c['expires'], at) > moment(c['since'], at), at, 'expires must follow since')
            need(c['pr'] is None or text(c['pr']), at, 'pr must be null or a link')
            need('note' not in c or text(c['note']), at, 'note must be text')


# Rendering.

def linked(value):
    return re.sub(r'(?<![\w\[/])#(\d+)\b', lambda m: '[#{0}]({1}{0})'.format(m.group(1), ISSUES), value)


def stands(f, up):
    out = f['stands'].rstrip('.')
    if f['facts']:
        out += ' (' + ', '.join('[{}]({}facts.md#{})'.format(x, up, x.lower()) for x in f['facts']) + ')'
    return linked(out + '.')


def claim(c):
    state = 'in review' if c['status'] == 'review' else c['status']
    head = '@{}, {} until {}'.format(c['who'], state, c['expires'])
    if c['pr']:
        number = re.search(r'/(\d+)/?$', c['pr'])
        head += ', PR [{}]({})'.format('#' + number.group(1) if number else 'link', c['pr'])
    body = c['scope'] + (' ' + c['note'] if c.get('note') else '')
    return linked('{} ([claim]({})): {}'.format(head, c['source'], body))


def live(f):
    return [c for c in f['claims'] if c['status'] in LIVE]


def cell(value):
    return value.replace('|', '\\|')


def dashboard(frontiers):
    out = ['| Frontier | Skills | Where it stands | Next |', '| --- | --- | --- | --- |']
    for f in frontiers:
        name = '[{}]({})'.format(f['name'], f['brief'])
        if f['status'] != 'open':
            name += ' ({})'.format(f['status'])
        out.append('| ' + ' | '.join(cell(x) for x in (
            name, '; '.join(f['skills']), stands(f, ''), linked(f['next']))) + ' |')
    claims = [(f, c) for f in frontiers for c in live(f)]
    out.append('')
    if claims:
        out += ['Claims in force ([how to claim](#claiming)):', '']
        out += ['- **[{}]({}):** {}'.format(f['name'], f['brief'], claim(c)) for f, c in claims]
    else:
        out.append('No claims are in force; [claim](#claiming) a frontier before starting work on it.')
    return out


def header(f):
    up = os.path.relpath(DOCS, (DOCS / f['brief']).parent).replace(os.sep, '/') + '/'
    claims = ' '.join(claim(c) for c in live(f)) or (
        'none. To take this frontier, see [Claiming]({}README.md#claiming).'.format(up))
    return ['**Stands:** ' + stands(f, up),
            '**Skills:** ' + '; '.join(f['skills']) + '.',
            '**Claims:** ' + claims]


def splice(path, body):
    old = path.read_text()
    where = path.relative_to(ROOT)
    need(old.count(BEGIN) == 1 and old.count(END) == 1 and old.index(BEGIN) < old.index(END),
         where, 'needs one "{}" line and one "{}" line after it'.format(BEGIN, END))
    start, end = old.index(BEGIN) + len(BEGIN), old.index(END)
    return old, old[:start] + '\n' + '\n'.join(body) + '\n' + old[end:]


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--check', action='store_true', help='Write nothing; exit 1 if anything is out of date.')
    args = parser.parse_args()
    try:
        frontiers = parse(SOURCE.read_text())
        validate(frontiers)
        updates = [(README, splice(README, dashboard(frontiers)))]
        updates += [(DOCS / f['brief'], splice(DOCS / f['brief'], header(f))) for f in frontiers]
    except (OSError, Invalid) as error:
        print('sync: ' + str(error), file=sys.stderr)
        return 2
    now = datetime.datetime.now(datetime.timezone.utc)
    for f in frontiers:
        for c in live(f):
            if moment(c['expires'], f['id']) <= now:
                print('sync: the lease of @{} on {} expired at {}; renew it or mark it released'.format(
                    c['who'], f['id'], c['expires']), file=sys.stderr)
    stale = [(path, old, new) for path, (old, new) in updates if old != new]
    for path, old, new in stale:
        where = str(path.relative_to(ROOT))
        if args.check:
            sys.stdout.writelines(difflib.unified_diff(
                old.splitlines(True), new.splitlines(True), where, where + ' (from frontiers.yaml)'))
        else:
            path.write_text(new)
            print('updated ' + where)
    if args.check and stale:
        print('sync: generated text is out of date; run tools/research/sync', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
