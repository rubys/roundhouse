#!/usr/bin/env bash
# Install Playwright's Chromium headless shell and its system deps, BOUNDED.
# CI consumers use default headless Chromium (no channel or headed launch).
# Archive READMEs keep their standalone `playwright install chromium` step.
#
# `npx playwright install --with-deps` shells out to apt itself and
# takes no `-o DPkg::Lock::Timeout`, so the flag 49c596a0 put on every
# apt call in this workflow never reaches it — that commit said so, and
# named this as the residual gap to close "if it recurs". It recurred:
# in run 32207123547 both `browser-smoke-typescript` and `smoke (kotlin)`
# sat in this step from 02:05 to 02:34 with no output and were killed by
# the job timeout, which cancels the WHOLE RUN — so a green campfire
# floor and nine green toolchains reported as "cancelled".
#
# Slow Azure apt mirrors also burn a 240s combined budget mid-download
# (run 37677363805: fonts-wqy-zenhei alone took ~160s; three combined
# `--with-deps` attempts each died before the browser binary phase).
# Split the work so apt and the browser CDN keep separate budgets:
#
#   * `install-deps` — Playwright's own dep list (still one source of
#     truth; no hand-copied package names) under a longer per-attempt
#     timeout; completed .deb downloads can accumulate across retries.
#   * `install --only-shell` — browser bits only, usually seconds.
#
# Shared by every Playwright CI job (browser-smoke-*, smoke, smoke-extra,
# smoke-spinel, smoke-campfire*). Those jobs use a 30m timeout so a slow
# apt day (~3×360s deps + browser) still leaves room for emit/test work.
# Normal install stays under a minute.
#
# Two bounds on top of the split, since the stall is external:
#
#   * the background upgrader that holds the dpkg lock is stopped first,
#     which is the usual cause on the hosted images;
#   * each attempt gets its own timeout and the step retries, so a
#     stalled apt mirror socket costs one attempt rather than the job's
#     entire budget.
#
# NOT the other half of 49c596a0's prescription ("an explicit apt-get of
# the dep list plus a bare `playwright install chromium`"): that list is
# per-browser and per-image, it changes when either moves, and a
# hand-copied list that drifts from what Playwright actually needs is
# the single most common defect in this repo. Asking Playwright for the
# deps and bounding the call keeps one source of truth.
set -euo pipefail

DEPS_ATTEMPTS="${PLAYWRIGHT_DEPS_ATTEMPTS:-3}"
DEPS_TIMEOUT="${PLAYWRIGHT_DEPS_TIMEOUT:-360}"
BROWSER_ATTEMPTS="${PLAYWRIGHT_BROWSER_ATTEMPTS:-2}"
BROWSER_TIMEOUT="${PLAYWRIGHT_BROWSER_TIMEOUT:-90}"

reap_apt_orphans() {
    # `timeout` kills the npx PARENT; the `sudo apt-get` it spawned
    # survives and keeps the dpkg lock, so every retry failed instantly
    # with "held by process N" until this was here. Reap the orphan, let
    # dpkg settle, then try again.
    sudo pkill -TERM -x apt-get 2>/dev/null || true
    sudo pkill -TERM -x dpkg 2>/dev/null || true
    sleep 5
    sudo pkill -KILL -x apt-get 2>/dev/null || true
    sudo dpkg --configure -a 2>/dev/null || true
}

# Run `timeout SECONDS cmd...` up to ATTEMPTS times. LABEL is for warnings.
# Pass "reap" as the fourth argument to clear orphan apt after a failed try.
run_bounded() {
    local label="$1" attempts="$2" seconds="$3" reap="${4:-}"
    shift 4
    local attempt
    for attempt in $(seq 1 "$attempts"); do
        if timeout "$seconds" "$@"; then
            return 0
        fi
        echo "::warning::${label} attempt ${attempt}/${attempts} did not finish within ${seconds}s"
        if [ "$reap" = "reap" ]; then
            reap_apt_orphans
        fi
    done
    return 1
}

# Bounds for the apt PLAYWRIGHT runs, which takes no flags from us.
"$(dirname "$0")/ci-apt-bound"

if ! run_bounded "playwright install-deps" "$DEPS_ATTEMPTS" "$DEPS_TIMEOUT" reap \
    npx playwright install-deps chromium; then
    echo "::error::playwright install-deps did not finish in ${DEPS_ATTEMPTS} bounded attempts of ${DEPS_TIMEOUT}s"
    exit 1
fi

if ! run_bounded "playwright install" "$BROWSER_ATTEMPTS" "$BROWSER_TIMEOUT" noreap \
    npx playwright install --only-shell chromium; then
    echo "::error::playwright install did not finish in ${BROWSER_ATTEMPTS} bounded attempts of ${BROWSER_TIMEOUT}s"
    exit 1
fi
