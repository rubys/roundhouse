#!/usr/bin/env bash
# scripts/build-campfire-archive — build the downloadable campfire archive.
#
# Produces `<out>/campfire/spinel.tgz`: ONCE Campfire, transpiled for the
# spinel target, with its static assets prebuilt and a README whose fenced
# ```sh blocks ARE the build and test steps. `scripts/smoke` runs that
# README against the unpacked archive, the same docs-as-contract deal the
# per-target blog archives get.
#
# Also produces `<out>/campfire/docker.tgz` when `spin` is on PATH: the
# same program after `spin pack` — generated C + the spinel runtime as
# SOURCE + a Makefile — beside what the binary reads at run time and a
# two-stage Dockerfile. That archive needs Docker and nothing else, and
# does not depend on a spinel checkout at all: the runtime it was
# generated against travels with it. See scripts/campfire-docker-files.
#
# WHY THIS IS NOT `roundhouse --site`. That mode is "for every target,
# write browse/<lang>.{json,tgz,zip}" from ONE fixture, and its archive
# writer is text-only — every file is a `(String, String)`, so campfire's
# hundred binary assets (mp3, png, webp, gif) could not be represented at
# all. This script tars a DIRECTORY that `--target spinel -o` already
# populated, binary assets included (`project::write_binary_assets`), so
# the whole problem disappears rather than being solved twice.
#
# THE ARCHIVE IS SOURCE, NOT A BINARY. That is what makes "download it"
# portable: the downloader compiles it with spinel for their own platform.
# It also means this script never has to answer "which platforms do we
# ship", which was the open question packaging started from.
#
# Usage:  scripts/build-campfire-archive [options] [APP_PATH]
#
#   APP_PATH   ONCE Campfire checkout. Default: ~/git/once-campfire
#
# Options:
#   --out DIR        Site output root; archive lands at DIR/campfire/spinel.tgz
#                    (default: _site)
#   --keep-tree DIR  Also leave the emitted tree at DIR (debugging).
#   --skip-assets    Don't run `make assets` (fast re-runs; the archive is
#                    then NOT self-contained and every /assets/* 404s).
#   --skip-docker    Don't build campfire/docker.tgz (also skipped, with a
#                    warning, when `spin` is not on PATH).
#
# Requires: cargo, tar, and — unless --skip-assets — ruby + bundler, which
# `make assets` uses to locate the turbo-rails / stimulus-rails / actioncable
# / actiontext gem dirs; and, for docker.tgz, `spin` (with `spinel` beside
# it). Downloaders need none of that: the assets ship built.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

APP="$HOME/git/once-campfire"
OUT="$REPO_ROOT/_site"
KEEP_TREE=""
SKIP_ASSETS=0
SKIP_DOCKER=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --out)         OUT="$2"; shift 2 ;;
        --keep-tree)   KEEP_TREE="$2"; shift 2 ;;
        --skip-assets) SKIP_ASSETS=1; shift ;;
        --skip-docker) SKIP_DOCKER=1; shift ;;
        -h|--help)     sed -n '2,/^set -euo/p' "$0" | sed 's/^# \?//;$d'; exit 0 ;;
        -*)            echo "unknown flag: $1" >&2; exit 2 ;;
        *)             APP="$1"; shift ;;
    esac
done

step() { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31mFAIL\033[0m %s\n' "$*" >&2; exit 1; }

[[ -d "$APP" ]] || fail "no campfire checkout at $APP"

WORK="$(mktemp -d -t campfire-archive.XXXXXX)"
trap 'rm -rf "$WORK"' EXIT
TREE="$WORK/campfire"

# ── 1. transpile ──────────────────────────────────────────────────────
#
# STRICT: no --allow-unsupported. An unsupported construct is an error and
# the run writes nothing, which is the ceiling `campfire-conformance`
# already enforces at 0. A downloadable archive is the wrong place to
# discover that the ceiling moved.
step "transpiling $APP → spinel"
(cd "$REPO_ROOT" && cargo run --release --quiet --bin roundhouse -- \
    --target spinel "$APP" -o "$TREE") 2>"$WORK/emit.log" || {
    tail -30 "$WORK/emit.log" >&2
    fail "transpile failed"
}
errors=$(grep -c 'error\[' "$WORK/emit.log" || true)
[[ "$errors" -eq 0 ]] || { grep 'error\[' "$WORK/emit.log" >&2; fail "$errors emit error(s)"; }
echo "  $(find "$TREE" -type f | wc -l | tr -d ' ') files"

# ── 2. name the binary after the app ──────────────────────────────────
#
# The emitter writes `bin/blog.rb` unconditionally — spin's unit of build
# is `bin/<name>.rb`, and the name has never been parameterised. Shipping a
# campfire download whose binary is called `blog` is wrong where people
# look, so rename here and fix the Makefile's two references to match.
# FOLLOW-ON: parameterise it in src/project.rs so this step can go away.
step "naming the binary 'campfire'"
mv "$TREE/bin/blog.rb" "$TREE/bin/campfire.rb"
sed -i.bak -e 's|build/bin/blog|build/bin/campfire|g' \
           -e 's|$(BUILD)/blog|$(BUILD)/campfire|g' \
           -e 's|build/blog|build/campfire|g' "$TREE/Makefile"
rm -f "$TREE/Makefile.bak"
sed -i.bak 's|build/bin/blog|build/bin/campfire|' "$TREE/bin/campfire.rb"
rm -f "$TREE/bin/campfire.rb.bak"

# ── 3. static assets ──────────────────────────────────────────────────
#
# Built HERE so the download needs no Ruby. `make assets` shells `bundle
# exec ruby` to locate four gem dirs; the binary then sendfiles the result
# from static/assets/. Without this the room page's ninety-five ES module
# pins and twenty-six stylesheets all 404 behind a 200, which is precisely
# what e2e/campfire/assets.spec.js exists to catch.
if (( SKIP_ASSETS )); then
    step "skipping assets (--skip-assets)"
else
    step "building static assets"
    (cd "$TREE" && bundle install --quiet && make assets >/dev/null) \
        || fail "make assets failed"
    echo "  $(find "$TREE/static" -type f | wc -l | tr -d ' ') files in static/"
fi

# ── 4. drop the attachment fixtures ───────────────────────────────────
#
# 50 MB of the tree is binary fixtures for the attachment tests — a single
# 46 MB earth.png, a 3.8 MB .mov, a 494 KB jpg. Attachments are out of this
# MVP and no shipped section opens them, so they are 50 MB of download for
# nothing. The test SOURCES stay: they cost 6 MB and make the follow-on
# that adds a native `## Test` section a smaller change.
step "dropping attachment fixtures"
rm -rf "$TREE/test/fixtures/files"

# ── 5. the archive's own README and e2e suite ─────────────────────────
#
# The emitter injects the BLOG's README and the blog's Playwright specs
# (`/articles`, `SELECT COUNT(*) FROM articles`). Both are replaced here
# with campfire's.
step "installing the campfire README + e2e suite"
rm -rf "$TREE/e2e"
mkdir -p "$TREE/e2e"
cp "$REPO_ROOT"/e2e/campfire/*.spec.js "$REPO_ROOT/e2e/campfire/helpers.js" "$TREE/e2e/"
cp "$REPO_ROOT/e2e/campfire/package.json" "$TREE/e2e/package.json"

ROUNDHOUSE_SHA="$(cd "$REPO_ROOT" && git rev-parse --short HEAD 2>/dev/null || echo unknown)"
CAMPFIRE_SHA="$(cd "$APP" && git rev-parse --short HEAD 2>/dev/null || echo unknown)"
SPINEL_VERSION="$(spinel --version 2>/dev/null | head -1 || echo 'not on PATH at build time')"

"$REPO_ROOT/scripts/campfire-archive-files" "$TREE" \
    "$ROUNDHOUSE_SHA" "$CAMPFIRE_SHA" "$SPINEL_VERSION"

# ── 6. pack ───────────────────────────────────────────────────────────
step "packing"
mkdir -p "$OUT/campfire"
tar czf "$OUT/campfire/spinel.tgz" -C "$WORK" campfire
if [[ -n "$KEEP_TREE" ]]; then
    rm -rf "$KEEP_TREE"; cp -R "$TREE" "$KEEP_TREE"
    echo "  tree kept at $KEEP_TREE"
fi
printf '\n\033[1;32mok\033[0m  %s (%s)\n' \
    "$OUT/campfire/spinel.tgz" \
    "$(du -h "$OUT/campfire/spinel.tgz" | cut -f1 | tr -d ' ')"

# ── 7. the Docker archive ─────────────────────────────────────────────
#
# `spin pack` writes a directory that builds from C alone (matz/spinel
# 32ad55a6): the generated TU, the runtime as source, every native
# package's source, and a Makefile derived from `spinel --print-build`.
# Beside it goes what the binary reads at run time — and only that: the
# emitted Ruby, the tests and the e2e suite stay in spinel.tgz. The
# result is 5 MB where the source archive is 13 MB, because none of the
# Ruby ships and the generated C compresses 9:1.
#
# Tolerant of a missing `spin` ON PURPOSE: CI's spinel toolchain is an
# advisory build of matz/spinel master, and the source archive must keep
# publishing when it is red.
if (( SKIP_DOCKER )); then
    step "skipping the Docker archive (--skip-docker)"
elif ! command -v spin >/dev/null 2>&1; then
    step "skipping the Docker archive (no \`spin\` on PATH)"
    echo "::warning::campfire/docker.tgz not built: spin is not on PATH"
else
    step "packing for Docker"
    DOCKER="$WORK/campfire-docker"
    mkdir -p "$DOCKER/app"
    (cd "$TREE" && spin pack campfire --out "$DOCKER/pack" >"$WORK/pack.log" 2>&1) || {
        tail -30 "$WORK/pack.log" >&2
        fail "spin pack failed"
    }
    # A native package whose source the pack could not find is a Makefile
    # that fails on the downloader's machine. spin says so at pack time;
    # make it fatal here rather than there.
    if grep -q 'pack: warning' "$WORK/pack.log"; then
        grep 'pack: warning' "$WORK/pack.log" >&2
        fail "spin pack left a native package behind"
    fi
    # What main.rb reads: static/ (serve_static), public/ (error pages),
    # config/purchased_by.yml, db/seed.sql. storage/ is created by the
    # Dockerfile so the volume mount has a directory to land on.
    cp -R "$TREE/static" "$TREE/public" "$TREE/db" "$TREE/config" "$DOCKER/app/"
    cp "$APP/MIT-LICENSE" "$DOCKER/"
    "$REPO_ROOT/scripts/campfire-docker-files" "$DOCKER" \
        "$ROUNDHOUSE_SHA" "$CAMPFIRE_SHA" "$SPINEL_VERSION"
    echo "  pack: $(find "$DOCKER/pack" -type f | wc -l | tr -d ' ') files," \
         "$(du -sh "$DOCKER/pack/src" | cut -f1 | tr -d ' ') of generated C"
    tar czf "$OUT/campfire/docker.tgz" -C "$WORK" campfire-docker
    printf '\033[1;32mok\033[0m  %s (%s)\n' \
        "$OUT/campfire/docker.tgz" \
        "$(du -h "$OUT/campfire/docker.tgz" | cut -f1 | tr -d ' ')"
fi
