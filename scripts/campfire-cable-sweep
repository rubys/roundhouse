#!/usr/bin/env bash
# scripts/campfire-cable-sweep — a campfire server under N held-open cable
# sockets, for a list of N: connect storm, idle cost, fan-out cost per
# subscriber, and the disconnect storm (scripts/campfire-cable-sweep.rb
# does the measuring). The server is pinned to a CPU set so a tier of
# once.com/campfire's table can be run on its own core count; RSS and CPU
# are read off the process TREE, which is what lets the same harness time
# a one-process binary and a clustered Puma.
#
# THREE LANES, ONE SCRIPT, and that is the point. `--lane binary` runs
# the compiled campfire; `--lane ruby` runs the SAME EMITTED APP on
# CRuby under Puma; `--lane rails` runs campfire itself, as ONCE deploys
# it — clustered Puma, Redis for the cable adapter and the fragment
# cache, production env — out of the tree `scripts/campfire-oracle
# prepare` builds. Same driver, same seeded database, same cores, same
# cookie file. A number from any lane that was produced by a different
# script is not a comparison.
#
# WHY THE `ruby` LANE EXISTS, and it is not "one more target". `binary`
# and `ruby` run THE SAME cable.rb — the same event loop, the same
# shared sliced heartbeat, the same fan-out — on two different runtimes.
# Without it, every number this harness prints about our cable confounds
# the DESIGN with SPINEL: an idle cost of 0.011 cores against Rails'
# 0.0125 could be the reactor or it could be the compiler, and nothing
# on the page can tell you which. One process each, same design, two
# runtimes is the comparison that separates them.
#
# THE `ruby` LANE IS SINGLE-WORKER, AND THAT IS ENFORCED BELOW, not
# documented and hoped for. The emitted `cable.rb` says it: "Single-
# worker only. Clustered Puma (workers > 1) needs an inter-worker pubsub
# — Redis in campfire's own deployment — behind the same
# `Broadcasts.set_transport` seam this file plugs into." `Cable::Registry`
# is per-process, so at two workers a broadcast reaches only the
# subscribers that happen to share a process with the poster and the
# harness would report a delivery rate as a performance number.
#
# WHY THE COOKIE FILE IS NOT OPTIONAL ABOVE A FEW DOZEN SOCKETS: campfire
# rate-limits sign-in to 10 per 3 minutes per IP. `scripts/campfire-oracle
# cookies` mints one signed `session_token` per seeded user, and both
# lanes verify it — so SECRET_KEY_BASE has to be the one the file was
# minted under, which is why it is passed to the binary too.
#
# Usage: scripts/campfire-cable-sweep --bin PATH --db PATH [--cpus 0-3]
#        [--lane binary|ruby|rails] [--emit DIR] [--oracle DIR] [--threads 5]
#        [--workers 4] [--sizes "10 30 100 300 1000"] [--per-room 50]
#        [--idle 20] [--messages 30] [--rate 2] [--out DIR] [--port 19800]
#        [--cookies FILE] [--secret KEY] [--no-presence] [--env K=V ...]
#        [--pace SECONDS]
set -uo pipefail
BIN=""; DB=""; CPUS="0-3"; WORKERS=4; SIZES="10 30 100 300 1000"; PER_ROOM=50
IDLE=20; MESSAGES=30; RATE=2; OUT=""; PORT=19800; BIG_ROOM=""
LANE=binary; ORACLE=""; THREADS=5; COOKIES=""; PRESENCE=1; EXTRA_ENV=(); PACE=""
EMIT=""
SECRET="${SECRET_KEY_BASE:-campfire-oracle-benchmark-secret-not-a-deployment}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --bin) BIN="$2"; shift 2 ;; --db) DB="$2"; shift 2 ;; --cpus) CPUS="$2"; shift 2 ;;
    --workers) WORKERS="$2"; shift 2 ;; --sizes) SIZES="$2"; shift 2 ;; --per-room) PER_ROOM="$2"; shift 2 ;;
    --idle) IDLE="$2"; shift 2 ;; --messages) MESSAGES="$2"; shift 2 ;; --rate) RATE="$2"; shift 2 ;;
    --out) OUT="$2"; shift 2 ;; --port) PORT="$2"; shift 2 ;; --big-room) BIG_ROOM="$2"; shift 2 ;;
    --lane) LANE="$2"; shift 2 ;; --oracle) ORACLE="$2"; shift 2 ;; --threads) THREADS="$2"; shift 2 ;;
    --emit) EMIT="$2"; shift 2 ;;
    --cookies) COOKIES="$2"; shift 2 ;; --secret) SECRET="$2"; shift 2 ;;
    --no-presence) PRESENCE=0; shift ;;
    # A/B ONE BINARY AGAINST ITSELF. The runtime knob that decides a
    # measurement is often an environment variable -- SPINEL_SCHED_POLL=1
    # is the pre-epoll scheduler backend -- and a before/after built from
    # two different binaries on two different days is not a comparison.
    # Repeatable; binary lane only (the rails lane's env is what ONCE
    # deploys, and adding to it would make it something else).
    --env) EXTRA_ENV+=("$2"); shift 2 ;;
    --pace) PACE="$2"; shift 2 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done
HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
ORACLE="${ORACLE:-$REPO/build/campfire-oracle}"
[[ -f "$DB" ]] || { echo "need --db (seeded sqlite)" >&2; exit 2; }
if [[ "$LANE" == binary ]]; then
  [[ -x "$BIN" ]] || { echo "need --bin (executable) on the binary lane" >&2; exit 2; }
  BINDIR="$(cd "$(dirname "$BIN")/../.." && pwd)"   # spin layout: build/bin/campfire under the tree
  SERVER_NAME="$(basename "$BIN")"
elif [[ "$LANE" == ruby ]]; then
  [[ -d "$EMIT" ]] || { echo "need --emit DIR (the transpiled CRuby tree) on the ruby lane" >&2; exit 2; }
  EMIT="$(cd "$EMIT" && pwd)"
  [[ -f "$EMIT/config.ru" ]] || { echo "no config.ru under $EMIT — is that the emitted tree?" >&2; exit 2; }
  # REFUSED, not warned. `Cable::Registry` is per-process; at two workers
  # a broadcast reaches only the poster's own process and the driver
  # would record the misses as a delivery RATE rather than as a broken
  # configuration. A harness that can report a wrong number confidently
  # is worse than one that stops.
  if [[ "$WORKERS" != 1 ]]; then
    echo "the ruby lane is single-worker only (asked for $WORKERS): the emitted cable's" >&2
    echo "registry is per-process and cross-worker broadcast needs a transport behind" >&2
    echo "Broadcasts.set_transport, which is not implemented. Re-run with --workers 1." >&2
    exit 2
  fi
else
  [[ -d "$ORACLE" ]] || { echo "no oracle at $ORACLE — scripts/campfire-oracle prepare" >&2; exit 2; }
  command -v redis-cli >/dev/null && redis-cli ping >/dev/null 2>&1 \
    || echo "warning: redis is not answering — campfire's cable adapter AND its fragment cache are Redis" >&2
fi
COOKIES="${COOKIES:-$ORACLE/tmp/session-cookies.txt}"
[[ -f "$COOKIES" ]] || { echo "no cookie file at $COOKIES — scripts/campfire-oracle cookies --count N" >&2; exit 2; }
OUT="${OUT:-/tmp/cable-sweep-$(date -u +%Y%m%d-%H%M%S)}"; mkdir -p "$OUT"
# ABSOLUTE: `start_server` runs the server from ITS OWN tree (`cd
# "$BINDIR"` / `cd "$ORACLE"`), so a relative --out would put the
# server's log — and the readiness the harness waits on — under the app's
# directory instead. A relative --out is what silenced both socket lanes
# on the first published campfire run.
OUT="$(cd "$OUT" && pwd)"

# THE ORACLE'S DATABASE IS BORROWED, NOT TAKEN. The rails lane serves out
# of the oracle tree, so a `--db` from anywhere else gets copied over
# `storage/db/production.sqlite3` — and has to be put back, or every
# other harness reading that tree afterwards (bench-campfire's HTTP
# lanes, campfire-queries, campfire-compare) measures rows it did not
# ask for. Globals and a trap, because an EXIT trap fires after the
# function that would have held these as `local` has returned, and under
# `set -u` that is how the restore dies instead of running.
# Armed HERE, in the parent shell, and not inside `start_server`: that
# one is called as `$(start_server ...)`, a command substitution, so
# anything it assigns is set in a subshell and the EXIT trap below — which
# runs in the parent — would see an empty string and restore nothing.
# The oracle kept the socket tier's 1,000-user database twice before this
# moved out here.
ORACLE_DB_BAK=""
if [[ "$LANE" == rails && -f "$ORACLE/storage/db/production.sqlite3" ]] \
   && [[ ! "$DB" -ef "$ORACLE/storage/db/production.sqlite3" ]]; then
    ORACLE_DB_BAK="$ORACLE/tmp/sweep-oracle-prod.sqlite3"
    mkdir -p "$ORACLE/tmp"
    cp "$ORACLE/storage/db/production.sqlite3" "$ORACLE_DB_BAK"
fi
restore_oracle_db() {
    [[ -n "$ORACLE_DB_BAK" && -f "$ORACLE_DB_BAK" ]] || return 0
    cp "$ORACLE_DB_BAK" "$ORACLE/storage/db/production.sqlite3"
    rm -f "$ORACLE/storage/db/production.sqlite3-wal" "$ORACLE/storage/db/production.sqlite3-shm"
    return 0
}
trap 'restore_oracle_db' EXIT INT TERM
ulimit -n 65536 || true
# Their Dockerfile's allocator, if this box has one.
JEMALLOC=""
for c in /usr/local/lib/libjemalloc.so /usr/lib/x86_64-linux-gnu/libjemalloc.so.2 \
         /usr/lib/aarch64-linux-gnu/libjemalloc.so.2 /usr/lib64/libjemalloc.so.2 \
         /opt/homebrew/lib/libjemalloc.dylib; do
    [[ -e "$c" ]] && { JEMALLOC="$c"; break; }
done
[[ "$LANE" == rails || "$LANE" == ruby ]] && echo "sweep: $LANE lane allocator: ${JEMALLOC:-stock malloc (no jemalloc found)}"
# The pin is the whole point of a tier — but a Mac has no taskset, and a
# harness that only runs where it publishes cannot be smoke-tested before
# it gets there. Absent, the run says so rather than silently measuring
# the whole box.
PIN=(taskset -c "$CPUS")
command -v taskset >/dev/null || { PIN=(); echo "warning: no taskset — the server is NOT pinned to $CPUS; this run is a smoke test, not a tier" >&2; }
echo "sweep: lane=$LANE on cpus $CPUS, $WORKERS workers, sizes: $SIZES (~$PER_ROOM per room) -> $OUT"
[[ -n "${EXTRA_ENV[*]:-}" ]] && echo "sweep: server env: ${EXTRA_ENV[*]}"

# Boot the lane's server on $PORT with a fresh copy of the seed, and
# echo the pid to stdout. `exec` in the subshell so `$!` IS the server
# and nothing has to be found by name — a `pgrep` pattern that also
# matches the command that launched it is how an ssh session gets killed.
start_server() {   # $1 = label
  local label="$1"
  if [[ "$LANE" == binary ]]; then
    [[ "$DB" -ef "$BINDIR/storage/development.sqlite3" ]] || cp "$DB" "$BINDIR/storage/development.sqlite3"
    rm -f "$BINDIR/storage/development.sqlite3-wal" "$BINDIR/storage/development.sqlite3-shm"
    ( cd "$BINDIR" && exec env SPINEL_WORKERS="$WORKERS" DATABASE_POOL_SIZE=64 \
        BLOG_DB=storage/development.sqlite3 PORT="$PORT" SECRET_KEY_BASE="$SECRET" \
        ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"} \
        "${PIN[@]}" "./build/bin/$SERVER_NAME" > "$OUT/server-$label.log" 2>&1 ) &
  elif [[ "$LANE" == ruby ]]; then
    # THE SAME APP AS THE BINARY LANE, on CRuby. Same seeded database
    # (the emit reads `storage/development.sqlite3`), same
    # SECRET_KEY_BASE so the minted cookie file verifies here too, same
    # pin, same jemalloc as the rails lane — their Dockerfile preloads
    # it and the headline column on this phase is memory, so an
    # allocator difference here would be measuring malloc.
    #
    # `-w 1` is not a tuning choice, it is the only correct one: see the
    # single-worker note in the header. The guard above has already
    # refused anything else, so this cannot silently drift.
    [[ "$DB" -ef "$EMIT/storage/development.sqlite3" ]] || cp "$DB" "$EMIT/storage/development.sqlite3"
    rm -f "$EMIT/storage/development.sqlite3-wal" "$EMIT/storage/development.sqlite3-shm"
    ( cd "$EMIT" && exec env RAILS_ENV=production RUBY_YJIT_ENABLE=1 \
        RAILS_MAX_THREADS="$THREADS" ${JEMALLOC:+LD_PRELOAD="$JEMALLOC"} \
        DB_PATH=storage/development.sqlite3 SECRET_KEY_BASE="$SECRET" \
        RAILS_LOG_LEVEL="${RAILS_LOG_LEVEL:-warn}" \
        "${PIN[@]}" bundle exec puma -p "$PORT" -w 1 -t "$THREADS:$THREADS" config.ru \
        > "$OUT/server-$label.log" 2>&1 ) &
  else
    # AS ONCE DEPLOYS IT. WEB_CONCURRENCY is what campfire's config/puma.rb
    # reads; unpinned it computes `(processor_count * 0.666).ceil` and the
    # oracle would size itself to the box instead of to the tier. Redis is
    # left alone — flushing the fragment cache between cells would measure
    # a cold Rails nobody runs.
    mkdir -p "$ORACLE/storage/db"
    # SERVING A DATABASE THAT IS NOT THE ORACLE'S MEANS BORROWING ITS
    # TREE. The rails lane runs out of the oracle, which reads
    # `storage/db/production.sqlite3`, so a `--db` from anywhere else has
    # to be copied over it — and put back, or every other harness that
    # reads that tree (bench-campfire's HTTP lanes, campfire-queries,
    # campfire-compare) silently measures the wrong rows afterwards. That
    # happened the first time the socket tier was given its own 1,000-user
    # seed: the sweep left it in place and the oracle answered 1000/20.
    [[ "$DB" -ef "$ORACLE/storage/db/production.sqlite3" ]] || cp "$DB" "$ORACLE/storage/db/production.sqlite3"
    rm -f "$ORACLE/storage/db/production.sqlite3-wal" "$ORACLE/storage/db/production.sqlite3-shm"
    # jemalloc, because their Dockerfile preloads it and the headline
    # column on this phase is memory. Absent, the lane runs on stock
    # malloc and the summary says so rather than quietly comparing
    # allocators.
    ( cd "$ORACLE" && exec env WEB_CONCURRENCY="$WORKERS" RAILS_MAX_THREADS="$THREADS" \
        ${JEMALLOC:+LD_PRELOAD="$JEMALLOC"} \
        RAILS_ENV=production DISABLE_SSL=1 SECRET_KEY_BASE="$SECRET" \
        RAILS_LOG_LEVEL="${RAILS_LOG_LEVEL:-warn}" RUBY_YJIT_ENABLE=1 \
        "${PIN[@]}" bundle exec puma -p "$PORT" -e production config.ru \
        > "$OUT/server-$label.log" 2>&1 ) &
  fi
  echo $!
}

run_one() {   # $1 = N, $2 = rooms list, $3 = label
  local n="$1" rooms="$2" label="$3"
  local pid; pid="$(start_server "$label")"
  for i in $(seq 1 600); do curl -s -o /dev/null "http://127.0.0.1:$PORT/session/new" && break; sleep 0.2; done
  echo "== N=$n rooms=$rooms (lane $LANE, server pid $pid)"
  local presence_flag=""; [[ "$PRESENCE" == 0 ]] && presence_flag="--no-presence"
  local pace_flag=""; [[ -n "$PACE" ]] && pace_flag="--pace $PACE"
  ruby "$HERE/campfire-cable-sweep.rb" --base "http://127.0.0.1:$PORT" --sockets "$n" --rooms "$rooms" --users 10000 \
       --cookies "$COOKIES" $presence_flag $pace_flag \
       --idle "$IDLE" --messages "$MESSAGES" --rate "$RATE" --pid "$pid" --json "$OUT/$label.json" 2>&1 | sed 's/^/   /'
  local st="alive"
  if kill -0 "$pid" 2>/dev/null; then kill -TERM "$pid"; for i in $(seq 1 150); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    kill -0 "$pid" 2>/dev/null && { kill -KILL "$pid"; st="killed"; }
  else st="CRASHED"; fi
  wait "$pid" 2>/dev/null
  echo "   server: $st"
  [[ -f "$OUT/$label.json" ]] && python3 -c "import json,sys; d=json.load(open('$OUT/$label.json')); d['label']='$label'; d['lane']='$LANE'; d['server']='$st'; print(json.dumps(d))" >> "$OUT/results.jsonl"
}

for n in $SIZES; do
  r=$(( (n + PER_ROOM - 1) / PER_ROOM )); [[ $r -lt 1 ]] && r=1
  # The cap is the seed's room count, and hitting it changes the
  # WORKLOAD rather than the size: the sockets pile into fewer rooms and
  # each message costs one write per subscriber there. Say so, because
  # the resulting fan-out latency is not comparable to an uncapped cell.
  if [[ $r -gt 20 ]]; then
    echo "warning: $n sockets at $PER_ROOM per room wants $r rooms; the seed has 20, so this cell runs $(( (n + 19) / 20 )) per room" >&2
    r=20
  fi
  rooms="$(seq -s, 1 $r)"
  run_one "$n" "$rooms" "n$n"
done
[[ -n "$BIG_ROOM" ]] && run_one "$BIG_ROOM" "1" "big$BIG_ROOM"

echo; echo "== summary ($OUT/results.jsonl)"
python3 - "$OUT/results.jsonl" <<'PY'
import json,sys
rows=[json.loads(l) for l in open(sys.argv[1])]
print("| lane | N | subs/room | storm s | storm cpu s | failed | idle cpu cores | idle RSS / PSS MB | pings | delivered/expected | frame p50 / p99 ms | last p99 ms | chat cpu cores | us/frame | teardown cpu s | server |")
print("|--|--:|--:|--:|--:|--:|--:|--:|--:|--:|--:|--:|--:|--:|--:|--|")
for d in rows:
    i,c,s=d['idle'],d['chat'],d['storm']
    t=d.get('teardown',{})
    mem=f"{i['rss_mb']} / {i.get('pss_mb') or '-'}"
    print(f"| {d.get('lane','?')} | {d['sockets']} | {d['subscribers_per_room']} | {s['seconds']} | {s.get('cpu_seconds')} | {s['failed']} | {i['cpu_cores']} | {mem} | {i['pings']} | {c['delivered']}/{c['expected']} | {c['frame_p50_ms']} / {c['frame_p99_ms']} | {c['last_p99_ms']} | {c['cpu_cores']} | {c['us_per_frame']} | {t.get('cpu_seconds')} | {d['server']} |")
PY
