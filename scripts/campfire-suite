#!/usr/bin/env bash
# scripts/campfire-suite — run ONCE Campfire's OWN test suite against the emit.
#
# The C4 rung of the campfire coverage ladder: transpile campfire for the
# `ruby` target (or `spinel` — see below), then run each of the app's own
# test files and tally pass/fail. Unlike the walk (scripts/campfire-walk), which drives one
# hand-written path, this measures the app's own assertions — the suite is
# the spec campfire's authors wrote, so "how many of its files run green" is
# the honest coverage number.
#
# THE FILE LIST IS THE APP'S, NOT OURS. The emitted Makefile's SPINEL_TESTS
# is generated from the app's own test tree, so it is read from the emit
# rather than restated here. `find test -name '*_test.rb'` would also sweep
# in the scaffold's own tests (cgi_io_test, article_broadcasts_test, the
# blog's view tests), which campfire's list correctly excludes — counting
# those inflates both numerator and denominator with tests that are not
# campfire's.
#
# STUBS: scripts/campfire-walk-stubs.rb is spliced in, same ledger, same
# rule — a gap closed in the compiler is an entry DELETED there. `--no-stubs`
# runs without it to check whether an entry still earns its place.
#
# THE SPINEL LANE (`--target spinel`) compiles each of campfire's test
# files to its own native binary and runs THAT. Same emitted source and
# the same autorun shim (emit/ruby.rs::render_autorun_shim is emitted for
# both ruby shapes), so a compiled test prints the per-test lines this
# script already parses and the tally format is unchanged — with ONE
# addition. The compiled lane has a failure mode the interpreted one
# cannot have: a file that never links. That is a third status, BUILD,
# carrying the file's whole test count against its first compile error.
# Three outcomes per file, and the three are the point of the lane:
# didn't link / linked and diverged / linked and agreed.
#
# The compiles are PARALLEL (`--jobs`, default 8) and the runs are
# SERIAL — the binaries share one sqlite file. Each compile is a whole-
# program build, so this lane costs minutes where the ruby lane costs
# seconds. Never batch several test files into one compile: that is what
# found matz/spinel#4340, and it measures a different thing.
#
# NO STUBS BY DEFAULT ON THAT LANE. walk_stubs.rb is Ruby spliced into
# boot.rb, which every test requires — under spinel it must also COMPILE,
# so a stub that does not takes all 54 files rather than the one it was
# written for. `--stubs` asks for it anyway; the JSON records which.
#
# Usage:  scripts/campfire-suite [options] [APP_PATH]
#
#   APP_PATH   Rails app to transpile. Default: ~/git/once-campfire
#
# Options:
#   --target T   `ruby` (default) or `spinel` — see above.
#   --jobs N     Parallel compiles for --target spinel (default 8).
#   --timeout N  Seconds a single spinel binary may run (default 120).
#   --out DIR    Emit into DIR and keep it (default: a temp dir, removed).
#   --keep       Keep the temp emit and print its path.
#   --reuse DIR  Skip transpiling; run against an emit DIR prepared earlier.
#   --no-stubs   Splice nothing (see scripts/campfire-walk's note).
#   --stubs      Splice anyway — the spinel lane's default is off.
#   --filter PAT Only run test files whose path matches PAT (grep -E).
#   --tally FILE Write the `STATUS|file|passed|total|first-error` table
#                to FILE.
#   --fail-log FILE  Write EVERY failing test's line (`file|Class#test|msg`)
#                to FILE. The tally keeps only a file's FIRST failure, which
#                is the right thing to work on but the wrong thing to rank by:
#                it credits that one wall with every unpassed test in the file,
#                and `messages_controller_test` reads as 12 tests behind
#                `fresh_when` when only 3 of them ever call it. Rank from this.
#   --json FILE  Write the machine-readable summary the published page is
#                rendered from (scripts/campfire-suite-summary, then
#                scripts/campfire-suite-report). Implies --tally and
#                --fail-log; both go to temp files unless also asked for.
#
# Exit status is 0 when the run completes, whatever the tally — this
# reports a number, it does not gate on one. A CI rung that pins a floor
# reads the tally.
#
# Requires: cargo, ruby, the sqlite3 CLI.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

APP="$HOME/git/once-campfire"
OUT=""
KEEP=0
STUBS=1
STUBS_SET=0
TARGET=ruby
JOBS=8
TIMEOUT=120
REUSE=""
FILTER=""
TALLY=""
FAIL_LOG=""
JSON=""
TMP_TALLY=""
TMP_FAIL=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --out)       OUT="$2"; KEEP=1; shift 2 ;;
        --keep)      KEEP=1;   shift ;;
        --reuse)     REUSE="$2"; shift 2 ;;
        --no-stubs)  STUBS=0; STUBS_SET=1; shift ;;
        --stubs)     STUBS=1; STUBS_SET=1; shift ;;
        --target)    TARGET="$2"; shift 2 ;;
        --jobs)      JOBS="$2"; shift 2 ;;
        --timeout)   TIMEOUT="$2"; shift 2 ;;
        --filter)    FILTER="$2"; shift 2 ;;
        --tally)     TALLY="$2"; shift 2 ;;
        --fail-log)  FAIL_LOG="$2"; shift 2 ;;
        --json)      JSON="$2"; shift 2 ;;
        -h|--help)   sed -n '2,/^$/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        -*)          echo "unknown flag: $1" >&2; exit 2 ;;
        *)           APP="$1"; shift ;;
    esac
done

# The summary is a pure function of the tally and the fail-log, so --json
# just guarantees both exist. Asking for them explicitly as well keeps
# them; otherwise they are scratch.
if [[ -n "$JSON" ]]; then
    if [[ -z "$TALLY" ]]; then
        TALLY="$(mktemp -t campfire-tally.XXXXXX)"; TMP_TALLY="$TALLY"
    fi
    if [[ -z "$FAIL_LOG" ]]; then
        FAIL_LOG="$(mktemp -t campfire-faillog.XXXXXX)"; TMP_FAIL="$FAIL_LOG"
    fi
fi

case "$TARGET" in
    ruby)   ;;
    spinel) ;;
    *) echo "campfire-suite: --target must be ruby or spinel, got $TARGET" >&2; exit 2 ;;
esac

# See NO STUBS BY DEFAULT in the header: on the spinel lane a stub has to
# compile as well as run, and boot.rb is loaded by every test file.
if [[ "$TARGET" == spinel && $STUBS_SET -eq 0 ]]; then STUBS=0; fi

command -v sqlite3 >/dev/null || { echo "campfire-suite: needs the sqlite3 CLI" >&2; exit 2; }
if [[ "$TARGET" == spinel ]]; then
    command -v spinel >/dev/null || { echo "campfire-suite: --target spinel needs spinel on PATH" >&2; exit 2; }
    command -v spin   >/dev/null || { echo "campfire-suite: --target spinel needs spin on PATH" >&2; exit 2; }
    # The emitted spin.toml names an allocator (jemalloc), and `spin flags`
    # prints `--link -ljemalloc` with no `-L` — the manifest states what the
    # program needs and leaves finding it to the environment (spinel
    # docs/spin.md, "Building outside spin"). On a mac that library lives in
    # a homebrew prefix, which is not a default clang search path, so every
    # test binary failed at `ld: library 'jemalloc' not found` while the
    # linux lanes were fine. Composed here rather than exported by hand:
    # a lane that only builds for whoever knows the trick is not a lane.
    for d in /opt/homebrew/lib /usr/local/lib; do
        [[ -d "$d" ]] && LIBRARY_PATH="${LIBRARY_PATH:+$LIBRARY_PATH:}$d"
    done
    export LIBRARY_PATH
fi

step() { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }

if [[ -n "$REUSE" ]]; then
    [[ -d "$REUSE" ]] || { echo "campfire-suite: no emit at $REUSE" >&2; exit 2; }
    OUT="$REUSE"; KEEP=1
else
    [[ -d "$APP" ]] || { echo "campfire-suite: no app at $APP" >&2; exit 2; }
    [[ -z "$OUT" ]] && OUT="$(mktemp -d -t roundhouse-campfire-suite.XXXXXX)"
fi

cleanup() {
    local code=$?
    if [[ -n "$TMP_TALLY" ]]; then rm -f "$TMP_TALLY"; fi
    if [[ -n "$TMP_FAIL" ]]; then rm -f "$TMP_FAIL"; fi
    if (( KEEP )); then
        echo ""
        echo "emit retained at $OUT"
    else
        rm -rf "$OUT"
    fi
    exit "$code"
}
trap cleanup EXIT INT TERM

if [[ -z "$REUSE" ]]; then
    # `--allow-unsupported` for the same reason the walk uses it: campfire is
    # a ledger app. The point is to run what DOES work and count it.
    step "transpiling $APP → $OUT (target: $TARGET)"
    rm -rf "$OUT"
    (cd "$REPO_ROOT" && cargo run --quiet --bin roundhouse -- \
        --target "$TARGET" "$APP" -o "$OUT" --allow-unsupported) 2>"$OUT.log" | tail -1
    echo "  emit diagnostics: $OUT.log"

    # The suite's own fixtures populate every table, so the database only
    # needs the schema. Each test file resets and reloads it (SchemaSetup).
    step "preparing storage/development.sqlite3 from db/seed.sql"
    mkdir -p "$OUT/storage"
    sqlite3 "$OUT/storage/development.sqlite3" < "$OUT/db/seed.sql"

    if (( STUBS )); then
        cp "$REPO_ROOT/scripts/campfire-walk-stubs.rb" "$OUT/walk_stubs.rb"
        # Into BOOT.rb, not main.rb: `test/test_helper.rb` requires boot.rb
        # (main.rb is boot plus the server, and a test run never loads it).
        # Ahead of `app/models`, the first emitted code to reference an
        # unmodeled base class at LOAD time.
        ruby -e '
          path = ARGV[0]
          src = File.read(path)
          anchor = %(require_relative "app/models")
          abort "campfire-suite: no #{anchor} in boot.rb" unless src.include?(anchor)
          File.write(path, src.sub(anchor, %(require_relative "walk_stubs"\n) + anchor))
        ' "$OUT/boot.rb"
        echo "  spliced walk_stubs.rb ($(grep -c '^# GAP' "$OUT/walk_stubs.rb") ledger entries) into boot.rb"
    fi
fi

# -------- the app's own file list --------

[[ -f "$OUT/Makefile" ]] || { echo "campfire-suite: no Makefile in $OUT" >&2; exit 2; }
mapfile -t TESTS < <(
    ruby -e '
      src = File.read(ARGV[0])
      block = src[/^SPINEL_TESTS :=(.*?)(?=\n\n|\n[A-Z])/m] or abort "no SPINEL_TESTS"
      puts block.scan(%r{test/\S+_test})
    ' "$OUT/Makefile"
)
if [[ -n "$FILTER" ]]; then
    mapfile -t TESTS < <(printf '%s\n' "${TESTS[@]}" | grep -E "$FILTER" || true)
fi

# -------- the spinel lane: one native binary per test file --------

BUILD_LOGS=""
if [[ "$TARGET" == spinel ]]; then
    BUILD_LOGS="$OUT/build-logs"
    mkdir -p "$BUILD_LOGS"

    # `spin flags` resolves the packages and prints the -I / --rbs / --link
    # line the per-test compiles need (spinel docs/spin.md, "Building
    # outside spin"). Resolved ONCE here and passed to every make on the
    # command line, which overrides the emitted Makefile's own
    # `SPIN_TEST_FLAGS = $(shell $(SPIN) flags ...)`.
    #
    # NOT an optimization. CONCURRENT `spin flags` IN ONE TREE COLLIDE:
    # each re-resolves the git dependency through a FIXED staging path
    # (~/.cache/spin/packages/.fetch-bcrypt), so all but one fail with
    #
    #   fatal: destination path '.../.fetch-bcrypt' already exists
    #   spin: fetch failed: git clone https://github.com/rubys/spinel-bcrypt
    #
    # and exit 1 — 7 of 8 in a plain probe. The Makefile's `2>/dev/null`
    # then turns that into an EMPTY flag set, and the compile proceeds with
    # no -I, no --rbs and no bcrypt. That is not a build failure: it
    # SUCCEEDS, and reports type errors from a program missing its
    # dependencies. Thirteen of the first seventeen files of a -j8 sweep
    # built that way before this was caught — exactly the fault f19692bc
    # fixed, reintroduced by parallelism.
    #
    # `tail -1` because a COLD cache prints its `cc bcrypt/...` progress
    # above the flag line, and `$(shell)` would fold those into the
    # arguments too. `--require-gate` is stripped for the reason the
    # Makefile strips it: a test tree requires gems with no spinel surface
    # at all (vips, mocha, webmock), and gating them fails the compile
    # ahead of the type errors this lane exists to count.
    step "resolving package flags"
    SPIN_FLAGS="$( (cd "$OUT" && spin flags 2>/dev/null) | tail -1 | sed 's/--require-gate //' )"
    if [[ -z "$SPIN_FLAGS" ]]; then
        echo "campfire-suite: \`spin flags\` produced nothing in $OUT." >&2
        echo "  Every test would compile without its dependencies and the run would" >&2
        echo "  measure a program that is not the one under test. Refusing." >&2
        exit 2
    fi
    echo "  ${SPIN_FLAGS:0:100}…"

    step "compiling ${#TESTS[@]} test binaries (-j $JOBS)"
    started=$SECONDS
    # ONE FILE PER COMPILE — never batched, see the header — and one log
    # per file, because a row's `why` is its own first compile error and
    # `make -j` interleaves every file's into a single stream.
    printf '%s\n' "${TESTS[@]}" |
        (cd "$OUT" && xargs -P "$JOBS" -I{} sh -c '
            t="$1"; log="$2/$(echo "$t" | tr / _).log"
            if make SPIN_TEST_FLAGS="$3" "build/$t" >"$log" 2>&1; then
                printf "  \033[32mok   \033[0m %s\n" "$t"
            else
                printf "  \033[33mBUILD\033[0m %s\n" "$t"
            fi
        ' _ {} "$BUILD_LOGS" "$SPIN_FLAGS")
    echo "  compiled in $((SECONDS - started))s; logs in $BUILD_LOGS"
fi

step "running ${#TESTS[@]} test files"

cd "$OUT"
pass=0
fail=0
unbuilt=0
tests_total=0
tests_pass=0
table=""
fail_lines=""

# The two lanes differ in exactly one thing: what runs the file. Same
# emitted source, same autorun shim, same output to parse. The timeout is
# `perl -e alarm` because a binary that hangs has no analogue on the ruby
# lane and macOS ships no coreutils `timeout`.
run_test() {
    local t="$1"
    export SECRET_KEY_BASE="${SECRET_KEY_BASE:-campfire-suite-secret}"
    if [[ "$TARGET" == spinel ]]; then
        perl -e 'alarm shift; exec @ARGV' "$TIMEOUT" "./build/$t"
    else
        ruby -Itest "$t.rb"
    fi
}

# The first line of a failed compile, for the BUILD row's `why`.
#
# THREE DIFFERENT SPELLINGS, and only one of them says "error". clang's
# type mismatches do (`error: passing 'sp_PolyArray *' to parameter of
# incompatible type`), and so do spinel's own; but a spinel FRONTEND
# refusal reads `spinel: <file>:<line>: unsupported call: ...` with no
# such token, and matching only on `error` sends every one of those to
# the fallback, where the row's label becomes `make: *** Error 1` — true,
# and useless to triage against. Warnings are excluded explicitly: spinel
# prints several on every compile, before any of them.
#
# The `note:` under a clang error is what names the C parameter, so the
# whole log is kept and this is only the label.
build_error() {
    local log line
    log="$BUILD_LOGS/$(printf '%s' "$1" | tr / _).log"
    [[ -f "$log" ]] || { echo "(no build log)"; return 0; }
    line=$(grep -E "error:|error\[|unsupported |cannot |fatal:" "$log" |
           grep -vE "warning:|^make|^cc |^spinel .*-o build/" | head -1 || true)
    if [[ -z "$line" ]]; then
        line=$(grep -vE "^\s*$|^make" "$log" | tail -1 || true)
    fi
    printf '%s' "$line" | sed "s|$OUT/||g" | cut -c1-160
}
for t in "${TESTS[@]}"; do
    # The emitted autorun shim (emit/ruby.rs::render_autorun_shim) runs
    # EVERY test and prints one `FAIL <Class>#<test>: <msg>` line per
    # failure, so a file's score is tests, not a boolean. The
    # denominator comes from the shim's own `__t.test_*` calls, which
    # exist even when the file dies before running any of them.
    n=$(grep -cE '^  __t\.test_' "$t.rb" || true)
    tests_total=$((tests_total + n))
    # THE THIRD STATUS, and only the spinel lane can produce it: a file
    # that never linked ran nothing, so nothing can be credited and its
    # whole count goes against the compile error.
    if [[ "$TARGET" == spinel && ! -x "build/$t" ]]; then
        why=$(build_error "$t")
        fail=$((fail + 1))
        unbuilt=$((unbuilt + 1))
        printf '\033[1;33m BUILD\033[0m %-56s %d/%d\n         %s\n' "$t" 0 "$n" "$why"
        table+="BUILD|$t|0|$n|$why"$'\n'
        continue
    fi
    if out=$(run_test "$t" 2>&1); then
        pass=$((pass + 1))
        tests_pass=$((tests_pass + n))
        printf '\033[1;32m  ok  \033[0m %-56s %d/%d\n' "$t" "$n" "$n"
        table+="PASS|$t|$n|$n|"$'\n'
    else
        fail=$((fail + 1))
        # The shim's own `<Class>: X of N tests failed` is the
        # authoritative count — it can only be reached once every test
        # has run. Its absence means the file ABORTED (a load error, or
        # a raise from teardown — the two places left outside the
        # per-test guard), and nothing ran that we can credit.
        # `|| true` on every pipeline below: `set -o pipefail` turns
        # `head -1`'s early exit into a SIGPIPE failure for the
        # upstream grep, which `set -e` then treats as fatal — it ends
        # the run mid-suite with a partial tally and no summary.
        nf=$(printf '%s\n' "$out" |
             sed -nE 's/.*: ([0-9]+) of [0-9]+ tests failed.*/\1/p' | head -1 || true)
        if [[ -n "$nf" ]]; then
            ok=$((n - nf))
        else
            ok=0
        fi
        tests_pass=$((tests_pass + ok))
        # The FIRST per-test failure, which is the wall to work on. The
        # trailing `<Class>: X of N tests failed` raise is a summary,
        # not a diagnosis, so it is only the fallback — and for an
        # aborted file it is absent and the load error shows instead.
        # Every per-test failure, for ranking (see --fail-log above).
        # Same `|| true` reason as the pipelines around it.
        if [[ -n "$FAIL_LOG" ]]; then
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                fail_lines+="$t|${line#FAIL }"$'\n'
            done < <(printf '%s\n' "$out" | grep -E '^FAIL ' | cut -c1-200 || true)
        fi
        why=$(printf '%s\n' "$out" | grep -E '^FAIL ' | head -1 | cut -c1-160 || true)
        if [[ -z "$why" ]]; then
            why=$(printf '%s\n' "$out" | grep -vE '^\s|^$' | head -1 |
                  sed "s|$OUT/||" | cut -c1-160 || true)
        fi
        printf '\033[1;31m FAIL \033[0m %-56s %d/%d\n         %s\n' "$t" "$ok" "$n" "$why"
        table+="FAIL|$t|$ok|$n|$why"$'\n'
    fi
done

if [[ -n "$TALLY" ]]; then
    printf '%s' "$table" > "$TALLY"
    echo ""
    echo "tally written to $TALLY"
fi

if [[ -n "$FAIL_LOG" ]]; then
    printf '%s' "$fail_lines" > "$FAIL_LOG"
    echo "per-test failures written to $FAIL_LOG"
fi

if [[ -n "$JSON" ]]; then
    # The SHA, not the checkout: CI unpacks a tarball, which has no .git.
    # $CAMPFIRE_SHA is what pinned it, so it is the authority when set.
    summary_args=(--tally "$TALLY" --fail-log "$FAIL_LOG" --out "$JSON" --target "$TARGET")
    if [[ -f "$OUT.log" ]]; then summary_args+=(--emit-log "$OUT.log"); fi
    if [[ -n "${CAMPFIRE_SHA:-}" ]]; then
        summary_args+=(--campfire-sha "$CAMPFIRE_SHA")
    else
        summary_args+=(--app "$APP")
    fi
    if (( ! STUBS )); then summary_args+=(--no-stubs); fi
    ruby "$REPO_ROOT/scripts/campfire-suite-summary" "${summary_args[@]}"
fi

summary_line="$tests_pass of $tests_total tests pass ($pass of $((pass + fail)) files green)"
if [[ "$TARGET" == spinel ]]; then
    summary_line="$summary_line — $unbuilt of $((pass + fail)) never linked"
fi
step "$summary_line"
