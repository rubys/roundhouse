CSS

html = +"<!doctype html>\n<html lang=en>\n<head>\n<meta charset=utf-8>\n"
html << %(<meta name="viewport" content="width=device-width, initial-scale=1">\n)
html << "<title>Lobsters bench — #{run_dir}</title>\n<style>#{styles}</style>\n</head>\n<body>\n"

html << "<h1>Lobsters benchmark results</h1>\n"
prov = ''
prov << " · #{summary['generated_at']}" if summary['generated_at']
if env && env['roundhouse_commit']
  prov << %( · <code>#{env['roundhouse_commit'][0, 12]}</code>)
  prov << ' <strong>+dirty</strong>' if env['roundhouse_dirty']
end
# The AOT lane is drawn on the headline charts, so the compiler that built it
# belongs in the headline too — not only behind the provenance <details>. An
# AOT bar that moved because spinel moved is otherwise indistinguishable from
# one that moved because the emit did.
sp_ver = (spinel && spinel.dig('aot', 'spinel')) || env&.dig('spinel')
if sp_ver && (sp_hash = sp_ver.split(/\s+/).last)
  prov << %( · spinel <code>#{esc(sp_hash[0, 12])}</code>)
end
html << %(<div class="meta">Run <code>#{run_dir}</code>#{prov}</div>\n)

# ── Trust banner ─────────────────────────────────────────────────────
# The performance numbers on this page are a claim that work was done.
# This banner is what makes that claim falsifiable: it appears whenever
# any lane's output was wrong OR was never checked, and it disappears on
# its own when every lane is verified clean. Its ABSENCE is the signal —
# so "not checked" must raise it just as loudly as "checked and wrong",
# or a run with no oracle would render as a clean bill of health.
#
# Three inputs, all already produced by the run:
#   content parity   — does this lane render what Rails renders?
#   failed_visits    — did the timed sequence itself see non-200s? (a lane
#                      that answers nothing answers very fast)
#   lane state       — did the lane die before producing anything?
trouble = []
(mrows || []).each do |r|
  lane_name = "#{r['label']} #{r['jit']}".strip
  if r['state'] && r['state'] != 'ok'
    trouble << [lane_name, "produced no data — #{r['state']} at #{r['stage']}" +
                      (r['detail'].to_s.empty? ? '' : ": #{r['detail']}")]
    next
  end
  next if r['kind'] == 'rails'   # Rails IS the oracle; it is not compared to itself
  if r['content_total'].nil?
    trouble << [lane_name, 'content was never compared — no Rails lane in this run to compare against']
  elsif r['content_differs'].to_i > 0
    # Declared gaps are known missing capability, not an unexplained
    # difference. They still cost the lane its parity score -- the counts
    # below are untouched -- but listing them here would say the numbers
    # are untrustworthy for a reason we already understand and have
    # written down. Undeclared differences are exactly that alarm.
    undeclared = r['content_undeclared']
    declared   = r['content_gaps'] || []
    if undeclared.nil?
      # matrix.json predates the declared-gap fields. Fall back to the old
      # undifferentiated message: an absent key means "not classified", and
      # treating that as "nothing undeclared" would silently drop the alarm
      # on exactly the runs that have no ledger to justify dropping it.
      diff_names = (r['content_routes'] || []).map { |x| x['route'] }.first(6).join(', ')
      trouble << [lane_name, "renders #{r['content_equivalent']}/#{r['content_total']} routes equivalent to Rails" +
                        (diff_names.empty? ? '' : " — differs on #{diff_names}")]
    elsif undeclared.any?
      trouble << [lane_name, "renders #{r['content_equivalent']}/#{r['content_total']} routes equivalent to Rails" +
                        " — differs on #{undeclared.first(6).join(', ')}" +
                        (declared.empty? ? '' : " (plus #{declared.size} declared gap#{declared.size == 1 ? '' : 's'})")]
    end
  end
  if r['failed_visits'].to_i > 0
    trouble << [lane_name, "#{r['failed_visits']} of the timed sequence's visits did not return 200 — " \
                      'failing visits short-circuit, so this lane\'s ms/iter is faster than real work']
  end
end

# EVERY ratio on this page divides one lane's ms/iter by another's. That is
# only meaningful if the lanes replayed the SAME visits. When a deferral
# reaches some lanes and not others -- a stale checkout on the bench box, a
# lane that ran before a fix landed -- the counts diverge and the ratio
# silently absorbs the difference as speed.
#
# Not hypothetical: a run published 4.26x while Rails replayed 114 visits
# against the emit lanes' 106. The eight extra were the two deferred routes,
# worth 38 ms/iter of Rails work the emit never did -- 8% of Rails' total.
# The honest figure was 3.93x. Nothing on the page said so.
#
# This cannot be repaired at render time (the lanes are already measured),
# so it is reported rather than corrected, and it is deliberately loud.
visit_counts = (mrows || []).select { |r| r['ms_median'] }.filter_map { |r|
  ["#{r['label']} #{r['jit']}".strip, r['visits'].to_i] if r['visits']
}.uniq
if visit_counts.map(&:last).uniq.size > 1
  spread = visit_counts.map { |n, v| "#{n} #{v}" }.join(', ')
  trouble << ['All lanes', "replayed DIFFERENT visit counts (#{spread}) — every ratio on this " \
              'page divides lanes that did not do the same work, so the speed figures are ' \
              'invalid, not merely noisy. A lane most likely ran before a deferral change ' \
              'reached it; re-run with every lane on the same commit.']
end

if trouble.any?
  html << %(<div class="alarm">\n)
  html << "<h2>The performance numbers on this page are not trustworthy</h2>\n"
  html << "<ul>\n"
  trouble.each { |ln, why| html << "<li><strong>#{esc(ln)}</strong> — #{esc(why)}</li>\n" }
  html << "</ul>\n"
  html << %(<p class="why">Timings below are still shown, and are still real measurements of what the code did — but what the code did was not what Rails does, so they do not measure the same work and must not be compared. This banner is generated from the run's own data and disappears by itself once every lane renders what Rails renders on every route IN SCOPE, and every timed visit returns 200. Routes deferred out of scope are listed below with the reason; they are excluded from the timed sequence in every lane, including Rails, so the lanes still measure the same work.</p>\n)
  html << "</div>\n"
end

# The declared-gap ledger. Deliberately NOT inside the red banner and
# deliberately not a substitute for it: these routes are still counted as
# failures everywhere else on the page. This says only which failures are
# understood, so an unimplemented capability stops looking like a defect
# nobody has diagnosed.
if DECLARED_GAPS.any?
  html << %(<div class="gaps">\n)
  html << "<h2>#{DECLARED_GAPS.size} route#{DECLARED_GAPS.size == 1 ? '' : 's'} the AOT lane is known not to render</h2>\n"
  html << "<table>\n<thead><tr><th>route</th><th>why</th><th>closes with</th><th>since</th></tr></thead>\n<tbody>\n"
  DECLARED_GAPS.each do |g|
    html << "<tr><td><code>#{esc(g['route'])}</code></td>"
    html << "<td>#{esc(g['reason'])}</td>"
    html << "<td>#{esc(g['closes_with'])}</td>"
    html << "<td class=\"num\">#{esc(g['since'])}</td></tr>\n"
  end
  html << "</tbody>\n</table>\n"
  html << %(<p class="why">These are counted as failures in every number on this page — the parity badge above still reads them as not rendering what Rails renders. Listing them here separates a capability we have not built from a difference nobody has explained; both are failures, and only one is a surprise.</p>\n)
  html << "</div>\n"
end

# Badges are what gets skimmed and quoted, so they carry the STRONG
# oracle and name their lanes. They used to do neither: two of the three
# counted HTTP 200s — which this page's own methodology calls a weak
# oracle, "a 200 that renders half a page is still a 200" — and the speed
# badge named neither side of its own division. A run whose AOT lane was
# at 21/26 content parity advertised "spinel 25/26 routes" directly under
# a banner saying the numbers were not trustworthy. Status coverage still
# exists; it lives in the coverage section, which is about coverage.
mlanes = (mrows || []).select { |r| r['ms_median'] }
prim_row  = mlanes.find { |r| r['id'] == prim } || mlanes.find { |r| r['kind'] != 'rails' }
rails_row = mlanes.find { |r| r['kind'] == 'rails' && r['yjit'] == prim_row&.dig('yjit') } ||
            mlanes.find { |r| r['kind'] == 'rails' }
html << %(<div class="badges">)
compared = mlanes.select { |r| r['kind'] != 'rails' && r['content_total'] }
if compared.any?
  compared.each do |r|
    ok = r['content_equivalent'].to_i == r['content_total'].to_i
    scope    = r['content_scope'] || r['content_total']
    deferred = r['content_deferred'].to_i
    html << %(<span class="badge #{ok ? 'pass' : 'fail'}">#{esc(r['label'])} #{esc(r['jit'])} )
    html << %(#{r['content_equivalent']}/#{scope} content parity)
    html << %( · #{deferred} deferred) if deferred > 0
    html << %(</span>\n)
  end
else
  # No oracle in this run. The badge has to say that rather than showing a
  # 200-count that reads like a clean bill of health.
  html << %(<span class="badge #{all_pass ? 'pass' : 'fail'}">#{pass}/#{total} return 200 — content never compared</span>\n)
end
html << %(<span class="badge fail">#{thin} thin</span>\n) if thin.to_i > 0
if speedup
  # Name both sides. This is roundhouse's primary emit lane against Rails
  # at the SAME JIT level, which the prose said and the badge did not.
  lhs = prim_row ? "#{prim_row['label']} #{prim_row['jit']}" : 'roundhouse'
  rhs = rails_row ? "Rails #{rails_row['jit']}" : 'Rails'
  html << %(<span class="badge speed">#{fmt_dec(speedup, 2)}× — #{esc(lhs)} vs #{esc(rhs)}</span>\n)
end
# A lane below full parity gets its RESTRICTED ratio here, not its
# headline one: the headline is partly earned by rendering less, and this
# row is exactly where that distinction is most likely to be missed.
mlanes.select { |r| r['vs_rails_parity'] }.each do |r|
  html << %(<span class="badge speed">#{esc(r['label'])} #{esc(r['jit'])} )
  html << %(#{fmt_dec(r['vs_rails_parity'], 2)}× over the #{r['parity_routes']} routes it renders correctly</span>\n)
end
html << "</div>\n"

# Sibling artifacts published alongside this page.
artifact_names = if lanes_mode
  # The emitted trees ride along as tarballs so a compiler author can
  # reproduce a lane's numbers without a roundhouse checkout: the AOT tree
  # is what spinel compiled, and the CRuby tree is the lane it is being
  # compared against. Each carries a REPRODUCE.md with the SHAs and the
  # exact commands. Existence-filtered below, so a run without them is fine.
  %w[matrix.json env.json spinel-tree.tgz ruby-tree.tgz] +
    (matrix['rows'] || []).map { |r| File.join(r['id'], r['kind'] == 'rails' ? 'rails.json' : 'summary.json') }
else
  %w[summary.json summary.md rails.json sequence.json env.json emit.log
     matrix/matrix.json jruby/summary.json jruby/summary.md]
end
artifacts = artifact_names.select { |f| File.exist?(File.join(run_path, f)) }
unless artifacts.empty?
  html << %(<div class="meta">Artifacts: #{artifacts.map { |f| %(<a href="#{f}"><code>#{f}</code></a>) }.join(' · ')}</div>\n)
end

# ── methodology ──────────────────────────────────────────────────────

vpi   = timing&.dig('visits_per_iter') || rails&.dig('visits_per_iter')
db    = summary['db']
memnote = summary['memory'] ? 'an in-memory SQLite seeded at boot' : 'a file-backed SQLite'
html << <<~METHOD
  <div class="methodology">
    <strong>Methodology — ruby-bench's, deliberately.</strong> Every lane times under the ruby-bench harness rule: 15 full-sequence warmup iterations discarded from the stats, then more until at least the minimum timed iterations are recorded AND total wall clock — warmup included, as upstream counts it — reaches the minimum seconds. The reported figure is the <strong>average ms per iteration over the non-warmup iterations</strong>, the statistic ruby-bench itself prints; the median stays in each lane's JSON as a robustness cross-check. #{vpi ? "The stability and comparison numbers replay a <strong>frozen #{vpi}-visit sequence</strong> (versioned at <code>bench/lobsters/frozen-sequence.json</code>) so every run — and the Rails baseline — walks the identical path." : ''} Both stacks serve from #{memnote}#{db ? " (<code>#{esc(db)}</code>)" : ''}, the shape the ruby-bench lobsters benchmark runs. The per-route table further down replays each distinct route once, before warmup, to verify status, bytes and content — it publishes no latency; each lane's pre-warmup single shot stays in its summary JSON as a diagnostic.
    #{matrix ? %(<p>The <strong>runtime × JIT matrix</strong> section re-runs the same frozen sequence once per interpreter × JIT lane — in-process, in-memory, single-threaded — so its rows differ only in the runtime under test.</p>) : ''}
    #{legacy_jruby ? %(<p>The <strong>JRuby lane</strong> replays the JRuby-emitted app in its own run: file-backed (no in-memory backup on the JDBC adapter) and timing the full route set — its numbers trend against earlier JRuby runs, not against the in-memory sections.</p>) : ''}
    <p>Every lane runs <code>ANALYZE</code> once after seeding its in-memory copy (a departure from stock ruby-bench, whose fixture DB carries no <code>sqlite_stat1</code>): without planner statistics SQLite misplans the hottest-stories SELECT under /rss, /hottest, and /recent — a full-table walk plus sort instead of reading <code>hotness_idx</code> to the LIMIT, ~100× the query cost — and both stacks pay that same planner accident. Statistics restore the plan a production database would have; both lanes get identical stats, so the comparison is unchanged in kind and fairer in degree.</p>
    <p class="caveat">This measures one specific reference app (the ruby-bench lobsters fixture), not arbitrary Rails workloads. The Rails baseline runs the <em>real</em> Rails lobsters over the same sequence; the roundhouse cell serves the same routes from the Roundhouse-emitted framework.</p>
  </div>
METHOD

# ── Section: vs Rails (legacy layout only — the lane layout's headline
# lives at the top of the matrix section, since they are one dataset) ──

if rails && timing && !lanes_mode
  html << "<h2>#{section_no}. Roundhouse vs Rails</h2>\n"
  html << %(<p>Milliseconds per iteration of the frozen #{vpi}-visit sequence — <strong>lower is better</strong>. The whisker spans each stack's min–max across its timed iterations.</p>\n)
  html << compare_bars([
    { label: ["rails #{rails['rails']}", jit_label(rails['ruby'])].compact.join(' '), color: COLOR_RAILS,
      median: hl_seq.(rails), min: rails['ms_per_iter_min'],
      max: rails['ms_per_iter_max'], iters: rails['iterations'] },
    { label: ['roundhouse', jit_label(env&.dig('ruby'))].compact.join(' '), color: COLOR_RH,
      median: hl_seq.(timing), min: timing['ms_per_iter_min'],
      max: timing['ms_per_iter_max'], iters: timing['iterations'] },
  ], left_pad: 160)
  if speedup
    html << %(<p><strong>#{fmt_dec(speedup, 2)}× faster than Rails</strong> — )
    html << %(#{fmt_dec(hl_seq.(timing), 1)} ms/iter#{timing['ms_per_iter_mean'] ? ' (avg)' : ''} vs Rails' #{fmt_dec(hl_seq.(rails), 1)} ms/iter.</p>\n)
  end
end

# ── Section: runtime × JIT matrix (from matrix/matrix.json) ──────────

# Lane identity helpers, hoisted above the section that first uses them:
# the memory section further down keys off the same colors and labels, and
# a lane must not change appearance between the two.
#
# Colors keyed by lane id (matches the blog bench vocabulary); the
# kind/yjit fallback covers matrix.json files that predate lane ids.
mcolor = { 'rails' => COLOR_RAILS, 'rails-int' => '#e89c93', 'rails-jruby' => '#46707f',
           'ruby' => COLOR_RH, 'ruby-int' => '#b9a3ea', 'jruby' => COLOR_JR }
lane_color = ->(r) do
  mcolor[r['id']] ||
    (r['kind'] == 'rails' ? (r['yjit'] ? COLOR_RAILS : '#e89c93')
                          : (r['yjit'] ? COLOR_RH    : '#b9a3ea'))
end
lane_jit = ->(r) { r['jit'] || (r['yjit'] ? '+YJIT' : 'no JIT') }

if mrows && !mrows.empty?
  # Rows with no ms_median are lanes that died. They are kept OUT of the
  # chart and the derived insights (there is nothing to plot and nothing
  # to divide) but listed under the table, so the page still says the
  # lane was asked for and what became of it.
  mdead   = mrows.reject { |r| r['ms_median'] }
  mlive   = mrows.select { |r| r['ms_median'] }
  msorted = mlive.sort_by { |r| hl_row.(r) }
  mby_key = mlive.to_h { |r| [[r['kind'], r['yjit']], r] }

  # In the lane layout this section IS the headline — the vs-Rails number
  # is the same-JIT pair of these rows, so it opens the section rather
  # than duplicating as a chart of its own.
  if lanes_mode && speedup
    # Say which rows carry the claims. Five lanes in one table reads as
    # five equal results; they are not. Rails +YJIT is the baseline, the
    # primary emit lane is the like-for-like comparison against it, and
    # AOT is a different runtime for the same emit. The no-JIT pair is
    # there to size the JIT's contribution, not to be quoted.
    html << "<h2>#{section_no}. Roundhouse vs Rails — runtime × JIT</h2>\n"
    aot_row = mlanes.find { |r| r['runtime'] == 'spinel' }
    nojit   = mlanes.count { |r| r['yjit'] == false }
    # "three of them the claim" only when there ARE extra rows to set aside;
    # with exactly the three it is a contradiction.
    html << %(<p class="legend"><strong>#{mlanes.size} lanes#{nojit > 0 ? ', three of them the claim' : ''}.</strong> )
    html << %(<em>#{esc(rails_row ? "Rails #{rails_row['jit']}" : 'Rails +YJIT')}</em> is the baseline; )
    html << %(<em>#{esc(prim_row ? "#{prim_row['label']} #{prim_row['jit']}" : 'roundhouse +YJIT')}</em> is the like-for-like comparison against it — same runtime, same JIT, so the only variable is the code; )
    html << if aot_row
      %(<em>#{esc("#{aot_row['label']} #{aot_row['jit']}")}</em> is the same emit through a different runtime, and is#{aot_row['content_differs'].to_i > 0 ? ' not at full content parity' : ' at full content parity'}. )
    else
      %(the AOT lane did not run. )
    end
    html << %(The #{nojit} no-JIT row#{nojit == 1 ? '' : 's'} size the JIT's contribution and are not the headline.</p>\n) if nojit > 0

    html << %(<p><strong>#{fmt_dec(speedup, 2)}× faster than Rails</strong> — #{fmt_dec(hl_seq.(timing), 1)} ms/iter#{timing['ms_per_iter_mean'] ? ' (avg)' : ''} vs Rails' #{fmt_dec(hl_seq.(rails), 1)}, both stacks CRuby with YJIT. The full field:</p>\n)
    # A drifting lane's ms/iter is a function of how long the run happened
    # to be, so any ratio drawn from it moves with --time. The drift column
    # already reports this; the CLAIM needs it too, because that is where a
    # number gets quoted away from its column.
    drifty = mlanes.select { |r| r['drift_pct'] && r['drift_pct'].abs >= 5 }
    if drifty.any?
      html << %(<p class="caveat"><strong>These ratios depend on run length.</strong> )
      html << drifty.map { |r|
        d = r['drift_pct']
        "#{esc(r['label'])} #{esc(r['jit'])} #{d > 0 ? 'slowed' : 'sped up'} #{fmt_dec(d.abs, 1)}% across its own timed run"
      }.join('; ')
      html << %(, so its ms/iter — and every multiplier drawn from it — would read differently at a different <code>--time</code>. Upward drift on the AOT lane is live-heap growth raising mark cost; downward drift on a JIT lane is warmup that has not finished.</p>\n)
    end
  else
    html << "<h2>#{section_no}. Runtime × JIT matrix</h2>\n"
  end
  html << <<~P
    <p>Every lane replays the same frozen sequence <strong>in-process, in-memory, single-threaded</strong> — no HTTP server, no load generator — so the only variable across rows is the interpreter × JIT under test (the <a href="https://railsatscale.com/2023-08-25-we-turned-lobsters-into-a-rails-benchmark-for-yjit/">ruby-bench lobsters-for-YJIT</a> shape). Lower is better; whiskers span each lane's min–max.</p>
  P
  html << compare_bars(msorted.map { |r|
    { label: "#{r['label']} #{lane_jit.(r)}", color: lane_color.(r),
      median: hl_row.(r), min: r['ms_min'], max: r['ms_max'],
      iters: r['iters'],
      note: (r['vs_rails'] && r['kind'] != 'rails' ? "#{fmt_dec(r['vs_rails'], 2)}× vs Rails" : nil) }
  }, left_pad: 160)

  insights = []
  %w[rails emit].each do |kind|
    on, off = mby_key[[kind, true]], mby_key[[kind, false]]
    next unless on && off && hl_row.(on).to_f > 0
    name = kind == 'rails' ? 'Rails' : 'Roundhouse'
    insights << "<strong>#{name}</strong> gains #{fmt_dec(hl_row.(off) / hl_row.(on), 2)}× from YJIT (#{fmt_dec(hl_row.(off), 1)} → #{fmt_dec(hl_row.(on), 1)} ms/iter)"
  end
  [true, false].each do |yj|
    rl, em = mby_key[['rails', yj]], mby_key[['emit', yj]]
    next unless rl && em && hl_row.(em).to_f > 0
    insights << "<strong>Roundhouse</strong> is #{fmt_dec(hl_row.(rl) / hl_row.(em), 2)}× faster than Rails #{yj ? 'with YJIT' : 'without a JIT'} (#{fmt_dec(hl_row.(rl), 1)} → #{fmt_dec(hl_row.(em), 1)} ms/iter)"
  end
  rj_row = mlive.find { |r| r['id'] == 'rails-jruby' }
  je_row = mlive.find { |r| r['id'] == 'jruby' }
  if rj_row && je_row && hl_row.(je_row).to_f > 0
    insights << "On the JVM, <strong>Roundhouse</strong> is #{fmt_dec(hl_row.(rj_row) / hl_row.(je_row), 2)}× faster than Rails (#{fmt_dec(hl_row.(rj_row), 1)} → #{fmt_dec(hl_row.(je_row), 1)} ms/iter)"
    rl_y = mby_key[['rails', true]]
    if rl_y && hl_row.(rl_y).to_f > 0
      insights << "<strong>Rails itself</strong> runs #{fmt_dec(hl_row.(rj_row) / hl_row.(rl_y), 2)}× slower on JRuby than on CRuby+YJIT (#{fmt_dec(hl_row.(rl_y), 1)} → #{fmt_dec(hl_row.(rj_row), 1)} ms/iter)"
    end
  end
  html << "<ul>\n#{insights.map { |i| "<li>#{i}</li>" }.join("\n")}\n</ul>\n" unless insights.empty?

  # Per-lane iteration series (lane layout): a CV column in the table
  # and collapsible stability strips — the old standalone stability
  # section, folded in so it scales with the lane count.
  lane_iters = {}
  if lanes_mode
    mlive.each do |r|
      data = sibling(File.join(run_path, r['id']), r['kind'] == 'rails' ? 'rails.json' : 'summary.json')
      t = r['kind'] == 'rails' ? data : data && data['sequence_timing']
      im = t && t['iter_ms']
      lane_iters[r['id']] = im if im && im.size > 1
    end
  end
  cv_col = !lane_iters.empty?

  # This table is TIME ONLY. Memory gets its own section further down —
  # a peak-RSS column here sat directly beside "vs Rails" and invited
  # reading that time ratio as a memory one (3.61x and 2.71x on the same
  # row: close enough that the misreading is silent).
  # Drift is a different failure from noise and needs its own column. A
  # noisy lane's median is still its median; a DRIFTING lane's median is a
  # function of how long the run happened to be, so the headline ratio
  # moves with --time for no better reason.
  drift_col = mlive.any? { |r| r['drift_pct'] }
  # A lane below full content parity has a headline ratio that is not
  # measuring the same work as its baseline: a route it renders as a
  # fraction of the page is fast for a reason that is not speed. The
  # restricted column re-runs the ratio over only the routes that lane
  # renders equivalently to Rails, on BOTH sides of the division. Present
  # only when some lane is below parity — at full parity it would just
  # restate the column beside it.
  par_col = mlive.any? { |r| r['vs_rails_parity'] }
  html << "<table>\n<thead><tr><th>stack</th><th>JIT</th><th>#{mlive.any? { |r| r['ms_mean'] } ? 'avg ms/iter' : 'ms/iter'}</th><th>min–max</th>#{cv_col ? '<th>CV</th>' : ''}#{drift_col ? '<th>drift</th>' : ''}<th>iters</th><th>vs Rails</th>#{par_col ? '<th>vs Rails<br>(parity only)</th>' : ''}</tr></thead>\n<tbody>\n"
  msorted.each do |r|
    html << "<tr>"
    html << %(<td><strong>#{esc(r['label'])}</strong></td>)
    html << %(<td>#{lane_jit.(r)}</td>)
    html << %(<td class="num">#{fmt_dec(hl_row.(r), 2)}</td>)
    html << %(<td class="num">#{fmt_dec(r['ms_min'], 1)}–#{fmt_dec(r['ms_max'], 1)}</td>)
    if cv_col
      cv = cv_pct(lane_iters[r['id']])
      html << %(<td class="num">#{cv ? "#{fmt_dec(cv, 1)}%" : '—'}</td>)
    end
    if drift_col
      d = r['drift_pct']
      cls = d && d.abs >= 5 ? 'num no' : 'num'
      html << %(<td class="#{cls}">#{d ? "#{d > 0 ? '+' : ''}#{fmt_dec(d, 1)}%" : '—'}</td>)
    end
    html << %(<td class="num">#{r['iters']}</td>)
    html << %(<td class="num">#{r['vs_rails'] ? "#{fmt_dec(r['vs_rails'], 2)}×" : '—'}</td>)
    if par_col
      if (vp = r['vs_rails_parity'])
        html << %(<td class="num"><strong>#{fmt_dec(vp, 2)}×</strong><br><span class="legend">#{r['parity_routes']} routes</span></td>)
      else
        html << %(<td class="num">—</td>)
      end
    end
    html << "</tr>\n"
  end
  # Lanes that were asked for and produced nothing. Listed in the same
  # table as the ones that worked: a run where a lane died is a different
  # run from one where it was never configured, and the table is where a
  # reader looks to tell them apart.
  mdead.each do |r|
    why = "#{r['state'] || 'failed'}#{r['stage'].to_s.empty? ? '' : " at #{r['stage']}"}"
    why << ": #{r['detail']}" unless r['detail'].to_s.empty?
    span = 4 + (cv_col ? 1 : 0) + (drift_col ? 1 : 0) + (par_col ? 1 : 0)
    html << "<tr>"
    html << %(<td><strong>#{esc(r['label'])}</strong></td>)
    html << %(<td>#{lane_jit.(r)}</td>)
    html << %(<td class="num no" colspan="#{span}"><strong>NO DATA</strong> — #{esc(why)}</td>)
    html << "</tr>\n"
  end
  html << "</tbody></table>\n"
  # Which SQLite build each lane queried, from the lane's own runtime
  # (`select sqlite_version()` through its own linked library). SQLite is
  # "the same C code in every lane" only if the versions say so: the
  # interpreted lanes run the sqlite3 gem's bundled build while the AOT
  # binary links the system one, and /top — the purest query route —
  # profiled at ~94% inside libsqlite3. A version gap there is a library
  # delta wearing a runtime delta's clothes, so a match is attested and a
  # mismatch is named where the ratios are read.
  sqlv = mlive.filter_map { |r| r['sqlite'] }.uniq
  if sqlv.size > 1
    per = mlive.map { |r| "#{r['label']} #{lane_jit.(r)}: #{r['sqlite'] || 'unrecorded'}" }.join(' · ')
    html << %(<p class="caveat"><strong>The lanes did not query the same SQLite build</strong> — #{esc(per)}. On query-heavy routes a cross-lane delta is partly a SQLite-version difference, not a runtime difference: /top runs ~94% inside libsqlite3, and on identical builds its AOT-vs-YJIT gap disappears. Ratios on render-dominated routes are unaffected.</p>\n)
  elsif sqlv.size == 1
    missing = mlive.count { |r| !r['sqlite'] }
    html << %(<p class="legend">Every lane#{missing > 0 ? " that recorded it (#{mlive.size - missing}/#{mlive.size})" : ''} queried SQLite #{esc(sqlv.first)} at runtime.</p>\n)
  end
  # A lane that ran a non-default GC configuration says so HERE, beside the
  # numbers it shaped — a caveat elsewhere doesn't qualify this table. The
  # value is the lane's own runtime parse of SPINEL_GC_MINOR (GCCONFIG line),
  # not the harness's environment, so the label can't drift from the run.
  gc_nondefault = mlive.select { |r| r['gc'] && r['gc'] != 'default' }
  unless gc_nondefault.empty?
    per = gc_nondefault.map { |r|
      tc = r.dig('gc_stat', 'timed', 'cycles')
      "#{r['label']} #{lane_jit.(r)}: SPINEL_GC_MINOR=1#{tc ? " (#{tc} collections in the timed loop)" : ''}"
    }.join(' · ')
    html << %(<p class="caveat"><strong>Non-default GC configuration</strong> — #{esc(per)}. spinel's generational (minor) mark is opt-in; these numbers describe that configuration, not the default collector. Same-binary default-GC numbers appear only when a lane ran them.</p>\n)
  end
  # ── heap sensitivity ───────────────────────────────────────────────
  # The generational collector's claim is not that it makes this workload
  # faster — at lobsters' baseline live heap a whole-heap mark is cheap and
  # the two configurations tie. Its claim is that cost stops scaling with
  # RETAINED heap. That is only visible by pairing a lane against its own
  # zero-ballast twin, same binary, same sequence, one variable; a ratio
  # against Rails would divide unequal work, which is why the aggregator
  # leaves vs_rails nil on these rows.
  ballast_rows = mlive.select { |r| r['ballast'].to_i > 0 }
  unless ballast_rows.empty?
    pairs = ballast_rows.filter_map do |b|
      base = mlive.find { |r| r['runtime'] == b['runtime'] && r['gc'] == b['gc'] && r['ballast'].to_i.zero? }
      next unless base && hl_row.(base)&.positive? && hl_row.(b)
      { gc: b['gc'], n: b['ballast'].to_i, base_ms: hl_row.(base), ms: hl_row.(b),
        pct: 100.0 * (hl_row.(b) - hl_row.(base)) / hl_row.(base) }
    end
    unless pairs.empty?
      n = pairs.map { |p| p[:n] }.uniq
      # Thousands separators, built here rather than inside the interpolation:
      # a regex written inline in a %() literal has its backslashes eaten by
      # the literal before it ever reaches Regexp, and the count silently
      # renders as an empty string.
      n_label = n.size == 1 ? n.first.to_s.gsub(/(\d)(?=(\d{3})+\z)/, '\1,') : 'varying'
      html << %(<h3>Heap sensitivity</h3>\n)
      html << %(<p>Same binary and same sequence, with a retained working set of #{esc(n_label)} objects the request loop never touches. This is the comparison the generational collector is for — at baseline heap the two configurations tie, so a throughput number alone would say nothing.</p>\n)
      html << %(<table class="matrix"><thead><tr><th>GC</th><th class="num">baseline</th><th class="num">+retained</th><th class="num">cost of the retained heap</th></tr></thead><tbody>\n)
      pairs.sort_by { |p| p[:gc].to_s }.each do |p|
        html << %(<tr><td>#{esc(p[:gc] == 'minor' ? 'generational (minor)' : p[:gc])}</td>)
        html << %(<td class="num">#{fmt_dec(p[:base_ms], 2)} ms</td>)
        html << %(<td class="num">#{fmt_dec(p[:ms], 2)} ms</td>)
        html << %(<td class="num"><strong>#{p[:pct] >= 0 ? '+' : ''}#{fmt_dec(p[:pct], 1)}%</strong></td></tr>\n)
      end
      html << %(</tbody></table>\n)
      d = pairs.find { |p| p[:gc] == 'default' }
      m = pairs.find { |p| p[:gc] == 'minor' }
      if d && m && m[:pct].abs > 0.05
        html << %(<p class="legend">The retained heap costs the default collector #{fmt_dec(d[:pct], 1)}% and the generational one #{fmt_dec(m[:pct], 1)}% — #{fmt_dec(d[:pct] / m[:pct], 1)}× less sensitive. Both figures are this binary against itself; neither is a comparison with Rails.</p>\n)
      end
    end
  end
  jr_note = if mlive.any? { |r| r['id'] == 'jruby' }
    mlive.any? { |r| r['id'] == 'rails-jruby' } ?
      ' The JVM rows pair with each other: Roundhouse JRuby\'s ratio is vs Rails on JRuby.' :
      ' The JRuby row compares against Rails +YJIT — Rails\' best CRuby configuration.'
  else
    ''
  end
  if par_col
    below = mlive.select { |r| r['vs_rails_parity'] }
    html << %(<p class="caveat"><strong>Two ratios, because one lane is not rendering what Rails renders.</strong> )
    html << below.map { |r|
      "#{esc(r['label'])} #{esc(r['jit'])} is at #{r['content_equivalent']}/#{r['content_total']} content parity; " \
      "over the #{r['parity_routes']} routes it renders equivalently it is " \
      "<strong>#{fmt_dec(r['vs_rails_parity'], 2)}×</strong> " \
      "(#{fmt_dec(r['parity_ms_median'], 1)} ms/iter vs #{fmt_dec(r['parity_base_ms'], 1)}), " \
      "against #{fmt_dec(r['vs_rails'], 2)}× over the whole sequence"
    }.join('; ')
    html << %(. Both sides of the restricted division cover the same routes. The unrestricted number is not wrong, but part of it is earned by rendering less.</p>\n)
  end
  drifters = mlive.select { |r| r['drift_pct'] && r['drift_pct'].abs >= 5 }
  if drifters.any?
    html << %(<p class="caveat"><strong>Drifting lane#{drifters.size > 1 ? 's' : ''}:</strong> )
    html << drifters.map { |r|
      "#{esc(r['label'])} #{esc(r['jit'])} #{r['drift_pct'] > 0 ? 'slowed' : 'sped up'} " \
      "#{fmt_dec(r['drift_pct'].abs, 1)}% between the first and last quarter of its own timed iterations"
    }.join('; ')
    html << %(. A drifting lane's median depends on how long the run was, so its ratio is not a stable number — read it as a range, not a point. Lanes that hold steady drift under 1%.</p>\n)
  end

  # What YJIT was doing WHILE the clock ran. Non-zero deltas mean the timed
  # window was not steady state, which is the mechanism behind a drifting
  # lane rather than a restatement of it.
  yj = mlive.select { |r| r.dig('yjit_stats', 'delta') }
  if yj.any?
    html << "<details>\n<summary>YJIT during the timed window</summary>\n"
    html << "<table>\n<thead><tr><th>lane</th><th>code region</th><th>iseqs compiled</th>"
    html << "<th>invalidations</th><th>code GCs</th><th>compile time</th></tr></thead>\n<tbody>\n"
    yj.each do |r|
      d = r['yjit_stats']['delta']; a = r['yjit_stats']['after']
      used = [a['inline_code_size'].to_i + a['outlined_code_size'].to_i, 0].max
      html << "<tr><td><strong>#{esc(r['label'])} #{esc(r['jit'])}</strong></td>"
      html << %(<td class="num">#{fmt_int(used / 1024)} KiB / #{fmt_int(a['code_region_size'].to_i / 1024)} KiB</td>)
      %w[compiled_iseq_count invalidation_count code_gc_count].each do |k|
        v = d[k].to_i
        html << %(<td class="num #{v > 0 ? 'no' : ''}">#{v > 0 ? "+#{fmt_int(v)}" : '0'}</td>)
      end
      html << %(<td class="num">+#{fmt_dec(d['compile_time_ns'].to_i / 1_000_000.0, 1)} ms</td>)
      html << "</tr>\n"
    end
    html << "</tbody></table>\n"
    html << %(<p class="legend">Deltas across the timed iterations only — warmup is excluded, so a zero row means YJIT had finished its work before the clock started. Non-zero <code>iseqs compiled</code> means new code was still being generated while being measured; <code>invalidations</code> means compiled code was being thrown away and redone; a non-zero <code>code GCs</code> means the code region filled and YJIT reclaimed it, after which previously-compiled paths must be compiled again.</p>\n)
    html << "</details>\n"
  end

  cv_note = cv_col ? ' CV = per-lane standard deviation ÷ mean across the timed iterations.' : ''
  html << %(<p class="legend">“vs Rails” is a <strong>speed</strong> ratio — Rails' ms/iter ÷ this row's, at the same JIT level — so 3× means three times faster. Memory is a separate section below.#{jr_note}#{cv_note}</p>\n)
  if (rjc = mlive.find { |r| r['id'] == 'rails-jruby' })
    html << %(<p class="caveat"><code>Rails JRuby</code> is the stock-Rails-on-the-JVM baseline: the same app from a patched fixture — Rails #{esc(rjc['rails'] || '8.0.x')} (the AR-JDBC prerelease adapter pins it one minor behind the CRuby lanes), markdown through the same commonmark-java shim the Roundhouse JRuby lane uses, and a JRuby <code>Time.new</code> call-site bug worked around in an initializer.</p>\n)
  end

  strips = msorted.filter_map { |r| (im = lane_iters[r['id']]) ? [r, im] : nil }
  unless strips.empty?
    html << "<details>\n<summary>Per-lane iteration stability (#{strips.size} lanes)</summary>\n"
    strips.each do |r, im|
      html << "<h3>#{esc(r['label'])} #{lane_jit.(r)} — #{fmt_dec(r['ms_median'], 1)} ms/iter median over #{im.size} iterations (#{r['warmup']} warmup)</h3>\n"
      html << iter_columns(im, median: r['ms_median'], min: r['ms_min'], max: r['ms_max'],
                           color: lane_color.(r))
    end
    html << %(<p class="legend">Each column is one timed iteration, scaled within a tight band around the lane's spread; the dashed line is the median.</p>\n)
    html << "</details>\n"
  end

  prov = [matrix['generated_at'], matrix['host'] && "host <code>#{esc(matrix['host'])}</code>"].compact.join(' · ')
  if lanes_mode
    html << %(<p class="caveat">Lanes measured #{prov} — one process per lane, JIT pinned per lane.</p>\n) unless prov.empty?
  else
    # Legacy layout: the headline was a SEPARATE run inheriting ambient
    # RUBYOPT — tie it to its same-JIT matrix row; the cross-JIT gap is
    # real, not jitter.
    head_note = ''
    if speedup && env&.dig('ruby')
      head_yjit = env['ruby'].include?('+YJIT')
      if mby_key[['emit', head_yjit]]
        head_note = %( The headline comparison above ran #{head_yjit ? 'with YJIT' : 'without a JIT'} on both stacks, so it corresponds to the #{head_yjit ? '+YJIT' : 'no-JIT'} rows here; small differences from those rows are run-to-run jitter.)
      end
    end
    html << %(<p class="caveat">Matrix lanes measured #{prov} — one process per lane over the same emit tree.#{head_note}</p>\n) unless prov.empty?
  end
end

# ── Section: per-endpoint breakdown ──────────────────────────────────

rh_pr = timing && timing['per_route']
rl_pr = rails && rails['per_route']
jr_pr = jruby_seq && jruby_seq['per_route']
# The no-JIT lanes' per-endpoint medians (lane layout): table-only columns
# — the chart stays at one series per stack's best configuration. Skipped
# when the primary emit lane IS ruby-int (they'd duplicate the main columns).
rl_int_pr = prim == 'ruby' ? sibling(File.join(run_path, 'rails-int'), 'rails.json')&.dig('per_route') : nil
rh_int_pr = prim == 'ruby' ? sibling(File.join(run_path, 'ruby-int'), 'summary.json')&.dig('sequence_timing', 'per_route') : nil
rl_jvm_pr = lanes_mode ? sibling(File.join(run_path, 'rails-jruby'), 'rails.json')&.dig('per_route') : nil
# The AOT lane, as a CHART series rather than a table-only column: it is a
# different runtime for the same emit, and where it wins and loses is not
# uniform — the whole point of a per-endpoint view.
sp_pr = lanes_mode ? sibling(File.join(run_path, 'spinel'), 'summary.json')&.dig('sequence_timing', 'per_route') : nil
# Route templates whose timed visits are served from an APPLICATION-level
# cache — lobsters' users#tree wraps its whole page body in
# Rails.cache.fetch with a 24h TTL, so every lane's steady-state medians
# for /u measure cache hits, and a reader comparing them to any full
# render is comparing different work. Detection is data-driven, from the
# AOT lane: with no JIT to warm, its pre-warmup single shot (the parity
# pass, kept in the lane summary as a diagnostic) and its sequence median
# agree on every route (measured <= 3.1x, first-touch effects) except
# where an app cache intervenes (measured 43x) — 10x sits in the wide gap
# between those bands. The CRuby lane cannot detect this: its single shot
# also pays YJIT warmup, a 20-50x gap on routes that cache nothing.
cache_served_tmpl = {}
if spinel && sp_pr
  (spinel['routes'] || []).each do |r|
    t = r['template'] || r['route']
    seq = sp_pr.dig(t, 'ms_median')&.to_f
    cache_served_tmpl[t] = true if seq && seq > 0 && r['ms'].to_f / seq > 10
  end
end
cached_mark = lambda do |tmpl|
  next '' unless cache_served_tmpl[tmpl]
  %( <span class="gapmark" title="every lane's timed visits to this route serve from a cache in the app itself (Rails.cache, 24h TTL) — these medians measure cache hits, in every lane; the one cache-miss render is far costlier">cached</span>)
end
if rh_pr && rl_pr && !rh_pr.empty?
  shared = rh_pr.keys.select { |k| rl_pr.key?(k) }
  rh_iters = timing['iterations'].to_i
  breakdown = shared.map do |k|
    rl = rl_pr[k]['ms_median'].to_f
    rh = rh_pr[k]['ms_median'].to_f
    { key: k, rails: rl, rh: rh,
      jr: jr_pr&.dig(k, 'ms_median')&.to_f,
      sp: sp_pr&.dig(k, 'ms_median')&.to_f,
      rails_int: rl_int_pr&.dig(k, 'ms_median')&.to_f,
      rh_int:    rh_int_pr&.dig(k, 'ms_median')&.to_f,
      rails_jvm: rl_jvm_pr&.dig(k, 'ms_median')&.to_f,
      ratio: rh > 0 ? rl / rh : nil,
      # OWN WORK: a low percentile of this route's own visits — the ones
      # where no collection landed inside the timing window. The median
      # includes whatever cleanup fired during the visit no matter whose
      # garbage it reclaimed, and since collection arrival is roughly
      # uniform while its cost is heap-proportional and route-independent,
      # that bias scales as 1/own-cost. On lobsters it inflates the cheapest
      # routes by over 100% and the most expensive by 1%.
      rails_own: rl_pr[k]['ms_p25']&.to_f,
      rh_own:    rh_pr[k]['ms_p25']&.to_f,
      sp_own:    sp_pr&.dig(k, 'ms_p25')&.to_f,
      per_iter: rh_iters > 0 ? (rh_pr[k]['n'].to_f / rh_iters).round : nil }
  end.sort_by { |r| -r[:rails] }

  sp_col  = sp_pr && breakdown.any? { |b| b[:sp] }
  jr_col  = jr_pr && breakdown.any? { |b| b[:jr] }
  rli_col = rl_int_pr && breakdown.any? { |b| b[:rails_int] }
  rhi_col = rh_int_pr && breakdown.any? { |b| b[:rh_int] }
  rjv_col = rl_jvm_pr && breakdown.any? { |b| b[:rails_jvm] }
  drawn = [:rails, :rh]
  drawn << :sp if sp_col
  drawn << :jr if jr_col
  chart_note = if drawn.size > 2
    lanes = drawn.map { |k| PAIRED_SERIES.find { |s| s[0] == k }[2] }
    " The chart draws #{lanes.join(', ')}" \
      "#{rli_col || rhi_col ? '; the no-JIT lanes appear as extra columns in the table below' : ''}."
  else
    ''
  end
  # What AOT compilation buys OVER the transpiled-Ruby lane, as opposed to
  # over Rails. Both vs-Rails ratios include the transpile, so the reader
  # cannot separate the two without dividing them.
  aot_delta_note = begin
    rh_row = (mrows || []).find { |x| x['kind'] == 'emit' && x['runtime'] == 'cruby' && x['yjit'] }
    sp_row = (mrows || []).find { |x| x['runtime'] == 'spinel' }
    if rh_row && sp_row && hl_row.(rh_row).to_f > 0 && hl_row.(sp_row).to_f > 0
      d = hl_row.(rh_row) / hl_row.(sp_row)
      %(<p class="caveat">Both headline ratios include the transpile. Isolating the two: transpiling accounts for the bulk of the win, and AOT compilation adds a further <strong>#{fmt_dec(d, 2)}×</strong> over the same emit running on CRuby+YJIT — in aggregate only, since AOT is faster on the heavy routes and slower on the cheap ones, where per-request fixed costs dominate.</p>)
    else
      ''
    end
  end
  html << "<h2>#{section_no}. Per-endpoint breakdown</h2>\n"
  html << <<~P
    <p>Where the overall #{speedup ? "#{fmt_dec(speedup, 2)}× " : ''}win comes from — each endpoint's median latency over every timed visit of the frozen sequence#{drawn.size > 2 ? ', per lane' : ', Rails vs roundhouse'}. Bars are log-scaled; the <strong>ratio</strong> at the right is Rails ÷ roundhouse#{drawn.size > 2 ? ' (both CRuby +YJIT)' : ''} (green = roundhouse faster).#{chart_note}</p>#{aot_delta_note}
    <p class="caveat">A diagnostic breakdown, not a re-derivation: per-endpoint medians don't sum to the sequence median (GC and ordering don't decompose linearly), and the sub-millisecond rows sit near clock resolution — trust the ranking, not the third decimal.</p>
  P
  # The AOT lane's per-endpoint numbers need the parity caveat attached
  # HERE, not left to a later section: on a route it renders incompletely
  # it is fast at less work, and a bar is exactly the shape that hides
  # that. Named routes rather than a general warning, so the reader knows
  # which bars to discount and which are honest.
  if sp_col && sp_content
    sp_diff = (sp_content['routes'] || [])
                .reject { |r| %w[identical equivalent oracle-failed].include?(r['verdict']) }
                .sort_by { |r| -r['diff_tokens'].to_i }
    unless sp_diff.empty?
      worst = sp_diff.first(4).map { |r| "<code>#{esc(r['route'])}</code>" }.join(', ')
      html << %(<p class="caveat"><strong>Read the AOT bars against #{sp_content['identical'] + sp_content['equivalent']}/#{sp_content['comparable'] || sp_content['total']} content parity, not in isolation.</strong> #{sp_diff.size} of its routes render something other than what Rails renders (worst by differing tokens: #{worst}), and a route that renders less is faster for a reason that is not speed. The lanes drawn beside it are at full parity. Per-route detail in the content-parity section below.</p>\n)
    end
  end
  html << paired_hbar(breakdown, drawn)

  # Show own-work only where it CHANGES the reading. A row whose median is
  # within 10% of its own work is dominated by its own cost and the extra
  # number is clutter; the annotation then appears on exactly the rows a
  # reader should discount, which is the whole point of having it.
  ms_cell = lambda do |med, own|
    return '—' unless med
    if own && med > 0 && (med - own) / med > 0.10
      %(#{fmt_dec(med, 2)}<br><span class="legend">own #{fmt_dec(own, 2)}</span>)
    else
      fmt_dec(med, 2)
    end
  end
  html << "<details>\n<summary>Per-endpoint table (#{breakdown.size} endpoints)</summary>\n"
  html << "<table>\n<thead><tr><th>endpoint</th><th>rails</th>#{rli_col ? '<th>rails no-JIT</th>' : ''}#{rjv_col ? '<th>rails JRuby</th>' : ''}<th>roundhouse</th>#{rhi_col ? '<th>roundhouse no-JIT</th>' : ''}#{sp_col ? '<th>AOT</th>' : ''}#{jr_col ? '<th>jruby</th>' : ''}<th>ratio</th><th>visits/iter</th></tr></thead>\n<tbody>\n"
  breakdown.each do |b|
    rcls = b[:ratio].nil? ? '' : (b[:ratio] >= 1 ? 'ok' : 'no')
    html << "<tr>"
    html << %(<td><code>#{esc(b[:key])}</code>#{cached_mark.(b[:key])}</td>)
    html << %(<td class="num">#{ms_cell.(b[:rails], b[:rails_own])}</td>)
    html << %(<td class="num">#{b[:rails_int] ? fmt_dec(b[:rails_int], 2) : '—'}</td>) if rli_col
    html << %(<td class="num">#{b[:rails_jvm] ? fmt_dec(b[:rails_jvm], 2) : '—'}</td>) if rjv_col
    html << %(<td class="num">#{ms_cell.(b[:rh], b[:rh_own])}</td>)
    html << %(<td class="num">#{b[:rh_int] ? fmt_dec(b[:rh_int], 2) : '—'}</td>) if rhi_col
    html << %(<td class="num">#{b[:sp] ? ms_cell.(b[:sp], b[:sp_own]) : '—'}</td>) if sp_col
    html << %(<td class="num">#{b[:jr] ? fmt_dec(b[:jr], 2) : '—'}</td>) if jr_col
    html << %(<td class="num #{rcls}">#{b[:ratio] ? "#{fmt_dec(b[:ratio], 2)}×" : '—'}</td>)
    html << %(<td class="num">#{b[:per_iter]}</td>)
    html << "</tr>\n"
  end
  html << "</tbody></table>\n"
  if sp_col || jr_col || rli_col || rhi_col || rjv_col
    html << %(<p class="legend">All lane columns are median ms per visit; ratio = rails ÷ roundhouse (the +YJIT pair)#{sp_col ? '. The AOT column is the spinel-compiled binary — same emit, different runtime, and not at full content parity (see above)' : ''}. A route marked <strong>cached</strong> serves its timed visits from a cache in the app itself (lobsters keeps some whole pages for 24h), in every lane — those medians price a cache hit, not the render. An <strong>own</strong> figure appears where a route's median runs more than 10% above its own work (p25 of its visits) — the gap is collection triggered during that visit but caused by the heap the whole sequence built, so it belongs to the lane rather than to the route. It is largest on the cheapest routes, which is where the median is least trustworthy as a per-route cost.</p>\n)
  end
  html << "</details>\n"
end

# ── Section: frozen-sequence stability (legacy layout only — the lane
# layout folds this into the matrix section's CV column + strips) ──────

if timing && timing['iter_ms'] && !lanes_mode
  n = timing['iter_ms'].size
  html << "<h2>#{section_no}. Frozen-sequence stability</h2>\n"
  caption = "#{fmt_dec(timing['ms_per_iter_median'], 1)} ms/iter median over #{n} iterations " \
            "(min #{fmt_dec(timing['ms_per_iter_min'], 1)}, max #{fmt_dec(timing['ms_per_iter_max'], 1)}, " \
            "#{timing['warmup']} warmup). Each column is one timed iteration; the dashed line is the median."
  html << "<p>#{caption}</p>\n"
  if timing['failed_visits'].to_i > 0
    html << %(<p class="caveat">#{timing['failed_visits']} visit(s) failed during timing#{timing['partial'] ? ' — partial run' : ''}.</p>\n)
  end
  html << iter_columns(timing['iter_ms'],
                       median: timing['ms_per_iter_median'],
                       min: timing['ms_per_iter_min'],
                       max: timing['ms_per_iter_max'])
end

# ── Section: memory footprint ────────────────────────────────────────
#
# Its own section rather than a column in the timing table: the ratios
# are different ratios, and side by side they read as one. Sits before
# the parity attestation because it is a result, not an attestation.

mem_rows = (mrows || []).select { |r| r['ms_median'] && (r['rss_peak_kb'] || r['rss_final_kb']) }
unless mem_rows.empty?
  mb   = ->(kb) { kb.to_f / 1024.0 }
  peak = ->(r) { mb.(r['rss_peak_kb'] || r['rss_final_kb']) }
  boot = ->(r) { r['rss_boot_kb'] ? mb.(r['rss_boot_kb']) : nil }
  msort = mem_rows.sort_by { |r| peak.(r) }

  html << "<h2>#{section_no}. Memory footprint</h2>\n"
  html << <<~P
    <p>Peak resident memory of each lane's replay process — <strong>lower is better</strong>. Because the lanes replay <em>in-process</em>, each one measures itself (<code>VmHWM</code> from <code>/proc/self/status</code>), so this is the whole stack: interpreter, framework, the in-memory fixture DB, and whatever the timed run retains on top.</p>
    <p>The bar splits at the point the sequence starts. The solid segment is the <strong>baseline</strong> — everything loaded and seeded, before a single visit. The translucent segment is <strong>growth</strong> across the timed run. The two say different things: baseline is what the stack costs to stand up, growth is what serving retains.</p>
  P
  # Same unearned-advantage problem the timing bars have, and until now
  # the only one of the two with no caveat anywhere on the page: a lane
  # that does not render five routes also does not RETAIN their objects,
  # so part of its footprint advantage is the missing work rather than a
  # leaner stack. Named lanes, so a reader knows which bars to discount.
  mem_unver = msort.select { |r| r['kind'] != 'rails' && r['content_differs'].to_i > 0 }
  if mem_unver.any?
    html << %(<p class="caveat"><strong>)
    html << mem_unver.map { |r|
      "#{esc(r['label'])} #{esc(r['jit'])} is at #{r['content_equivalent']}/#{r['content_total']} content parity"
    }.join('; ')
    html << %(.</strong> Peak memory is measured over the same sequence as the timings, so a lane that renders less also allocates and retains less — read its bar the way you read its ms/iter, not as a like-for-like footprint.</p>\n)
  end
  html << memory_bars(msort.map { |r|
    { label: "#{r['label']} #{lane_jit.(r)}", color: lane_color.(r),
      boot: boot.(r) || peak.(r), peak: peak.(r) }
  })

  # Same-JIT memory pairings, mirroring the timing section's insights.
  # Every ratio here is explicitly named as a memory ratio — the whole
  # reason this is a separate section.
  mem_by = mem_rows.to_h { |r| [[r['kind'], r['yjit']], r] }
  mem_insights = []
  %w[rails emit].each do |kind|
    on, off = mem_by[[kind, true]], mem_by[[kind, false]]
    next unless on && off && peak.(off) > 0
    name  = kind == 'rails' ? 'Rails' : 'Roundhouse'
    delta = peak.(on) - peak.(off)
    next unless delta > 0
    speed = hl_row.(off).to_f > 0 && hl_row.(on).to_f > 0 ? hl_row.(off) / hl_row.(on) : nil
    mem_insights << "<strong>#{name}</strong> pays #{fmt_dec(delta, 0)} MB (+#{fmt_dec(delta / peak.(off) * 100, 0)}%) in peak memory for YJIT" \
                    "#{speed ? ", buying #{fmt_dec(speed, 2)}× the speed" : ''}"
  end
  [true, false].each do |yj|
    rl, em = mem_by[['rails', yj]], mem_by[['emit', yj]]
    next unless rl && em && peak.(em) > 0
    line = "<strong>Roundhouse</strong> peaks #{fmt_dec(peak.(rl) / peak.(em), 2)}× lower than Rails #{yj ? 'with YJIT' : 'without a JIT'} (#{fmt_dec(peak.(rl), 0)} → #{fmt_dec(peak.(em), 0)} MB)"
    if boot.(rl) && boot.(em) && boot.(em) > 0
      line += ", and starts #{fmt_dec(boot.(rl) / boot.(em), 2)}× lower before serving anything (#{fmt_dec(boot.(rl), 0)} → #{fmt_dec(boot.(em), 0)} MB)"
    end
    mem_insights << line
  end
  # Growth is the number a peak-only column would have hidden.
  rl_y, em_y = mem_by[['rails', true]], mem_by[['emit', true]]
  if rl_y && em_y && boot.(rl_y) && boot.(em_y)
    g_rl, g_em = peak.(rl_y) - boot.(rl_y), peak.(em_y) - boot.(em_y)
    if g_em > 0 && g_rl > 0
      mem_insights << "Across the timed run <strong>Rails</strong> retains #{fmt_dec(g_rl / g_em, 1)}× more than Roundhouse (#{fmt_dec(g_rl, 0)} MB of growth against #{fmt_dec(g_em, 0)} MB) — a separate fact from the baseline gap, and the one a peak-only number hides"
    end
  end
  html << "<ul>\n#{mem_insights.map { |i| "<li>#{i}</li>" }.join("\n")}\n</ul>\n" unless mem_insights.empty?

  boot_col = mem_rows.any? { |r| r['rss_boot_kb'] }
  html << "<table>\n<thead><tr><th>stack</th><th>JIT</th>#{boot_col ? '<th>baseline</th>' : ''}<th>peak</th>#{boot_col ? '<th>growth</th>' : ''}<th>vs Rails (memory)</th></tr></thead>\n<tbody>\n"
  msort.each do |r|
    base = mem_by[['rails', r['yjit']]]
    html << "<tr>"
    html << %(<td><strong>#{esc(r['label'])}</strong></td>)
    html << %(<td>#{lane_jit.(r)}</td>)
    html << %(<td class="num">#{boot.(r) ? "#{fmt_int(boot.(r).round)} MB" : '—'}</td>) if boot_col
    html << %(<td class="num">#{fmt_int(peak.(r).round)} MB</td>)
    if boot_col
      html << %(<td class="num">#{boot.(r) ? "+#{fmt_int((peak.(r) - boot.(r)).round)} MB" : '—'}</td>)
    end
    ratio = base && peak.(r) > 0 ? peak.(base) / peak.(r) : nil
    html << %(<td class="num">#{ratio ? "#{fmt_dec(ratio, 2)}×" : '—'}</td>)
    html << "</tr>\n"
  end
  html << "</tbody></table>\n"
  jvm_mem = mem_rows.any? { |r| r['runtime'] == 'jruby' }
  html << %(<p class="legend">“vs Rails (memory)” is peak RSS ÷ peak RSS at the same JIT level — <strong>not</strong> the speed ratio in the matrix table above; the two differ. Baseline is sampled after the in-memory fixture DB is seeded, and it is <em>not</em> a common floor across lanes — each stack loads its own framework, so subtracting one lane's baseline from another's peak is meaningless.#{jvm_mem ? ' JVM lanes run under a fixed heap (<code>-Xmx</code>=<code>-Xms</code>), so their numbers are a configured budget rather than an organically-grown working set.' : ''}</p>\n)
end

# ── Section: route parity ────────────────────────────────────────────

# In the lane layout the jruby lane replayed the same routes — render its
# parity as extra columns so cross-runtime coverage reads off one table.
jr_routes = lanes_mode && jruby ? (jruby['routes'] || []).to_h { |r| [r['route'], r] } : {}
sp_routes = lanes_mode && spinel ? (spinel['routes'] || []).to_h { |r| [r['route'], r] } : {}

if lanes_mode
  # This section is the COVERAGE ATTESTATION, not a performance chart:
  # it certifies that the timing sections above measured a complete
  # application surface, per emit target. (The old single-shot latency
  # chart invited performance readings of noisy one-shot numbers that
  # the medians above answer properly — dropped.)
  jr_all = !jr_routes.empty? && jruby_pass == jruby_total
  sp_all = !sp_routes.empty? && spinel_pass == spinel_total
  # Name the targets actually checked. "Every emit target" is only true of
  # the lanes this section read, so the claim is built from those lanes
  # rather than asserted over all of them.
  checked = ['CRuby']
  checked << 'JRuby' unless jr_routes.empty?
  checked << 'spinel AOT' unless sp_routes.empty?
  # "Coverage", not "parity": these are HTTP 200s. The content-parity
  # section further down uses the same word for document equivalence, and
  # the two numbers differ — a lane can return 200 on every route and
  # render five of them wrong. Two adjacent headings using one word for
  # two oracles put the weaker number first and made it look like the
  # stronger one.
  html << "<h2>#{section_no}. Coverage — HTTP 200 (#{pass}/#{total}#{jr_routes.empty? ? '' : " · jruby #{jruby_pass}/#{jruby_total}"}#{sp_routes.empty? ? '' : " · spinel #{spinel_pass}/#{spinel_total}"})</h2>\n"
  if all_pass && (jr_routes.empty? || jr_all) && (sp_routes.empty? || sp_all)
    html << <<~P
      <p>What the numbers above are numbers <em>of</em>: every distinct route the benchmark exercises returns <strong>200 on #{checked.size == 1 ? 'the %s emit target' % checked[0] : 'every emit target (%s)' % checked.join(', ')}</strong> — the timing sections measure a complete application, not a working subset. A failing cell here would invalidate that lane's rows above.</p>
    P
    html << if content
      ce = content['identical'] + content['equivalent']
      %(<p>Status is a weak oracle, though — a 200 that renders half a page is still a 200 — so the bodies are also compared against Rails' as parsed documents. <strong>#{ce}/#{content['total']} routes render content equivalent to Rails.</strong> See the section below for what "equivalent" is defined to mean and what the remainder are.</p>\n)
    else
      %(<p class="caveat">Content was <em>not</em> compared for this run — no Rails lane ran, so there was no oracle to compare against. These cells attest that each route answered, not that it answered correctly.</p>\n)
    end
  else
    fails = []
    fails << "#{total - pass} route(s) fail on the CRuby lane" unless all_pass
    fails << "#{jruby_total - jruby_pass} route(s) fail on the jruby lane" unless jr_routes.empty? || jr_all
    fails << "#{spinel_total - spinel_pass} route(s) fail on the spinel AOT lane" unless sp_routes.empty? || sp_all
    html << %(<p><strong>Incomplete coverage:</strong> #{fails.join('; ')} — the failing routes' visits short-circuit cheaply, so treat the affected lane's timing rows above as optimistic. Details in the table.</p>\n)
  end
else
  html << "<h2>#{section_no}. Route parity (#{pass}/#{total})</h2>\n"
  html << %(<p>Every distinct benchmark route, replayed once. Bars are log-scaled single-shot latency; #{all_pass ? 'all routes return 200' : 'red bars are non-200 routes'}.</p>\n)
  html << route_hbar(routes, metric: 'ms', unit: 'ms', fmt: ->(v) { "#{fmt_dec(v, 1)} ms" })
end

# The parity table's job is parity — what each route answered and how much
# of it — not latency. The pre-warmup single shot each lane records for
# these rows stays in the lane summary JSON as a diagnostic (and feeds the
# cache detector above), but publishing it beside the ruby-bench-rule
# numbers invited reading it as a per-visit cost, which it is not.
html << "<details open>\n<summary>Per-route table (#{routes.size} routes)</summary>\n"
html << "<table>\n<thead><tr><th>route</th><th>status</th><th>bytes</th>#{jr_routes.empty? ? '' : '<th>jruby</th>'}#{sp_routes.empty? ? '' : '<th>AOT</th><th>AOT bytes</th>'}</tr></thead>\n<tbody>\n"
routes.each do |c|
  status_cls = c['ok'] == false ? 'no' : 'ok'
  html << "<tr>"
  # The ledger keys by TEMPLATE; this table's rows are concrete paths.
  # /hottest matched by string luck, /u/michell_wiegand never matched
  # /u/:username — so the one row whose 500 the ledger exists to explain
  # was the one row it left unlabelled.
  gap_note = GAP_BY_ROUTE[c['template'] || c['route']] ? ' <span class="gapmark" title="declared gap — see the ledger above">declared gap</span>' : ''
  html << %(<td><code>#{esc(c['route'])}</code>#{c['thin'] ? ' <span class="no">(thin)</span>' : ''}#{gap_note}#{cached_mark.(c['template'] || c['route'])}</td>)
  html << %(<td class="num #{status_cls}">#{c['status']}</td>)
  html << %(<td class="num">#{fmt_int(c['bytes'])}</td>)
  unless jr_routes.empty?
    if (j = jr_routes[c['route']])
      jcls = j['ok'] == false ? 'no' : 'ok'
      # Response sizes should track the CRuby lane (bodies are byte-
      # identical mod CSRF token + clock); flag drift beyond noise.
      bytes_note = (j['bytes'].to_i - c['bytes'].to_i).abs > 64 ? %( <span class="no">(#{fmt_int(j['bytes'])} B)</span>\n) : ''
      html << %(<td class="num #{jcls}">#{j['status']}#{bytes_note}</td>)
    else
      html << %(<td class="num">—</td>)
    end
  end
  unless sp_routes.empty?
    if (s = sp_routes[c['route']])
      scls = s['ok'] == false ? 'no' : 'ok'
      # No byte-drift note: the AOT lane serves a FILE-backed DB rather than
      # the in-memory copy the others use, so body sizes are not expected to
      # track the CRuby lane the way JRuby's do.
      html << %(<td class="num #{scls}">#{s['status']}</td>)
      # Bytes, not just status. A route can answer 200 and render a
      # fraction of the page — the AOT lane's /threads is 2.5 KB against
      # the oracle's 58 — and a status-only column is blind to exactly
      # that. Flagged when it falls short of the CRuby lane by more than
      # a tenth, which is far outside the DB-shape noise.
      sbytes = s['bytes'].to_i
      thin = c['bytes'].to_i > 0 && sbytes < c['bytes'].to_i * 0.9
      html << %(<td class="num#{thin ? ' no' : ''}">#{fmt_int(sbytes)}</td>)
    else
      html << %(<td class="num">—</td><td class="num">—</td>)
    end
  end
  html << "</tr>\n"
end
html << "</tbody></table>\n"
if lanes_mode
  drift = jr_routes.empty? ? '' : ' jruby cells flag a response size that drifts more than 64 bytes from the CRuby lane\'s.'
  spn = sp_routes.empty? ? '' : ' An AOT byte count is flagged when it falls more than 10% short of the CRuby lane\'s — a 200 that renders a fraction of the page.'
  cachen = cache_served_tmpl.empty? ? '' : ' A route marked <strong>cached</strong> serves its timed visits from a cache in the app itself (lobsters keeps some whole pages for 24h), in every lane.'
  html << %(<p class="legend">This table verifies parity — what each route answered and how much of it — not speed; the timing sections above are the performance numbers.#{cachen}#{drift}#{spn}</p>\n)
end
# WHY a route failed, not just that it did. The lane summaries carry the
# reason on the route (`BENCHERR NotImplementedError: gem facade:
# Markdowner.to_html is stubbed`), and the page used to drop it — so it
# reported a failure whose cause was one field away, and a reader had to
# open the JSON to learn that all of them are one root.
failing = []
routes.each do |c|
  failing << ['CRuby', c['route'], c['error']] if c['ok'] == false
end
sp_routes.each_value do |s|
  failing << ['AOT', s['route'], s['error']] if s['ok'] == false
end
jr_routes.each_value do |j|
  failing << ['jruby', j['route'], j['error']] if j['ok'] == false
end
failing.reject! { |_, _, e| e.to_s.strip.empty? }
unless failing.empty?
  # Grouped by reason: several failing routes sharing one cause is the
  # useful shape (six /u/:username visits, one stubbed gem), and a list
  # repeating the same sentence hides it.
  html << "<p class=\"caveat\"><strong>Why they fail</strong> — grouped by reason, because a shared cause is one fix:</p>\n"
  html << "<table>\n<thead><tr><th>lane</th><th>route(s)</th><th>reason</th></tr></thead>\n<tbody>\n"
  failing.group_by { |lane, _, err| [lane, err] }.each do |(lane, err), group|
    rs = group.map { |_, route, _| "<code>#{esc(route)}</code>" }.join(', ')
    html << %(<tr><td>#{esc(lane)}</td><td>#{rs}</td><td><code>#{esc(err.to_s.sub(/\ABENCHERR /, ''))}</code></td></tr>\n)
  end
  html << "</tbody></table>\n"
end
html << "</details>\n"

# One non-primary emit lane's content parity, as an <h3> inside the
# content-parity section: count, the routes that differ (token counts +
# first hunk), and the lane's OWN normalization ledger.
#
# The ledger is per-lane on purpose. It differs between lanes — the AOT
# lane masks 31 CSRF tokens where the CRuby lane masks 29, because the
# lanes serve different numbers of forms — and this file's standing rule
# is that a comparison states what it forgave. Reusing the primary lane's
# ledger here would be stating the wrong one.
def content_lane_block(content, lane_label, lane_dir)
  ce  = content['identical'] + content['equivalent']
  all_diff = (content['routes'] || [])
               .reject { |r| %w[identical equivalent oracle-failed].include?(r['verdict']) }
               .sort_by { |r| -r['diff_tokens'].to_i }
  # Deferred routes leave this count for the same reason they leave the
  # badge: they are out of scope, not failing. They are still listed below
  # under their own heading so the section shows what they actually do.
  deferred_here, diff_routes = all_diff.partition { |r| DEFERRED_BODIES.include?(r['route']) }
  cmp = (content['comparable'] || content['total']).to_i - deferred_here.size
  out = +"<h3>#{esc(lane_label)} — #{ce}/#{cmp}</h3>\n"
  out << %(<span class="badge #{diff_routes.empty? ? 'pass' : 'fail'}">#{ce}/#{cmp} routes render what Rails renders</span>\n)
  if diff_routes.empty?
    out << %(<p>Same oracle, same token-stream comparison, same result as the lane above.</p>\n)
    return out
  end
  # Ordered by differing tokens, biggest first — the page's job here is to
  # say where the work is, and token count is the closest thing to a size
  # for "how wrong".
  out << %(<p>Compared against the same Rails oracle, by the same token-stream rules. Ordered by size of difference.</p>\n)
  out << "<table>\n<thead><tr><th>route</th><th>differing tokens</th><th>first difference</th></tr></thead>\n<tbody>\n"
  diff_routes.each do |r|
    h = (r['hunks'] || []).first
    cell =
      if h
        lines = (h['ref'] || []).map { |t| "- #{esc(t)}" } + (h['cand'] || []).map { |t| "+ #{esc(t)}" }
        "<pre>#{lines.first(4).join("\n")}</pre>"
      else
        '—'
      end
    out << %(<tr><td><code>#{esc(r['route'])}</code></td><td class="num no">#{fmt_int(r['diff_tokens'])}</td><td>#{cell}</td></tr>\n)
  end
  out << "</tbody></table>\n"
  out << %(<p class="legend"><code>-</code> is Rails, <code>+</code> is the emit. Full hunks in <code>#{esc(lane_dir)}/content-parity.md</code>.</p>\n)
  ledger = (content['rule_ledger'] || []).reject { |r| r['applications'].to_i.zero? }
  if ledger.any?
    out << "<details>\n<summary>Normalization ledger — #{esc(lane_label)}</summary>\n"
    out << "<table>\n<thead><tr><th>rule</th><th>kind</th><th>applications</th></tr></thead>\n<tbody>\n"
    ledger.each do |r|
      out << %(<tr><td><code>#{esc(r['name'])}</code></td><td>#{esc(r['kind'])}</td><td class="num">#{fmt_int(r['applications'])}</td></tr>\n)
    end
    out << "</tbody></table>\n</details>\n"
  end
  out
end

# ── Section: content parity ──────────────────────────────────────────
# The upgrade from "answered" to "answered correctly". Rails renders the
# oracle; both sides' bodies are parsed and diffed as token streams, so the
# comparison is blind to indentation, attribute order, void-element
# spelling and character-reference spelling — and to nothing else.
#
# The normalization ledger is published rather than summarized away. A
# comparison that quietly forgives things is worth less than no comparison
# at all, so the page states exactly what was forgiven and how often.
if content
  ce = content['identical'] + content['equivalent']
  # Denominator is the routes the ORACLE could render. A route Rails itself
  # failed proves nothing either way, so it is neither credited nor charged
  # — but it is named below, because a shrinking denominator that nobody
  # mentions is how a parity claim quietly stops meaning anything.
  stale = (content['routes'] || []).select { |r| r['verdict'] == 'oracle-failed' }
  # Deferred routes come out of BOTH the differing list and the denominator,
  # the same subtraction content_lane_block makes. Computed inline here, so
  # leaving it out made this heading contradict the badge at the top of the
  # page — the one place a reader is most likely to notice and least likely
  # to be able to explain.
  diff_all = (content['routes'] || []).reject { |r| %w[identical equivalent oracle-failed].include?(r['verdict']) }
  deferred_here, diff_routes = diff_all.partition { |r| DEFERRED_BODIES.include?(r['route']) }
  cmp = (content['comparable'] || content['total']).to_i - deferred_here.size
  # The heading names its LANE. This section scores the primary emit lane,
  # and it used to say a bare "(26/26)" directly under a coverage heading
  # advertising "spinel 25/26" — so a reader could carry the primary lane's
  # parity onto a lane that was at 17/26.
  prim_label = (mrows.find { |r| r['id'] == prim } || {})
                 .then { |r| [r['label'], r['jit']].compact.join(' ') }
  prim_label = prim if prim_label.strip.empty?
  # Every compared lane in the heading, not just the primary one. With the
  # AOT lane at 21/26 the old heading still read "(26/26)", putting the
  # best lane's number where the section's number goes.
  other_parity = (mrows || []).select { |r| r['ms_median'] && r['kind'] != 'rails' &&
                                            r['content_total'] && r['id'] != prim }
                              .map { |r| ", #{esc(r['label'])} #{esc(r['jit'])} #{r['content_equivalent']}/#{r['content_scope'] || r['content_total']}" }
                              .join
  html << "<h2>#{section_no}. Content parity vs Rails — #{esc(prim_label)} #{ce}/#{cmp}#{other_parity}</h2>\n"
  html << %(<span class="badge #{diff_routes.empty? ? 'pass' : 'fail'}">#{ce}/#{cmp} routes render what Rails renders</span>\n)
  if stale.any?
    html << %(<p class="caveat"><strong>#{stale.size} route(s) not compared</strong> — Rails itself did not return 200 for #{stale.map { |r| "<code>#{esc(r['route'])}</code>" }.join(', ')}, so there was no expected output. They are excluded from the count above rather than scored against a broken oracle.</p>\n)
  end
  html << <<~P
    <p>Every parity route is fetched from real Rails and from the emit, and both bodies are parsed into a canonical token stream and diffed there. That makes the comparison blind to four things that are not differences — indentation and formatting whitespace between block elements, attribute order, void-element spelling (<code>&lt;img&gt;</code> vs <code>&lt;img /&gt;</code>), and character-reference spelling (<code>&amp;#39;</code> vs <code>&amp;apos;</code>) — and blind to nothing else.</p>
  P
  # Why not just compare response sizes: find the route with the widest byte
  # gap among those the parse proved EQUIVALENT, and let it make the case.
  # Derived, not asserted, so it stays true as the emit changes — which it
  # has. This used to read "all of the difference is whitespace", true when
  # the ERB compiler kept the indentation and newline that erubi's trim mode
  # drops from every `<% %>` line (`/u` was 292,443 bytes against Rails'
  # 173,576, a 68% gap). That is fixed, so the residual gap is no longer
  # attributable to any one cause and the copy no longer names one; the
  # 5% floor means this paragraph simply disappears once the emit converges.
  widest = (content['routes'] || [])
             .select { |r| %w[identical equivalent].include?(r['verdict']) && r['ref_bytes'].to_i > 0 }
             .max_by { |r| (r['cand_bytes'].to_i - r['ref_bytes'].to_i).abs / r['ref_bytes'].to_f }
  if widest && (gap = ((widest['cand_bytes'] - widest['ref_bytes']).abs * 100.0 / widest['ref_bytes']).round) >= 5
    html << %(<p>Comparing response <em>sizes</em> instead would be weaker than it looks. <code>/#{esc(widest['route'])}</code> is #{fmt_int(widest['ref_bytes'])} bytes from Rails and #{fmt_int(widest['cand_bytes'])} from the emit — a #{gap}% gap — and the two are the same document, differing only in the formatting the token stream is deliberately blind to.</p>\n)
  end
  if diff_routes.any?
    html << "<table>\n<thead><tr><th>route</th><th>differing tokens</th><th>first difference</th></tr></thead>\n<tbody>\n"
    diff_routes.each do |r|
      h = (r['hunks'] || []).first
      cell =
        if h
          lines = (h['ref'] || []).map { |t| "- #{esc(t)}" } + (h['cand'] || []).map { |t| "+ #{esc(t)}" }
          "<pre>#{lines.first(4).join("\n")}</pre>"
        else
          '—'
        end
      html << %(<tr><td><code>#{esc(r['route'])}</code></td><td class="num no">#{fmt_int(r['diff_tokens'])}</td><td>#{cell}</td></tr>\n)
    end
    html << "</tbody></table>\n"
    html << %(<p class="legend">Each route's first differing hunk; <code>-</code> is Rails, <code>+</code> is the emit. Full hunks in <code>#{esc(prim)}/content-parity.md</code>.</p>\n)
  end
  ledger = (content['rule_ledger'] || []).reject { |r| r['applications'].to_i.zero? }
  if ledger.any?
    html << "<details>\n<summary>Normalization ledger (what the comparison forgives, and how often)</summary>\n"
    html << "<table>\n<thead><tr><th>rule</th><th>kind</th><th>applications</th><th>why</th></tr></thead>\n<tbody>\n"
    ledger.each do |r|
      html << %(<tr><td><code>#{esc(r['name'])}</code></td><td>#{esc(r['kind'])}</td>)
      html << %(<td class="num">#{fmt_int(r['applications'])}</td><td>#{esc(r['why'])}</td></tr>\n)
    end
    html << "</tbody></table>\n"
    html << %(<p class="legend"><strong>mask</strong> — varies per run or per session by construction and carries no information. <strong>known</strong> — a genuine, understood difference from Rails, folded so it does not drown the signal but counted here so it cannot be forgotten.</p>\n)
    html << "</details>\n"
  end
  # Every OTHER emit lane's parity, each with the same detail the primary
  # lane gets: the count, the differing routes with their token counts and
  # first hunk, and its own normalization ledger. A one-line "jruby lane:
  # N/M" was all this used to be, and the AOT lane didn't even get that —
  # its 9 differing routes lived only in a published file nothing read.
  [[sp_content, 'Roundhouse AOT', 'spinel'],
   [jr_content, 'Roundhouse JRuby', 'jruby']].each do |lane_content, lane_label, lane_dir|
    next unless lane_content
    html << content_lane_block(lane_content, lane_label, lane_dir)
  end
end

# ── Section: JRuby lane (legacy layout only — in the lane layout the ──
# jruby lane lives in the matrix / per-endpoint / parity sections) ─────

if legacy_jruby
  jt = jruby['sequence_timing'] || jruby['timing']
  html << "<h2>#{section_no}. JRuby lane (#{jruby_pass}/#{jruby_total})</h2>\n"
  metric = if jruby['sequence_timing']
    "the frozen #{jt['visits_per_iter']}-visit sequence"
  elsif jt
    "the full route set (#{jt['routes_per_iter']} routes per iteration)"
  else
    'route parity only'
  end
  html << <<~P
    <p>The same lobsters app emitted with <code>--target jruby</code> and replayed in-process under JRuby, in its own run. This lane is <strong>file-backed</strong> — the JDBC SQLite adapter has no in-memory backup — and times #{metric}, so its numbers trend against earlier JRuby runs rather than comparing with the in-memory sections above.</p>
  P
  facts = [['route parity', "#{jruby_pass}/#{jruby_total} routes return 200"]]
  if jt
    facts += [
      ['ms/iter (median)', "#{fmt_dec(jt['ms_per_iter_median'], 1)} ms"],
      ['min–max',          "#{fmt_dec(jt['ms_per_iter_min'], 1)}–#{fmt_dec(jt['ms_per_iter_max'], 1)} ms"],
      ['iterations',       jt['iterations']],
      ['warmup',           jt['warmup'] && "#{jt['warmup']} discarded iterations (JRuby's JIT warms slowly on this metric)"],
    ]
    facts << ['partial', 'yes — failing routes short-circuit cheaply; not comparable to a full-parity run'] if jt['partial']
  end
  facts << ['runtime', jruby_env&.dig('ruby') && "<code>#{esc(jruby_env['ruby'])}</code>"]
  facts << ['java opts', jruby_env&.dig('java_opts') && "<code>#{esc(jruby_env['java_opts'])}</code>"]
  facts << ['measured', jruby['generated_at']]
  html << kv_table(facts)
  jbad = (jruby['routes'] || []).reject { |r| r['ok'] }
  unless jbad.empty?
    html << %(<p class="caveat">Non-200 routes: #{jbad.map { |r| "<code>#{esc(r['route'])}</code> (#{r['status']})" }.join(', ')}.</p>\n)
  end
end

# ── environment appendix ─────────────────────────────────────────────
# Numbered like every other section. As an unheaded <details> its inner
# <h3>Run/Stacks/Sequence followed the content-parity section directly, so
# the page read as though provenance were part of the parity discussion.

html << "<h2>#{section_no}. Environment &amp; provenance</h2>\n"
html << %(<details id="environment">\n<summary>Run, stacks, sequence</summary>\n)
# A commit is the truth only when the tree that produced it was clean, so an
# uncommitted-changes flag is shown beside the hash rather than left in the
# JSON for someone to notice.
def commit_cell(hash, dirty)
  return nil unless hash
  cell = +"<code>#{hash}</code>"
  cell << ' <strong>+ uncommitted changes</strong>' if dirty
  cell
end

html << "<h3>Run</h3>\n"
html << kv_table([
  ['command',    env&.dig('command') && "<code>#{esc(env['command'])}</code>"],
  ['source',     env&.dig('src') && "<code>#{esc(env['src'])}</code>"],
  ['commit',     commit_cell(env&.dig('roundhouse_commit'), env&.dig('roundhouse_dirty'))],
  ['fixture commit', commit_cell(env&.dig('lobsters_commit'), env&.dig('lobsters_dirty'))],
  ['captured',   env&.dig('generated_at') || summary['generated_at']],
  ['database',   db && "<code>#{esc(db)}</code>"],
  ['seed',       summary['seed']],
  ['story / comment', [summary['story_id'], summary['comment_id']].compact.join(' / ')],
])
html << "<h3>Stacks</h3>\n"
html << kv_table([
  ['roundhouse ruby', env&.dig('ruby') && "<code>#{esc(env['ruby'])}</code>"],
  ['rails ruby',      rails&.dig('ruby') && "<code>#{esc(rails['ruby'])}</code>"],
  ['rails',           rails&.dig('rails')],
])

# The AOT lane's toolchain and build facts. Both were already recorded and
# neither was ever rendered, so the page reported spinel-compiled timings
# without naming the compiler, and swallowed the C warning count entirely.
# Prefer the spinel lane's own reading — it is captured next to that lane's
# build, so it names the compiler that produced the binary being timed —
# and fall back to the run-level probe.
aot = (spinel && spinel['aot']) || {}
aot_rows = [
  ['spinel (AOT)', (aot['spinel'] || env&.dig('spinel')) &&
                   "<code>#{esc(aot['spinel'] || env['spinel'])}</code>"],
  ['C compiler',   (aot['cc'] || env&.dig('cc')) &&
                   "<code>#{esc(aot['cc'] || env['cc'])}</code>"],
  ['AOT compile',  aot['build_seconds'] && "#{aot['build_seconds']} s"],
  ['binary',       aot['binary_bytes'] &&
                   "#{(aot['binary_bytes'] / 1024.0 / 1024.0).round(1)} MiB"],
  # Surfaced, not hidden: a C warning in generated code is a signal about the
  # emitter or the compiler, and a count that only ever sat in JSON was a
  # signal nobody read. Kept apart from spinel's own analysis warnings, which
  # are modeling debt and run one per model — folding the two together buries
  # the handful that describe the generated C.
  ['C warnings',      aot['c_warnings']],
  ['spinel warnings', aot['spinel_warnings']],
]
if aot_rows.any? { |_, v| !v.nil? && !v.to_s.empty? }
  html << "<h3>AOT toolchain</h3>\n"
  html << kv_table(aot_rows)
end

host_rows = [
  ['host',   env&.dig('host') && "<code>#{esc(env['host'])}</code>"],
  ['cpu',    env&.dig('cpu') && esc(env['cpu'])],
  ['cores',  env&.dig('cpu_cores')],
  ['kernel', env&.dig('kernel') && "<code>#{esc(env['kernel'])}</code>"],
]
if host_rows.any? { |_, v| !v.nil? && !v.to_s.empty? }
  html << "<h3>Host</h3>\n"
  html << kv_table(host_rows)
end
if timing || rails
  html << "<h3>Sequence</h3>\n"
  html << kv_table([
    ['visits/iter',       vpi],
    ['warmup',            timing&.dig('warmup') || rails&.dig('warmup')],
    ['roundhouse iters',  timing&.dig('iterations')],
    ['rails iters',       rails&.dig('iterations')],
  ])
end
html << "</details>\n"

html << %(<hr><p class="meta">Generated #{Time.now.utc.iso8601} from <code>#{File.basename(input)}</code>.</p>\n)
html << "</body>\n</html>\n"

File.write(out, html)
$stderr.puts "wrote #{out} (#{html.bytesize} bytes)"
