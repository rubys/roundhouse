#!/usr/bin/env bash
# scripts/smoke — run an archive's own README against the unpacked tgz.
#
# The consolidation thesis (see the smoke pilot in ci.yml): the published
# `<target>.tgz` is the complete test artifact. It ships the transpiled
# app, its model/controller test suite, the Playwright e2e suite (e2e/),
# and a README whose fenced ```sh blocks are the exact build/test/e2e
# steps. This script extracts the archive and executes those blocks in
# order — no per-target knowledge lives here, unlike scripts/e2e's
# build/seed/boot case tables. If the README is wrong, the smoke job is
# red: the docs are the contract.
#
# Sections executed: every `## <name>` section's ```sh blocks EXCEPT
#   ## Run         — boots a foreground server (for humans)
#   ## Regenerate  — needs the roundhouse binary (for humans)
#
# The ## Test section additionally has to prove it EXECUTED something —
# see "executed-count floor" below. Exit status alone is not evidence:
# every runner here exits 0 when it runs nothing.
#
# Usage:  scripts/smoke [options] TARGET
#
# Options:
#   --site-dir DIR   Use a prebuilt site dir; archive at DIR/browse/<target>.tgz.
#                    Default: build the site into a temp dir via build-site.
#   --tgz PATH       Use a specific archive tarball (overrides --site-dir).
#   --keep           Don't delete the work dir on exit (debug).
#
# Environment overrides:
#   SMOKE_MIN_TESTS  Override the § Test executed-count floor for this run.
#
# Environment: the target's toolchain plus whatever the README's steps
# need (e.g. Node + `npx playwright install chromium` for ## End-to-end).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

TARGET=""
SITE_DIR=""
TGZ=""
KEEP=0
EXPLAIN=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --site-dir)     SITE_DIR="$2"; shift 2 ;;
        --tgz)          TGZ="$2";      shift 2 ;;
        --keep)         KEEP=1;        shift ;;
        --explain-count) EXPLAIN="$2"; shift 2 ;;
        -h|--help)  sed -n '2,/^$/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        -*)         echo "unknown flag: $1" >&2; exit 2 ;;
        *)
            if [[ -z "$TARGET" ]]; then TARGET="$1"
            else echo "unexpected positional arg: $1" >&2; exit 2; fi
            shift ;;
    esac
done

step() { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32mok\033[0m  %s\n' "$*"; }
fail() { printf '\033[1;31mFAIL\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mWARN\033[0m %s\n' "$*"; }

# -------- executed-count floor: the recognizers --------
#
# Why any of this exists: this script checks each README block's EXIT
# STATUS, and every test runner it drives exits 0 when it runs nothing.
# `dotnet test` on an archive with no test project passed § Test in 1.1
# seconds having executed zero assertions, green, for months. The retired
# toolchain harnesses (tests/{kotlin,swift}_toolchain.rs) carried `>= 21`
# floors for exactly this; the smoke consolidation dropped them. See #34.
#
# Two layers, both keyed to the RUNNER's output shape rather than to the
# target — that keeps per-target build/seed/boot procedure out of this
# script, which is the point of the consolidation:
#
#   count_from_log        the summary line the runner prints
#   count_from_artifacts  JUnit-shaped XML, for runners that print none
#
# What a target is expected to REPORT is per-target, and is recorded in
# the MIN_TESTS table further down. That's an expectation, not a
# procedure.
#
# To check a recognizer against real output without running a whole
# smoke: scripts/smoke --explain-count <captured-test-output.log>

# Prints one integer, or nothing when no shape matched. Families are
# collapsed with max() rather than summed, so a runner that prints both
# per-suite and total lines (XCTest) is not double-counted; within a
# family that emits one line per binary (cargo, the emitted minitest
# autorun) the lines are summed.
count_from_log() {
    awk '
        function num(s) { gsub(/[^0-9]/, "", s); seen = 1; return s + 0 }
        # cargo: one summary line per test binary
        match($0, /ok\. [0-9]+ passed/)      { cargo += num(substr($0, RSTART, RLENGTH)); next }
        # the emitted minitest autorun (ruby, jruby): one line per class
        match($0, /: [0-9]+ tests passed/)   { mini  += num(substr($0, RSTART, RLENGTH)); next }
        # `spin test`: "N/M passed", one native binary per emitted test FILE
        /^[0-9]+\/[0-9]+ passed/             { match($0, /^[0-9]+/)
                                               spin = num(substr($0, RSTART, RLENGTH)); next }
        # crystal spec
        match($0, /^[0-9]+ examples?/)       { cr     = num(substr($0, RSTART, RLENGTH)); next }
        # mix test / ExUnit
        match($0, /^[0-9]+ tests?,/)         { ex     = num(substr($0, RSTART, RLENGTH)); next }
        # node:test TAP epilogue
        match($0, /^# pass [0-9]+/)          { node   = num(substr($0, RSTART, RLENGTH)); next }
        # XCTest: per-suite lines AND a total line, so take the max
        match($0, /Executed [0-9]+ test/)    { n = num(substr($0, RSTART, RLENGTH))
                                               if (n > xc) xc = n; next }
        # pytest: the ==== summary bar
        /^=+.*=+$/ && match($0, /[0-9]+ passed/) { py = num(substr($0, RSTART, RLENGTH)); next }
        # dotnet test, both the classic and the v10 summary shapes
        match($0, /Passed:[ ]*[0-9]+/)       { net    = num(substr($0, RSTART, RLENGTH)); next }
        /[Tt]est summary/ && match($0, /total:[ ]*[0-9]+/) { net = num(substr($0, RSTART, RLENGTH)); next }
        END {
            n = 0
            if (cargo > n) n = cargo; if (mini > n) n = mini; if (spin > n) n = spin
            if (cr    > n) n = cr;    if (ex   > n) n = ex;   if (node > n) n = node
            if (xc    > n) n = xc;    if (py   > n) n = py;   if (net  > n) n = net
            # `seen` distinguishes "a runner reported zero" (a real, and
            # much more interesting, answer) from "nothing here looked
            # like a test summary at all".
            if (seen) print n
        }
    ' "$1"
}

# Runners that print no summary (gradle) still write JUnit-shaped XML.
# Sum the `tests="N"` attribute of every <testsuite> under the archive.
count_from_artifacts() {
    local total=0 n
    while IFS= read -r x; do
        n="$(grep -o '<testsuite [^>]*tests="[0-9]*"' "$x" 2>/dev/null \
             | grep -o '[0-9][0-9]*' | tail -1)"
        [[ -n "$n" ]] && total=$(( total + n ))
    done < <(find "$1" \( -path '*test-result*' -o -path '*surefire-report*' \) \
                       -name '*.xml' 2>/dev/null)
    (( total > 0 )) && echo "$total"
    return 0
}

if [[ -n "$EXPLAIN" ]]; then
    if [[ -d "$EXPLAIN" ]]; then
        echo "count_from_artifacts: $(count_from_artifacts "$EXPLAIN" || true)"
    else
        echo "count_from_log: $(count_from_log "$EXPLAIN" || true)"
    fi
    exit 0
fi

[[ -z "$TARGET" ]] && { echo "usage: scripts/smoke [options] TARGET" >&2; exit 2; }

WORK="$(mktemp -d -t roundhouse-smoke.XXXXXX)"
cleanup() {
    local code=$?
    if (( KEEP )); then
        echo "--keep: work dir retained at $WORK"
    else
        rm -rf "$WORK"
    fi
    exit "$code"
}
trap cleanup EXIT INT TERM

# -------- 1. resolve + extract archive --------

if [[ -z "$TGZ" ]]; then
    if [[ -z "$SITE_DIR" ]]; then
        step "building site (build-site) → $WORK/site"
        (cd "$REPO_ROOT" && cargo run --release --quiet --bin build-site -- \
            fixtures/real-blog "$WORK/site" >/dev/null)
        SITE_DIR="$WORK/site"
    fi
    TGZ="$SITE_DIR/browse/$TARGET.tgz"
fi
[[ -f "$TGZ" ]] || { fail "archive not found: $TGZ"; exit 1; }

step "extracting $(basename "$TGZ") → $WORK"
tar xzf "$TGZ" -C "$WORK"
APP_DIR="$WORK/$TARGET"
[[ -d "$APP_DIR" ]] || APP_DIR="$WORK"
[[ -f "$APP_DIR/README.md" ]] || { fail "README.md missing from archive"; exit 1; }
ok "extracted ($APP_DIR)"

# -------- 2. extract the README's runnable blocks --------

# One file per ```sh block, named NN--<section>.sh, in document order.
# awk tracks the current `## ` heading; blocks under Run / Regenerate
# are skipped (foreground server / needs the transpiler).
BLOCKS="$WORK/.smoke-blocks"
mkdir -p "$BLOCKS"
awk -v dir="$BLOCKS" '
    /^## /    { section = substr($0, 4) }
    /^```sh$/ {
        if (section != "Run" && section != "Regenerate") {
            slug = section
            gsub(/[^A-Za-z0-9]+/, "-", slug)
            n++
            file = sprintf("%s/%02d--%s.sh", dir, n, slug)
            collecting = 1
        }
        next
    }
    /^```$/   { collecting = 0; next }
    collecting { print > file }
' "$APP_DIR/README.md"

shopt -s nullglob
block_files=("$BLOCKS"/*.sh)
(( ${#block_files[@]} )) || { fail 'no runnable sh blocks found in README.md'; exit 1; }

# -------- 3. executed-count floor for § Test --------
#
# The recognizers live at the top of this file (see "executed-count
# floor"); what remains here is the per-target EXPECTATION.

# The default floor is the real-blog app suite: ArticleTest 4 +
# CommentTest 5 + ArticlesControllerTest 9 + CommentsControllerTest 3 =
# 21. Targets that also run emitted extras (rust's runtime unit tests,
# ruby/jruby's QueryCountTest) clear it with room to spare. This is a
# ratchet against LOSS, not an exact count — raise it when a target's
# floor is genuinely higher, never lower it to make a red job green.
MIN_TESTS=21
case "$TARGET" in
    spinel)
        # `spin test` compiles each emitted test FILE to a native binary
        # and reports "N/M passed" over binaries, not test methods. The
        # unit differs, so the floor does too. (It counts test_helper.rb
        # among them, which is a `spin test` quirk, not coverage.)
        MIN_TESTS=6 ;;
    go)
        # `go test ./...` reports "ok <pkg>" / "? <pkg> [no test files]"
        # with no count at any verbosity we drive. `ran` asserts at least
        # one package actually ran tests — which is precisely the zero
        # case this floor exists to catch. Upgrade to a number if the
        # README's command ever grows a counting flag.
        MIN_TESTS=ran ;;
    csharp)
        # KNOWN GAP (#34): csharp emits no test project, so `dotnet test`
        # executes zero tests. Declared, warned about on every run, and
        # NOT silent. Set to 21 the moment csharp test emit lands.
        MIN_TESTS=0 ;;
esac
if [[ -n "${SMOKE_MIN_TESTS:-}" ]]; then
    MIN_TESTS="$SMOKE_MIN_TESTS"
fi
if [[ "$MIN_TESTS" != "ran" && ! "$MIN_TESTS" =~ ^[0-9]+$ ]]; then
    fail "SMOKE_MIN_TESTS must be a non-negative integer or 'ran' (got: $MIN_TESTS)"
    exit 2
fi

assert_tests_executed() {
    local log="$1" n a
    n="$(count_from_log "$log")"
    # No summary line, or one reporting zero: the runner may still have
    # written JUnit XML (gradle prints no count at all).
    if [[ -z "$n" || "$n" == 0 ]]; then
        a="$(count_from_artifacts "$APP_DIR")"
        [[ -n "$a" ]] && n="$a"
    fi

    if [[ "$MIN_TESTS" == "ran" ]]; then
        if grep -Eq '^ok[[:space:]]' "$log"; then
            ok "§ Test executed tests (runner reports no count)"
            return 0
        fi
        fail "§ Test executed NOTHING: no package reported tests (see #34 §0)"
        return 1
    fi

    if (( MIN_TESTS == 0 )); then
        warn "§ Test executed ${n:-0} tests — KNOWN GAP for $TARGET (#34 §0)."
        warn "     This gate asserts nothing today. Raise the floor to 21 as"
        warn "     soon as $TARGET emits a test suite."
        return 0
    fi

    if [[ -z "$n" ]]; then
        fail "§ Test produced no recognizable test count, and no JUnit XML."
        echo "     Expected at least $MIN_TESTS executed. Either the suite" >&2
        echo "     ran nothing, or the runner's summary shape is new and" >&2
        echo "     count_from_log needs to learn it. See #34 §0." >&2
        return 1
    fi

    if (( n < MIN_TESTS )); then
        fail "§ Test executed $n tests, below the floor of $MIN_TESTS (#34 §0)"
        return 1
    fi

    ok "§ Test executed $n tests (floor $MIN_TESTS)"
}

# -------- 4. run the blocks, in order, from the archive root --------

LOGS="$WORK/.smoke-logs"
mkdir -p "$LOGS"
saw_test_section=0

for f in "${block_files[@]}"; do
    name="$(basename "$f" .sh)"
    section="${name#*--}"
    step "README § ${section//-/ }"
    sed 's/^/    $ /' "$f"
    if ! (cd "$APP_DIR" && bash -euo pipefail "$f") 2>&1 | tee "$LOGS/$name.log"; then
        fail "README § ${section//-/ } failed"
        exit 1
    fi
    ok "README § ${section//-/ }"
    case "$section" in
        Test|Tests)
            saw_test_section=1
            assert_tests_executed "$LOGS/$name.log" || exit 1 ;;
    esac
done

if (( ! saw_test_section )) && [[ "$MIN_TESTS" != "0" ]]; then
    fail "README has no § Test section — nothing asserted the app behaves"
    exit 1
fi

step "smoke: $TARGET archive passes its own README"
