#!/usr/bin/env bash
# scripts/bench-campfire-roundsnap — Campfire YJIT matrix:
#
#   rails-1p              stock once-campfire, YJIT on
#   rails-1p-noyjit       stock once-campfire, YJIT off
#   ruby-1p               Roundhouse classic .rb emit, YJIT on
#   ruby-1p-noyjit        Roundhouse classic .rb emit, YJIT off
#   roundsnap-1p          Roundhouse ROUNDSNAP=1 ISeq emit, YJIT on
#   roundsnap-1p-noyjit   Roundhouse ROUNDSNAP=1 ISeq emit, YJIT off
#
# Thin wrapper around scripts/bench-campfire. YJIT is toggled by lane
# name (`*-noyjit` → RUBY_YJIT_ENABLE=0 / campfire-oracle --no-yjit).
#
# Usage:  scripts/bench-campfire-roundsnap [bench-campfire options...]

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT_DEFAULT="$REPO_ROOT/bench/results/campfire-roundsnap-$(date +%Y%m%d-%H%M%S)"

exec "$REPO_ROOT/scripts/bench-campfire" \
  --no-sockets \
  --workers 1 \
  --threads 5 \
  --duration "${BENCH_DURATION:-15}" \
  --warmup "${BENCH_WARMUP:-10}" \
  --runs "${BENCH_RUNS:-1}" \
  --endpoint /rooms/1 \
  --endpoint /rooms/1/messages \
  --out "${BENCH_OUT:-$OUT_DEFAULT}" \
  "$@" \
  rails-1p rails-1p-noyjit \
  ruby-1p ruby-1p-noyjit \
  roundsnap-1p roundsnap-1p-noyjit
