#!/usr/bin/env bash
# `apt-get install`, BOUNDED ON THE NETWORK, without a mandatory update.
#
# Usage: scripts/ci-apt-install libsqlite3-dev [more packages...]
#
# 49c596a0 bounded the dpkg LOCK (`-o DPkg::Lock::Timeout=120`) after
# three legs froze for 1h42m. Tonight two more froze, and the lock flag
# was already on the call that froze: `build-wasm` in run 32209637575
# printed `Get:5 … noble-security InRelease` at 02:45:53 and nothing
# more until the 45-minute job timeout killed it. The playwright hang in
# the run before it stopped at the SAME line. That is a stalled mirror
# SOCKET, not a held lock, and apt waits on it forever by default —
# `DPkg::Lock::Timeout` cannot help, because dpkg was never reached.
#
# apt's own knobs are the fix, so there is nothing hand-rolled to drift:
#
#   Acquire::http::Timeout / https::Timeout  — fail a stalled socket
#   Acquire::Retries                          — and try another mirror
#
# A killed job cancels the WHOLE RUN, which is why this matters beyond
# the wasted minutes: run 32207123547 reported "cancelled" while
# campfire's floor and every toolchain in it were green. A run
# conclusion that says nothing is worse than one that says no.
#
# Hosted Ubuntu images already carry an apt index. `apt-get update` was
# 13–50s of several jobs (and the hang surface above) before any
# package work. Skip packages that dpkg already has, try the image
# index first, and only refresh when that install cannot find a package.
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "usage: $0 <package> [package...]" >&2
  exit 2
fi

installed() {
  local status
  status="$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null || true)"
  [ "$status" = installed ]
}

need=()
for pkg in "$@"; do
  if installed "$pkg"; then
    echo "ci-apt-install: $pkg already installed"
  else
    need+=("$pkg")
  fi
done

if [ "${#need[@]}" -eq 0 ]; then
  echo "ci-apt-install: nothing to install"
  exit 0
fi

# The bounds live in an apt.conf.d drop-in rather than on this command
# line, so the apt calls we do NOT make (playwright's) get them too.
"$(dirname "$0")/ci-apt-bound"

install_pkgs() {
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends "$@"
}

if install_pkgs "${need[@]}"; then
  exit 0
fi

echo "ci-apt-install: image index missed packages; apt-get update and retry" >&2
sudo DEBIAN_FRONTEND=noninteractive apt-get update -q
install_pkgs "${need[@]}"
