#!/usr/bin/env bash
# scripts/create-store — build the Rails Guides "Getting Started" store
# application by following the guide.
#
#   https://guides.rubyonrails.org/getting_started.html   (Rails 8.1)
#
# The guide links no finished repository, so this script IS the
# canonical copy: every generator the guide runs, in the guide's order,
# and every file the guide ends with, verbatim from its final code
# block. The guide's prose is CC BY-SA 4.0 (rails/rails, guides/); the
# app skeleton is `rails new`'s. Re-run when the guide changes — the
# 8.0 → 8.1 revision moved the nav into the layout and renamed
# `permit` to `expect`, and a fixture derived by hand would not have
# noticed.
#
# Left out, deliberately: the deploy chapter (`config/deploy.yml`,
# Kamal, the production user) and the CI/rubocop/brakeman chapter —
# neither changes the application. `--skip-docker` for the same reason.
#
# Usage: create-store [app-name]      (default: store)
#   RAILS_NEW_VERSION=8.1.3 pins the generator, as create-blog does.
set -e
APP_NAME="${1:-store}"

echo "Creating the Getting Started store: $APP_NAME"
if [ -n "${RAILS_NEW_VERSION:-}" ]; then
  rails "_${RAILS_NEW_VERSION}_" new "$APP_NAME" --skip-git --skip-docker
else
  rails new "$APP_NAME" --skip-git --skip-docker
fi
cd "$APP_NAME"

# ── Creating a Database Model ────────────────────────────────────────
bin/rails generate model Product name:string
bin/rails db:create
bin/rails db:migrate

# ── Routes / Controllers ─────────────────────────────────────────────
bin/rails generate controller Products index --skip-routes

# ── Authentication ───────────────────────────────────────────────────
bin/rails generate authentication
bin/rails db:migrate

# ── Rich Text Fields (Action Text) ───────────────────────────────────
bin/rails action_text:install
bundle install
bin/rails db:migrate

# ── Basic Inventory Tracking ─────────────────────────────────────────
# The guide edits the generated migration to add `default: 0`.
bin/rails generate migration AddInventoryCountToProducts inventory_count:integer
ruby -pi -e 'sub(/add_column :products, :inventory_count, :integer$/, "add_column :products, :inventory_count, :integer, default: 0")' db/migrate/*_add_inventory_count_to_products.rb
bin/rails db:migrate

# ── Adding Subscribers to Products ───────────────────────────────────
bin/rails generate model Subscriber product:belongs_to email
bin/rails db:migrate

# ── In Stock Email Notifications ─────────────────────────────────────
bin/rails g mailer Product in_stock

# ── Final file states, in the guide's order ──────────────────────────
cat > config/routes.rb << 'ROUTES'
Rails.application.routes.draw do
  resource :session
  resources :passwords, param: :token
  # Define your application routes per the DSL in https://guides.rubyonrails.org/routing.html

  # Reveal health status on /up that returns 200 if the app boots with no exceptions, otherwise 500.
  # Can be used by load balancers and uptime monitors to verify that the app is live.
  get "up" => "rails/health#show", as: :rails_health_check

  # Render dynamic PWA files from app/views/pwa/* (remember to link manifest in application.html.erb)
  # get "manifest" => "rails/pwa#manifest", as: :pwa_manifest
  # get "service-worker" => "rails/pwa#service_worker", as: :pwa_service_worker

  # Defines the root path route ("/")
  root "products#index"
  resources :products do
    resources :subscribers, only: [ :create ]
  end
  resource :unsubscribe, only: [ :show ]
end
ROUTES

cat > app/controllers/products_controller.rb << 'CONTROLLER'
class ProductsController < ApplicationController
  allow_unauthenticated_access only: %i[ index show ]
  before_action :set_product, only: %i[ show edit update destroy ]

  def index
    @products = Product.all
  end

  def show
  end

  def new
    @product = Product.new
  end

  def create
    @product = Product.new(product_params)
    if @product.save
      redirect_to @product
    else
      render :new, status: :unprocessable_entity
    end
  end

  def edit
  end

  def update
    if @product.update(product_params)
      redirect_to @product
    else
      render :edit, status: :unprocessable_entity
    end
  end

  def destroy
    @product.destroy
    redirect_to products_path
  end

  private
    def set_product
      @product = Product.find(params[:id])
    end

    # Only allow a list of trusted parameters through.
    def product_params
      params.expect(product: [ :name, :description, :featured_image, :inventory_count ])
    end
end
CONTROLLER

