#!/usr/bin/env bash
# scripts/campfire-oracle — stand up REAL Rails campfire, to measure against.
#
# The reference side of the campfire benchmark, and the oracle the
# conformance lane has never had: every number this repo publishes about
# campfire so far describes the EMIT alone (scripts/campfire-suite runs
# campfire's tests against our output and never boots Rails at all). A
# throughput claim needs the other operand, and a DOM-equivalence claim
# needs it twice — see [[feedback_build_the_oracle_first]].
#
# WHY A COPY, NOT ~/git/once-campfire. `bundle install` has to add one
# line to the lockfile: campfire pins `ffi (1.17.2)` only in its
# platform-specific variants, and the arm64-darwin build does not install
# under Ruby 4.0. Bundling in a scratch copy keeps the user's checkout
# clean, and the divergence is exactly that one line — every other gem,
# INCLUDING Rails' git revision, resolves byte-identical to the pin.
# `--check-lock` prints the diff so that stays true rather than assumed.
#
# WHAT "RAILS" MEANS HERE, and a published number has to say it: campfire's
# Gemfile is `gem "rails", github: "rails/rails", branch: "main"`. The app
# is pinned by SHA; the FRAMEWORK is pinned only by the lockfile's git
# revision, which moves whenever campfire relocks. Naming "Rails 8.2" in a
# result is not enough — `prepare` records the revision in oracle.json and
# the report should print it. See [[feedback_pin_benchmarks_not_ledgers]].
#
# FRAGMENT CACHING IS A LANE, NOT A DETAIL. campfire renders its message
# list as `render partial: …, collection: @messages, cached: true`, and
# production.rb points `cache_store` at Redis. With Redis up, Rails reads
# 40 rendered message fragments back out of it and never runs the
# partial. MEASURED on this box, `/rooms/1/messages` after
# `redis-cli flushall`: 503 ms cold, 5 ms warm — 100x, and the 18-query
# request log is the same fact from the other side.
#
# That is what a campfire deployment really does, so it is a lane worth
# measuring. It is NOT a comparison against a tree that has no fragment
# cache: that number is Redis's, not Rails' renderer's. `serve` takes
# `--no-fragment-cache`, which sets `perform_caching = false` and the
# null store through `config/initializers/zz_bench_cache.rb` (written by
# `prepare`, gated on an env var, and the only file this oracle adds to
# campfire's own source). Rails RENDERING the same page takes ~46 ms.
#
# Publish both or publish neither.
#
# THE ORACLE SERVES PRODUCTION. This file used to boot
# `RAILS_ENV=development`, and that is not a slower Rails — it is a
# different one: code reloading on every request, a template compile per
# render, no eager load, a log line per query. MEASURED on this box,
# `/rooms/1` at 1 worker x 5 threads: 11.4 req/s development, 141.1
# production. Any number taken against the first would have flattered the
# emitted tree by 12x, which is larger than any result the benchmark
# could honestly report. `--env development` is still there for
# debugging; it is not a lane.
#
# LOGIN GOES THROUGH THE REAL FORM. Minting the signed session cookie by
# hand was tried first and the app read it back as a Hash: the cookie jar's
# envelope in Rails main is not the one a hand-built MessageVerifier
# produces. Reconstructing it is precisely the inference this script exists
# to avoid, so `login` POSTs to /session with a scraped CSRF token and
# keeps whatever cookie the app sets.
#
# Usage:
#   scripts/campfire-oracle prepare [options]   export, bundle, migrate, seed
#   scripts/campfire-oracle serve   [options]   boot Puma (blocks)
#   scripts/campfire-oracle login   [options]   write a logged-in cookie jar
#   scripts/campfire-oracle cookies [options]   mint one signed session cookie per seeded user
#   scripts/campfire-oracle check-lock          diff the lockfile vs the pin
#
# Options:
#   --app PATH      campfire checkout to export from (default ~/git/once-campfire)
#   --out DIR       oracle tree (default build/campfire-oracle)
#   --port N        HTTP port (default 4100)
#   --workers N     Puma workers. PIN THIS: campfire's config/puma.rb computes
#                   `(processor_count * 0.666).ceil`, so an unpinned oracle
#                   measures the box, not the app. Default 1, to match the
#                   single-worker shape scripts/bench uses for the ruby lanes.
#   --threads N     RAILS_MAX_THREADS per worker (default 5)
#   --users N       seeded users (default 50)
#   --rooms N       seeded rooms (default 5)
#   --messages N    seeded messages per room (default 100)
#   --deployed      Serve the shape once-campfire's own Dockerfile serves:
#                   campfire's `config/puma.rb` worker formula rather than
#                   a pinned count, jemalloc preloaded, Thruster in front,
#                   and resque-pool alongside. `--workers` is ignored.
#                   This is the lane a claim about beating "the current
#                   deployment" has to be made against; every other shape
#                   here is a diagnostic that explains it.
#   --shape-report P
#                   Write one `key=value` line per part of the shape
#                   `serve` actually achieved (jemalloc, thruster,
#                   resque-pool, workers), so a page can state what ran
#                   instead of what was asked for.
#   --no-jemalloc   Do not preload jemalloc. It IS preloaded by default
#                   (their Dockerfile sets LD_PRELOAD), because a memory
#                   column that compares runtimes must not be comparing
#                   malloc implementations. Ignored where no jemalloc is
#                   installed — `serve` says so rather than pretending.
#   --no-yjit       boot without YJIT (the baseline lane)
#   --env NAME      RAILS_ENV for `serve` (default production). Development
#                   is 12x slower on this app and is not a benchmark.
#   --no-fragment-cache
#                   Serve with `perform_caching = false` and the null
#                   store. Default is ON, which is what a campfire
#                   deployment does — and which makes the message list a
#                   Redis read rather than a render. See the header.
#   --jar PATH      cookie jar for `login` (default <out>/tmp/bench-jar.txt)
#   --count N       users to mint cookies for (`cookies`, default --users)
#   --cookie-file P where `cookies` writes them (default <out>/tmp/session-cookies.txt)
#
# Requires: ruby, bundler, sqlite3, curl. Everything else comes from
# campfire's own Gemfile.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

CMD="${1:-}"; [[ $# -gt 0 ]] && shift || true
APP="$HOME/git/once-campfire"
OUT="$REPO_ROOT/build/campfire-oracle"
PORT=4100
WORKERS=1
THREADS=5
USERS=50
ROOMS=5
MESSAGES=100
YJIT=1
# PRODUCTION, not development, and this is the whole difference between a
# number and a fiction. Rails in development reloads code on every
# request, compiles a template per render, eager-loads nothing and logs
# every query. MEASURED on this box, campfire `/rooms/1` at 1 worker × 5
# threads: 11.4 req/s in development, 141.1 in production — the same app,
# 12x apart. A benchmark that quoted the first number would be off by
# more than any result it could report.
#
# `login` and `prepare` are environment-agnostic; only `serve` reads this.
RAILS_ENV_NAME="production"
# 1 = campfire as deployed (Redis-backed fragment cache); 0 = Rails
# actually rendering. See the header — these are two different
# measurements and both are real.
FRAGMENT_CACHE=1
# The deployed shape (their Dockerfile + Procfile), off by default so the
# single-worker diagnostic lanes stay exactly what they were.
DEPLOYED=0
JEMALLOC=1
# Where `serve` records which parts of the deployed shape it achieved.
SHAPE_REPORT=""
JAR=""
COUNT=""
COOKIE_FILE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --app)      APP="$2"; shift 2 ;;
        --out)      OUT="$2"; shift 2 ;;
        --port)     PORT="$2"; shift 2 ;;
        --workers)  WORKERS="$2"; shift 2 ;;
        --threads)  THREADS="$2"; shift 2 ;;
        --users)    USERS="$2"; shift 2 ;;
        --rooms)    ROOMS="$2"; shift 2 ;;
        --messages) MESSAGES="$2"; shift 2 ;;
        --deployed) DEPLOYED=1; shift ;;
        --shape-report) SHAPE_REPORT="$2"; : > "$SHAPE_REPORT"; shift 2 ;;
        --no-jemalloc) JEMALLOC=0; shift ;;
        --no-yjit)  YJIT=0; shift ;;
        --no-fragment-cache) FRAGMENT_CACHE=0; shift ;;
        --env)      RAILS_ENV_NAME="$2"; shift 2 ;;
        --jar)      JAR="$2"; shift 2 ;;
        --count)    COUNT="$2"; shift 2 ;;
        --cookie-file) COOKIE_FILE="$2"; shift 2 ;;
        -h|--help)  sed -n '2,60p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)          echo "campfire-oracle: unknown argument $1" >&2; exit 2 ;;
    esac
done

JAR="${JAR:-$OUT/tmp/bench-jar.txt}"
COUNT="${COUNT:-$USERS}"
COOKIE_FILE="${COOKIE_FILE:-$OUT/tmp/session-cookies.txt}"

# The secret is fixed, not random: a cookie minted against one boot has to
# survive the next one, and a signed id in a dumped page has to be
# comparable across runs. It is a benchmark fixture, never a deployment.
export SECRET_KEY_BASE="${SECRET_KEY_BASE:-campfire-oracle-benchmark-secret-not-a-deployment}"

step() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31mcampfire-oracle:\033[0m %s\n' "$*" >&2; exit 1; }

cmd_prepare() {
    [[ -d "$APP" ]] || die "no campfire checkout at $APP"
    command -v sqlite3 >/dev/null || die "sqlite3 not on PATH"

    local sha
    sha="$(git -C "$APP" rev-parse HEAD 2>/dev/null || echo unknown)"

    step "exporting $APP @ ${sha:0:12} -> $OUT"
    rm -rf "$OUT"; mkdir -p "$OUT"
    if git -C "$APP" rev-parse HEAD >/dev/null 2>&1; then
        # git archive: tracked files only, no local litter.
        (cd "$APP" && git archive HEAD) | tar -x -C "$OUT"
    else
        # A tarball checkout (CI fetches the pin without .git) has no
        # archive to give — and also nothing untracked to exclude.
        (cd "$APP" && tar -cf - .) | tar -x -C "$OUT"
    fi

    step "bundling (see the header on why this is a copy)"
    (cd "$OUT" && bundle install >/dev/null) || die "bundle install failed"

    step "migrating"
    (cd "$OUT" && RAILS_ENV=development bin/rails db:prepare >/dev/null) \
        || die "db:prepare failed"

    step "seeding: $USERS users, $ROOMS rooms, $MESSAGES messages/room"
    (cd "$OUT" && CF_USERS="$USERS" CF_ROOMS="$ROOMS" CF_MESSAGES="$MESSAGES" \
        bin/rails runner "$(cat "$REPO_ROOT/scripts/campfire-oracle-seed.rb")") \
        || die "seeding failed"

    # The one file this oracle adds to campfire's own source, and it is
    # inert unless the env var is set — see the header on why fragment
    # caching is a lane rather than a setting.
    step "installing the fragment-cache lane knob"
    cat > "$OUT/config/initializers/zz_bench_cache.rb" <<'INIT'
# Benchmark lane knob, added by roundhouse's scripts/campfire-oracle.
# NOT campfire's: inert unless DISABLE_FRAGMENT_CACHE=1.
#
# campfire renders its message list with `cached: true` against a
# Redis-backed store. That is what a deployment does, and it means the
# 40 message fragments are READ BACK rather than rendered — measured at
# 503 ms cold against 5 ms warm. A tree with no fragment cache cannot be
# compared against the warm number; this switch produces the other
# operand, Rails actually rendering.
if ENV["DISABLE_FRAGMENT_CACHE"] == "1"
  Rails.application.config.action_controller.perform_caching = false
  Rails.application.config.cache_store = :null_store
end
INIT

    # The production DB is a COPY of the seeded development one, not a
    # second seeding run: both lanes of the benchmark have to read the
    # same rows, and `serve` defaults to production (see RAILS_ENV_NAME).
    step "staging production DB from the seed"
    cp "$OUT/storage/db/development.sqlite3" "$OUT/storage/db/production.sqlite3"

    # Propshaft resolves digested asset paths from the manifest in
    # production; without this every `stylesheet_link_tag` raises and the
    # oracle serves 500s.
    step "precompiling assets"
    (cd "$OUT" && SECRET_KEY_BASE="$SECRET_KEY_BASE" RAILS_ENV=production \
        bundle exec rails assets:precompile >/dev/null) \
        || die "assets:precompile failed"

    # Provenance, so a result can name what it measured. The Rails revision
    # matters as much as campfire's SHA — see the header.
    local rails_rev
    rails_rev="$(awk '/remote: https:\/\/github.com\/rails\/rails/{getline; print $2}' \
                 "$OUT/Gemfile.lock" 2>/dev/null || echo unknown)"
    mkdir -p "$OUT/tmp"
    cat > "$OUT/oracle.json" <<JSON
{
  "campfire_sha": "$sha",
  "rails_revision": "$rails_rev",
  "rails_version": "$(cd "$OUT" && bin/rails runner 'print Rails.version' 2>/dev/null || echo unknown)",
  "ruby_version": "$(ruby -e 'print RUBY_VERSION')",
  "serve_env": "$RAILS_ENV_NAME",
  "fragment_cache_default": true,
  "seed": { "users": $USERS, "rooms": $ROOMS, "messages_per_room": $MESSAGES }
}
JSON
    step "ready — $(tr -d '\n ' < "$OUT/oracle.json")"
}

# WHERE THE ALLOCATOR IS, if it is anywhere. campfire's Dockerfile
# symlinks `libjemalloc.so.2` to `/usr/local/lib/libjemalloc.so` and
# preloads it; a bench box that installed the distro package has it under
# a triplet directory instead, and a Mac usually has it nowhere. Echoes
# the path, or nothing — the caller reports the absence rather than
# quietly serving a different shape than it says it is serving.
find_jemalloc() {
    local c
    for c in /usr/local/lib/libjemalloc.so \
             /usr/lib/x86_64-linux-gnu/libjemalloc.so.2 \
             /usr/lib/aarch64-linux-gnu/libjemalloc.so.2 \
             /usr/lib64/libjemalloc.so.2 \
             /opt/homebrew/lib/libjemalloc.dylib \
             /usr/local/opt/jemalloc/lib/libjemalloc.dylib; do
        [[ -e "$c" ]] && { echo "$c"; return 0; }
    done
    # Anything the loader knows about that we did not name.
    c="$(ldconfig -p 2>/dev/null | awk '/libjemalloc\.so\.2/ {print $NF; exit}')"
    [[ -n "$c" && -e "$c" ]] && { echo "$c"; return 0; }
    return 1
}

# The deployed shape, and the parts of it we actually achieved. Written
# beside the run so the page can state which of the four landed rather
# than implying all of them did: a benchmark that claims Thruster and
# silently ran without it is worse than one that never claimed it.
report_shape() { [[ -n "$SHAPE_REPORT" ]] && printf '%s\n' "$1" >> "$SHAPE_REPORT"; return 0; }

cmd_serve() {
    [[ -d "$OUT" ]] || die "no oracle at $OUT — run 'prepare' first"
    if [[ "$RAILS_ENV_NAME" == "production" && ! -f "$OUT/storage/db/production.sqlite3" ]]; then
        die "no production DB — run 'prepare' (it stages one from the seed)"
    fi
    (( DEPLOYED )) && { cmd_serve_deployed; return; }
    step "puma :$PORT — $RAILS_ENV_NAME, $WORKERS worker(s), $THREADS thread(s), yjit=$YJIT, fragment-cache=$FRAGMENT_CACHE"
    cd "$OUT"
    # WEB_CONCURRENCY is what campfire's config/puma.rb reads; without it the
    # oracle sizes itself to the box and the comparison stops being one.
    #
    # DISABLE_SSL: campfire's production.rb sets `force_ssl` and
    # `assume_ssl` unless it is set, and a benchmark client speaking
    # plain HTTP would measure a 301 to https.
    #
    # RAILS_LOG_LEVEL=warn: production.rb logs every request at info to
    # STDOUT. Our tree logs nothing, so leaving it on would charge Rails
    # for output the other lane does not produce.
    # jemalloc on EVERY Ruby lane, deployed or diagnostic. Their
    # Dockerfile preloads it; a memory column that compared their
    # allocator against ours would be measuring malloc, not runtimes.
    local jem=""
    if (( JEMALLOC )); then
        jem="$(find_jemalloc || true)"
        [[ -n "$jem" ]] && report_shape "jemalloc=$jem" || report_shape "jemalloc=ABSENT"
    else
        report_shape "jemalloc=off"
    fi
    WEB_CONCURRENCY="$WORKERS" RAILS_MAX_THREADS="$THREADS" \
    RUBY_YJIT_ENABLE="$YJIT" RAILS_ENV="$RAILS_ENV_NAME" DISABLE_SSL=1 \
    DISABLE_FRAGMENT_CACHE="$(( 1 - FRAGMENT_CACHE ))" \
    RAILS_LOG_LEVEL="${RAILS_LOG_LEVEL:-warn}" \
    ${jem:+LD_PRELOAD="$jem"} \
        exec bundle exec puma -p "$PORT" -e "$RAILS_ENV_NAME" config.ru
}

# ── the deployed shape ───────────────────────────────────────────────
#
# once-campfire's Dockerfile ends `CMD ["bin/boot"]`, and bin/boot runs a
# Procfile with three processes:
#
#   web:     bundle exec thrust bin/start-app
#   redis:   redis-server config/redis.conf
#   workers: FORK_PER_JOB=false INTERVAL=0.1 bundle exec resque-pool
#
# plus `ENV LD_PRELOAD=…libjemalloc.so` and a `config/puma.rb` that takes
# `(Concurrent.processor_count * 0.666).ceil` workers with 5 threads
# each. THAT is "the current deployment"; one Puma worker with five
# threads is a diagnostic we invented to compare renderers per process.
#
# Two deliberate differences, both recorded in the shape report:
#   * redis is the box's, already running, rather than a fourth process
#     under our supervision — same server, one less thing to leak.
#   * Puma is exec'd directly rather than through `bin/start-app`, which
#     would run `bin/rails db:prepare` against the seeded database on
#     every boot. Puma loads `config/puma.rb` either way, so the worker
#     formula, the thread count and the bind are campfire's own.
cmd_serve_deployed() {
    cd "$OUT"
    mkdir -p "$OUT/tmp"
    local inner=$(( PORT + 1000 ))
    local jem=""
    if (( JEMALLOC )); then
        jem="$(find_jemalloc || true)"
        if [[ -n "$jem" ]]; then report_shape "jemalloc=$jem"; else report_shape "jemalloc=ABSENT"; fi
    else
        report_shape "jemalloc=off"
    fi

    # resque-pool, exactly as the Procfile runs it. It competes for the
    # same cores in the deployment, which is part of what the deployment
    # costs, so it runs here too — backgrounded, and killed with us.
    RAILS_ENV="$RAILS_ENV_NAME" DISABLE_SSL=1 FORK_PER_JOB=false INTERVAL=0.1 \
    ${jem:+LD_PRELOAD="$jem"} \
        bundle exec resque-pool > "$OUT/tmp/resque-pool.log" 2>&1 &
    JOBS_PID=$!
    sleep 0.5
    if kill -0 "$JOBS_PID" 2>/dev/null; then
        report_shape "resque-pool=pid $JOBS_PID"
    else
        JOBS_PID=""
        report_shape "resque-pool=FAILED (see tmp/resque-pool.log)"
    fi
    trap 'kill_jobs' INT TERM EXIT

    # WEB_CONCURRENCY is UNSET rather than empty: campfire's puma.rb reads
    # it with `ENV.fetch("WEB_CONCURRENCY") { worker_count }`, and an
    # empty string is a value — it would boot ZERO workers and the
    # deployed lane would silently become single-process, which is the
    # exact thing this lane exists to stop doing.
    #
    # Thruster in front, on $PORT, proxying to Puma on $inner. campfire's
    # puma.rb binds `ENV.fetch("PORT", 3000)`, so the inner port is
    # passed as PORT rather than with `-p`. Its presence is probed with
    # `bundle info` and never by running it: `thrust` treats its first
    # argument as the command to wrap, so `thrust --version` starts a
    # server on :80 before failing.
    local common=(
        RAILS_MAX_THREADS="$THREADS"
        RUBY_YJIT_ENABLE="$YJIT"
        RAILS_ENV="$RAILS_ENV_NAME"
        DISABLE_SSL=1
        DISABLE_FRAGMENT_CACHE="$(( 1 - FRAGMENT_CACHE ))"
        RAILS_LOG_LEVEL="${RAILS_LOG_LEVEL:-warn}"
    )
    [[ -n "$jem" ]] && common+=( LD_PRELOAD="$jem" )

    if bundle info thruster >/dev/null 2>&1; then
        report_shape "thruster=front on :$PORT -> puma :$inner"
        report_shape "workers=campfire's own formula (WEB_CONCURRENCY unset)"
        step "deployed :$PORT — thruster -> puma :$inner, campfire's worker formula, $THREADS thread(s), fragment-cache=$FRAGMENT_CACHE"
        # NOT `exec`. `exec` replaces this shell, and with it the EXIT
        # trap that stops resque-pool — which would then outlive the
        # lane, keep a Redis connection and keep taking cores from the
        # next one. Run the server as a child and wait on it.
        env -u WEB_CONCURRENCY "${common[@]}" \
            PORT="$inner" TARGET_PORT="$inner" HTTP_PORT="$PORT" \
            bundle exec thrust bundle exec puma -e "$RAILS_ENV_NAME" config.ru &
        WEB_PID=$!
        wait "$WEB_PID"
    else
        report_shape "thruster=ABSENT (puma serves :$PORT directly)"
        report_shape "workers=campfire's own formula (WEB_CONCURRENCY unset)"
        step "deployed :$PORT — puma (no thruster), campfire's worker formula, $THREADS thread(s)"
        env -u WEB_CONCURRENCY "${common[@]}" PORT="$PORT" \
            bundle exec puma -e "$RAILS_ENV_NAME" config.ru &
        WEB_PID=$!
        wait "$WEB_PID"
    fi
}

JOBS_PID=""
WEB_PID=""
# Everything this lane started, stopped together. Thruster supervises the
# Puma it wraps, so terminating it is enough for the web half; resque-pool
# is ours alone and is the one that would be left behind.
kill_jobs() {
    [[ -n "$JOBS_PID" ]] && kill -TERM "$JOBS_PID" 2>/dev/null
    [[ -n "$WEB_PID" ]] && kill -TERM "$WEB_PID" 2>/dev/null
    return 0
}

cmd_login() {
    mkdir -p "$(dirname "$JAR")"; rm -f "$JAR"
    local token
    token="$(curl -sS -c "$JAR" "http://127.0.0.1:$PORT/session/new" \
             | grep -o 'name="authenticity_token" value="[^"]*"' | head -1 \
             | sed 's/.*value="//; s/"$//')"
    [[ -n "$token" ]] || die "no CSRF token at /session/new — is the server up on :$PORT?"
    local code
    code="$(curl -sS -b "$JAR" -c "$JAR" -o /dev/null -w '%{http_code}' \
            -X POST "http://127.0.0.1:$PORT/session" \
            --data-urlencode "email_address=user1@example.com" \
            --data-urlencode "password=secret123456" \
            --data-urlencode "authenticity_token=$token")"
    [[ "$code" == "302" ]] || die "sign-in returned $code, expected 302"
    step "signed in — jar at $JAR"
}

cmd_cookies() {
    [[ -d "$OUT" ]] || die "no oracle at $OUT — run 'prepare' first"
    mkdir -p "$(dirname "$COOKIE_FILE")"

    # WHY MINTING AND NOT SIGNING IN. campfire rate-limits
    # `SessionsController#create` to 10 per 3 minutes per IP and each one
    # is a bcrypt; a thousand-socket sweep cannot log its users in. ONCE's
    # own load harness has the same problem and answers it the same way —
    # `test/performance/create_dummy_cookies.rb` ships 10,000 pre-forged
    # cookies. Sign-in is not the workload the requirements table is about.
    #
    # THROUGH RAILS' OWN JAR, not a hand-built MessageVerifier. That was
    # tried for `login` and the app read the cookie back as a Hash: the
    # envelope in Rails main is not the one an assembled verifier
    # produces. `CookieJar.build` against the app's real `env_config`
    # signs it the way the app will read it, and reconstructing that is
    # precisely the inference this oracle exists to avoid.
    #
    # THE TOKENS ARE THE SEED'S. scripts/campfire-oracle-seed.rb writes
    # `Session` rows with campfire's own performance.rb token shape —
    # 19 filler characters and a zero-padded user id — so line i of this
    # file is user i, on either lane.
    #
    # BOTH LANES READ IT. The binary's `cookies.signed[:session_token]`
    # verifies the same `_rails` envelope under the same "signed cookie"
    # salt and 2**16 PBKDF2 iterations, so the sweep hands one file to
    # Rails and to the binary and neither one signs anybody in. Boot the
    # binary with this SECRET_KEY_BASE or it will reject every cookie.
    step "minting $COUNT session cookies -> $COOKIE_FILE"
    (cd "$OUT" && SECRET_KEY_BASE="$SECRET_KEY_BASE" RAILS_ENV="$RAILS_ENV_NAME" DISABLE_SSL=1 \
        bin/rails runner "
          req = ActionDispatch::Request.new(Rails.application.env_config.merge(
            'HTTP_HOST' => '127.0.0.1', 'rack.input' => StringIO.new))
          jar = ActionDispatch::Cookies::CookieJar.build(req, {})
          # ONE COOKIE PER USER, IN USER ORDER, and derived from the id
          # rather than read off whatever Session rows exist. Every form
          # sign-in against this oracle mints another row, so
          # \`Session.order(:user_id).limit(n)\` returns the same low user
          # several times over — measured: eight sockets spread across two
          # users, and a presence table that looked like a bug in the app.
          missing = []
          File.open('$COOKIE_FILE', 'w') do |f|
            User.order(:id).limit($COUNT).pluck(:id).each do |id|
              token = 'a' * 19 + id.to_s.rjust(5, '0')
              missing << id unless Session.exists?(token: token)
              jar.signed[:session_token] = { value: token, httponly: true, same_site: :lax }
              f.puts jar[:session_token]
            end
          end
          abort \"no seeded session for user(s) #{missing.first(5).join(', ')} — reseed\" if missing.any?
        ") || die "minting failed"
    local n; n="$(wc -l < "$COOKIE_FILE" | tr -d " ")"
    [[ "$n" -gt 0 ]] || die "no sessions in the seed — run 'prepare'"
    step "$n cookies (SECRET_KEY_BASE=$SECRET_KEY_BASE)"
}

cmd_check_lock() {
    [[ -f "$OUT/Gemfile.lock" ]] || die "no oracle at $OUT — run 'prepare' first"
    if diff "$APP/Gemfile.lock" "$OUT/Gemfile.lock"; then
        step "lockfiles identical"
    else
        step "the differences above are the oracle's resolution; anything beyond"
        step "the generic-platform ffi line means the oracle is NOT the pin"
    fi
}

case "$CMD" in
    prepare)    cmd_prepare ;;
    serve)      cmd_serve ;;
    login)      cmd_login ;;
    cookies)    cmd_cookies ;;
    check-lock) cmd_check_lock ;;
    ""|-h|--help) sed -n '2,60p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)          die "unknown command '$CMD' (prepare|serve|login|cookies|check-lock)" ;;
esac
