#!/usr/bin/env ruby
# scripts/lobsters-spinel-replay — the spinel lane's wrapper.
#
# Stages the emitted spinel tree with an in-process replay driver, compiles
# it, runs it, and writes the same summary.json shape the other lanes emit
# so scripts/bench-lobsters can aggregate it and lobsters-content-diff can
# compare its bodies.
#
# WHY A SEPARATE SCRIPT. The CRuby and JRuby lanes share one driver
# (scripts/lobsters-replay) because both can `require` the emitted tree. A
# spinel tree is a native binary: its driver has to be COMPILED IN. So the
# division of labour is
#
#   scripts/lobsters-spinel-driver.rb   compiled into the binary; drives
#                                       Main.dispatch, speaks plain text
#   this script                         stages, builds, runs, and turns
#                                       that text into summary.json
#
# Nothing on the compiled side parses or emits JSON — every construct there
# is native code subject to the spinel subset, so the compiled surface stays
# as small as the job allows and the fiddly formatting lives here.
#
# The measurement is methodologically the SAME as the CRuby lanes': the
# driver calls Main.dispatch, the identical seam Tep::Server calls, with no
# socket and no HTTP parse in the loop.
#
# Usage:
#   scripts/lobsters-spinel-replay --tree DIR --sequence F --json OUT.json
#                                  [--md OUT.md] [--dump DIR] [--db PATH]
#                                  [--warmup N] [--time N] [--min-time S]
#                                  [--bcrypt PATH] [--skip-build]
#
# Exit code = number of failing parity routes (0 = full parity), or 100 on
# a staging/build/boot failure — the caller records that as a dead lane.

require "json"
require "fileutils"

opts = { warmup: 5, time: 10, min_time: 10, db: nil }
args = ARGV.dup
until args.empty?
  case (a = args.shift)
  when "--tree"       then opts[:tree]     = File.expand_path(args.shift)
  when "--defer"      then opts[:defer]    = File.expand_path(args.shift)
  when "--sequence"   then opts[:sequence] = File.expand_path(args.shift)
  when "--json"       then opts[:json]     = File.expand_path(args.shift)
  when "--md"         then opts[:md]       = File.expand_path(args.shift)
  when "--dump"       then opts[:dump]     = File.expand_path(args.shift)
  when "--db"         then opts[:db]       = File.expand_path(args.shift)
  when "--bcrypt"     then opts[:bcrypt]   = File.expand_path(args.shift)
  when "--sqlite-lib" then opts[:sqlite_lib] = File.expand_path(args.shift)
  when "--warmup"     then opts[:warmup]   = Integer(args.shift)
  when "--time"       then opts[:time]     = Integer(args.shift)
  when "--min-time"   then opts[:min_time] = Integer(args.shift)
  when "--skip-build" then opts[:skip_build] = true
  else abort "lobsters-spinel-replay: unknown arg #{a}"
  end
end
%i[tree sequence json].each { |k| opts[k] or abort "lobsters-spinel-replay: --#{k} is required" }
TREE = opts[:tree]
File.directory?(TREE) or abort "lobsters-spinel-replay: no tree at #{TREE}"

# Context FIRST, one-line reason LAST. The orchestrator records a dead
# lane's detail by taking the last non-empty line of this log, so the
# headline has to be the final line or the page ends up quoting whatever
# incidental output happened to trail the failure.
def die(stage, detail, context = nil)
  warn context if context && !context.empty?
  warn "lobsters-spinel-replay: #{stage}: #{detail}"
  exit 100
end

# ── stage the driver ─────────────────────────────────────────────────
# Copied in on EVERY run, never left behind for a re-emit to lose: the
# tree is a build artifact and roundhouse rewrites main.rb from the
# scaffold each time it is emitted.
driver_src = File.join(__dir__, "lobsters-spinel-driver.rb")
FileUtils.cp(driver_src, File.join(TREE, "bench_driver.rb"))
# The Makefile's RUBY_SRC globs main.rb + runtime/ app/ config/ — a driver
# at the tree root is invisible to it, so `make build` would call the binary
# up to date and silently run the PREVIOUS driver. Touch main.rb so an
# edited driver always reaches the binary being measured.
FileUtils.touch(File.join(TREE, "main.rb"))

main = File.join(TREE, "main.rb")
src  = File.read(main)
unless src.include?("BenchDriver")
  # Two edits, both anchored on generated text. The ARGV loop rejects
  # unknown flags, so --bench has to be accepted there AND acted on after
  # the adapter is configured — teaching only one of the two yields
  # "unknown option: --bench".
  flag_anchor = %(  elsif (arg == "--port" || arg == "-p") && i + 1 < ARGV.length)
  die("stage", "main.rb ARGV anchor not found") unless src.include?(flag_anchor)
  # --bench swallows the REST of argv (the driver's six positional args),
  # so the generated loop must stop rather than try to parse them.
  src = src.sub(flag_anchor, <<~RB.chomp + "\n" + flag_anchor)
      elsif arg == "--bench"
        i = ARGV.length
  RB

  # The require must be TOP LEVEL and unconditional: spinel resolves
  # requires at compile time, so one tucked inside an `if` leaves the
  # constant undefined at run time (uninitialized constant BenchDriver).
  req_anchor = %(require_relative "runtime/db")
  die("stage", "main.rb require anchor not found") unless src.include?(req_anchor)
  src = src.sub(req_anchor, %(require_relative "bench_driver"\n) + req_anchor)

  boot_anchor = "Main.configure_default_adapter!"
  die("stage", "main.rb boot anchor not found") unless src.include?(boot_anchor)
  src = src.sub(boot_anchor, <<~RB.chomp)
    Main.configure_default_adapter!

    # Injected by scripts/lobsters-spinel-replay. The server start below is
    # unconditional, so the bench entry has to run BEFORE it and exit.
    if ARGV.length > 1 && ARGV[0] == "--bench"
      BenchDriver.run(ARGV[1].to_s, ARGV[2].to_s, ARGV[3].to_s,
                      ARGV[4].to_i, ARGV[5].to_i, ARGV[6].to_i,
                      ARGV.length > 7 ? ARGV[7].to_s : "")
      exit(0)
    end
  RB
  File.write(main, src)
end

# bcrypt is a spin package; the published index may not carry it, so a
# local checkout can be pointed at instead. Without this the build fails
# with "not in the index" and the lane is dead for an avoidable reason.
if opts[:bcrypt] && File.directory?(opts[:bcrypt])
  lock = File.join(TREE, "spin.lock")
  toml = File.read(File.join(TREE, "spin.toml"))
  unless toml.include?(opts[:bcrypt])
    system("spin", "add", "bcrypt", "--path", opts[:bcrypt], chdir: TREE,
           out: File::NULL, err: File::NULL) or die("stage", "spin add bcrypt failed")
  end
  File.exist?(lock) or nil
end

# ── build ────────────────────────────────────────────────────────────
BIN = File.join(TREE, "build", "blog")

# WHO COMPILED THIS. An interpreted lane names its runtime in every artifact
# (RUBY_DESCRIPTION), so a row on the page can always be tied back to the
# thing that ran it. The AOT lane named nothing: the binary's timings were
# reported with no record of the compiler that produced them. That is not a
# cosmetic gap — a spinel fix landing between two runs shows up as a large
# unexplained movement in this lane, and without these two strings there is
# nothing in the data to attribute it to.
#
# `spinel --version` reports the commit the BINARY WAS BUILT FROM, which is
# what compiled this run — deliberately not the checkout's current HEAD,
# which may have moved on since that binary was built. Captured next to the
# build, not at boot, so it names the compiler this tree was actually built
# with even under --skip-build.
def tool_version(cmd)
  out = `#{cmd} 2>/dev/null`
  $?.success? && !out.strip.empty? ? out.lines.first.strip : nil
end
SPINEL_VERSION = tool_version("#{ENV['SPINEL'] || 'spinel'} --version")
CC_VERSION     = tool_version("#{ENV['CC'] || 'cc'} --version")

unless opts[:skip_build] && File.executable?(BIN)
  t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  log = File.join(TREE, "spin-build.log")
  # --sqlite-lib DIR: a directory holding ONLY libsqlite3.a (the vendored
  # amalgamation at the bundle's version — scripts/bench-lobsters builds
  # it). LIBRARY_PATH puts it ahead of the system search path, so the
  # tree's own `ffi_lib "sqlite3"` link line resolves to it — no file in
  # the tree changes, and the published tarball still builds anywhere
  # against a stock -lsqlite3. The lane's summary records which build the
  # binary actually queried, so this is attested, not assumed.
  build_env = {}
  if opts[:sqlite_lib] && File.exist?(File.join(opts[:sqlite_lib], "libsqlite3.a"))
    build_env["LIBRARY_PATH"] =
      [opts[:sqlite_lib], ENV["LIBRARY_PATH"]].compact.join(File::PATH_SEPARATOR)
  end
  ok = system(build_env, "make", "build", chdir: TREE, out: log, err: [log, "a"])
  build_s = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0).round(1)
  unless ok
    tail = (File.readlines(log).last(15).join rescue "")
    die("build", "spin build failed after #{build_s}s", tail)
  end
  BUILD_SECONDS = build_s
  # TWO PRODUCERS WRITE "warning:" INTO THIS LOG AND THEY MEAN DIFFERENT
  # THINGS. A `spinel: warning:` line is spinel talking about its own
  # analysis of the Ruby (`--rbs ivar pin @id dropped on Story`) — modeling
  # debt, one per model, expected. A `file:line:col: warning:` line is cc
  # talking about the C spinel GENERATED, which is the one that can be a
  # latent miscompile. Counting both as one number reported "29 C warnings"
  # for a build with 23 of the former and 6 of the latter, which reads as
  # far worse generated code than it is while hiding the six that matter.
  txt = (File.read(log) rescue "")
  SPINEL_WARNINGS = txt.scan(/^spinel: warning:/).size
  C_WARNINGS      = txt.scan(/^\S+:\d+:\d+: warning:/).size
else
  BUILD_SECONDS = nil
  C_WARNINGS = nil
  SPINEL_WARNINGS = nil
end
File.executable?(BIN) or die("build", "no binary at #{BIN}")

# ── route set ────────────────────────────────────────────────────────
# The parity routes, with story/comment ids resolved the same way
# scripts/lobsters-replay resolves them (lowest-id non-deleted row) so all
# lanes land on the same records and their dumps line up file for file.
DB = opts[:db] || File.join(TREE, "storage", "bench.sqlite3")
File.exist?(DB) or die("stage", "no DB at #{DB}")
def sqlite_one(db, sql)
  out = `sqlite3 #{db.shellescape} #{sql.shellescape} 2>/dev/null`.strip
  out.empty? ? nil : out.lines.first.strip
end
require "shellwords"

# ANALYZE, for the same reason and with the same urgency as the comment in
# scripts/lobsters-replay: "BOTH lanes must get identical stats or the
# comparison is dishonest." The fixture ships without sqlite_stat1, and the
# staged copy this lane serves inherits that — so without this the AOT lane
# alone runs on a planner that misplans the hottest-stories SELECT into a
# full-table walk plus temp-btree sort (5.1ms vs 0.05ms per query), while
# every interpreted lane it is charted against runs with statistics. That is
# a handicap applied to one row of a comparison table, which is worse than
# no number at all.
#
# Done here rather than where the file is staged so it holds however the DB
# arrived, including a caller-supplied --db. Idempotent, and outside every
# timed section.
unless sqlite_one(DB, "SELECT name FROM sqlite_master WHERE name = 'sqlite_stat1'")
  system("sqlite3", DB, "ANALYZE", out: File::NULL, err: File::NULL) or
    warn "lobsters-spinel-replay: ANALYZE failed on #{DB} — timings will reflect an unplanned database"
end

STORY   = sqlite_one(DB, "SELECT short_id FROM stories  WHERE is_deleted = 0 ORDER BY id LIMIT 1") || "enr7ye"
COMMENT = sqlite_one(DB, "SELECT short_id FROM comments WHERE is_deleted = 0 ORDER BY id LIMIT 1") || "6srqij"
USERNAME = "michell_wiegand"

ROUTES = [
  "/u", "/active", "/newest", "/recent", "/hottest",
  "/rss", "/privacy", "/about", "/settings",
  "/top?length=1d", "/top?length=1w", "/top?length=1y",
  "/hidden", "/saved", "/upvoted/stories",
  "/comments", "/upvoted/comments", "/threads", "/comments/#{COMMENT}/reply",
  "/threads/#{USERNAME}", "/u/#{USERNAME}",
  "/replies", "/replies/comments", "/replies/stories", "/replies/unread",
  "/s/#{STORY}",
].freeze

work = File.join(TREE, "bench-work")
FileUtils.mkdir_p(work)
routes_file = File.join(work, "routes.txt")
seq_file    = File.join(work, "sequence.txt")
File.write(routes_file, ROUTES.map { |r| "GET #{r}" }.join("\n"))
visits = JSON.parse(File.read(opts[:sequence]))["visits"]
# These definitions sit above their first call ON PURPOSE. A top-level `def`
# binds only when execution reaches it, so calling one from earlier in the
# file raises NoMethodError at run time while `ruby -c` reports nothing --
# which is exactly how a broken lane reached the published page.
# ── parse the driver's plain-text report ─────────────────────────────
# Kept character-for-character in step with scripts/lobsters-replay: the
# per-endpoint section joins lanes on these keys (`rh_pr.keys.select { |k|
# rl_pr.key?(k) }`), so a template this lane spells differently is not a
# mismatched label, it is a row that silently vanishes from the comparison.
ROUTE_TEMPLATES = [
  [%r{\A/comments/[^/]+/reply\z}, "/comments/:comment_id/reply"],
  [%r{\A/threads/[^/]+\z},        "/threads/:username"],
  [%r{\A/u/[^/]+\z},              "/u/:username"],
  [%r{\A/s/[^/]+\z},              "/s/:story_id"],
].freeze

def route_template(path)
  base = path.split("?", 2).first
  ROUTE_TEMPLATES.each { |re, tmpl| return tmpl if base.match?(re) }
  path
end

# Routes DEFERRED out of the timed sequence, declared in
# bench/lobsters/declared-gaps.json. A deferred route is one the emit is
# known not to render; timing it measures an exception or the wrong
# document, and leaving it in makes ms/iter faster than real work for a
# reason that has nothing to do with speed.
#
# The filter keys off route_template, so it drops every concrete visit of a
# deferred route (the sequence visits /u/:username six times, with six
# different usernames). EVERY lane must apply the same list or the lanes
# time different work and the ratio between them stops meaning anything --
# which is why the orchestrator passes the same file to all of them.
#
# A declared route matching no visit is fatal: a deferral that silently
# defers nothing leaves the failing visits in the timing while the page
# claims they were excluded.
def load_deferred(path)
  # Announce either way. A lane that silently times the full sequence while
  # its siblings time a deferred one produces ratios that divide different
  # work, and the only trace is a visit count nobody reads. Three runs were
  # spent on exactly that, unable to tell "the flag never arrived" from "the
  # flag arrived and matched nothing" -- one line of log distinguishes them.
  if path.nil? || path.empty?
    $stderr.puts "deferral: no --defer given; timing the FULL sequence"
    return []
  end
  abort "deferred ledger not found at #{path.inspect}" unless File.exist?(path)
  routes = (JSON.parse(File.read(path))["declared_gaps"] || []).map { |g| g["route"] }
  $stderr.puts "deferral: #{path} -> #{routes.size} route(s): #{routes.join(", ")}"
  routes
end

def drop_deferred(visits, deferred, label = "sequence")
  return [visits, 0] if deferred.empty?
  kept = visits.reject { |v| deferred.include?(route_template(v["path"])) }
  dropped = visits.size - kept.size
  unmatched = deferred.reject { |t| visits.any? { |v| route_template(v["path"]) == t } }
  unless unmatched.empty?
    abort "deferred route(s) #{unmatched.join(", ")} match no visit in the #{label}"
  end
  [kept, dropped]
end

visits, DEFERRED_VISITS = drop_deferred(visits, load_deferred(opts[:defer]))
File.write(seq_file, visits.map { |v| "#{v['method']} #{v['path']}" }.join("\n"))

dump = opts[:dump] || File.join(work, "bodies")
FileUtils.mkdir_p(dump)

# ── run ──────────────────────────────────────────────────────────────
out_path = File.join(work, "driver-out.txt")
err_path = File.join(work, "driver-err.txt")

# THE SHAPE THE OTHER LANES RUN. Every interpreted lane serves
# `file:lobsters_bench?mode=memory&cache=shared` seeded from the fixture, which
# is what the ruby-bench lobsters benchmark measures; this lane served the
# staged FILE, and paid ~400 `pread64` syscalls per query-heavy request that the
# lanes it is charted against did not. That is not a small correction — /top
# profiled at 75% inside libsqlite3 and under 6% in compiled code, so the
# AOT-vs-CRuby gap on query-heavy routes was mostly this asymmetry being read as
# the compiler being slower.
#
# Same URI string as scripts/lobsters-replay's MEM_URI, and for the same
# reason: a NAMED shared-cache database, because Db.configure opens a POOL of
# connections and plain ":memory:" would give each its own empty one. The
# fixture rides in as the driver's SEED argument, page-copied over the schema
# DDL boot just created.
MEM_URI = "file:lobsters_bench?mode=memory&cache=shared"
env = { "BLOG_DB" => MEM_URI }

# NO RETRY. The binary crashes intermittently (observed: 1 of 3 identical
# invocations succeeded, the others died on SIGBUS) — the shape of
# matz/spinel#3396, a GC sweep freeing a live string. That is a real defect,
# so a retry would be a lie: it would turn a two-in-three crash rate into an
# occasional green run and hide the very thing worth reporting. A crashed
# lane is reported as a crashed lane.
ok = system(env, BIN, "--bench", routes_file, seq_file, dump,
            opts[:warmup].to_s, opts[:time].to_s, opts[:min_time].to_s, DB,
            chdir: TREE, out: out_path, err: err_path)
raw = (File.read(out_path) rescue "")
unless ok
  err = (File.read(err_path) rescue "")
  sig = $?&.termsig
  detail = sig ? "binary terminated by signal #{sig}" : "exit #{$?&.exitstatus}"
  die("replay", detail, err.lines.last(8).join + raw.lines.last(4).join)
end
if (bad = raw.lines.find { |l| l.start_with?("LOGINFAIL") })
  die("replay", bad.strip)
end




# The dumped body's file name for a route. Mirrors the compiled driver's
# `safe_name` character for character: content parity is keyed by it, and a
# lane that spells it differently drops out of the join silently.
def body_name(route)
  route.delete_prefix("/").gsub(/[^\w.-]/, "_")
end


# samples: { template => [ms, …] } -> { template => {ms_median, n, …} }.
# Same shape and rounding as the CRuby lane's summarize_samples.
def summarize_samples(by_route)
  by_route.sort.to_h.transform_values do |arr|
    s = arr.sort
    m = s.size / 2
    med = s.size.odd? ? s[m] : (s[m - 1] + s[m]) / 2.0
    # ms_p25 is the OWN-WORK estimate: a low percentile of this route's own
    # visits, i.e. the ones where no collection happened to land inside the
    # timing window. The median includes whatever cleanup fired during the
    # visit regardless of whose garbage it reclaimed, and because collection
    # arrival is roughly uniform while its cost is heap-proportional and
    # route-independent, that bias scales as 1/own-cost: measured on lobsters
    # it inflates the cheapest routes by >100% and the most expensive by 1%.
    # Named for the percentile rather than called "own" so the estimator's
    # one free choice stays visible in the data.
    { "ms_median" => med.round(3), "ms_min" => s.first.round(3),
      "ms_p25" => s[(0.25 * s.size).floor.clamp(0, s.size - 1)].round(3),
      "ms_max" => s.last.round(3), "n" => s.size }
  end
end

routes, seq_fails, iters = [], [], []
visits_per_iter = visits.size
warmup_used = opts[:warmup]
rss_boot = rss_final = rss_peak = nil
sqlite_version = nil
by_template = Hash.new { |h, k| h[k] = [] }
raw.each_line do |line|
  f = line.split(" ")
  case f[0]
  when "PARITY"
    # route status bytes ms — route never contains a space.
    routes << { "route" => f[1], "status" => f[2].to_i, "bytes" => f[3].to_i,
                "ms" => f[4].to_f.round(2), "ok" => f[2].to_i == 200,
                "thin" => f[2].to_i == 200 && f[3].to_i < 200,
                # Join keys — see the note in scripts/lobsters-replay.
                # Content parity is keyed by the dumped body's file name,
                # the timing tables by the route template, and only the raw
                # path they are both made from can produce the pair.
                "body" => body_name(f[1].to_s),
                "template" => route_template(f[1].to_s) }
  when "PARITYERR"
    if (r = routes.find { |x| x["route"] == f[1] })
      r["error"] = line.split(" ", 3)[2].to_s.strip[0, 300]
    end
  when "SEQFAIL"
    seq_fails << { "idx" => f[1].to_i, "status" => f[2].to_i, "path" => f[3..].join(" ").strip }
  when "ITER" then iters << f[1].to_f
  when "V"
    # V <path> <ms>… — every timed visit of one path. Merged under the
    # template, so several concrete paths sharing a template pool their
    # samples and the median is taken over the pool, not over medians.
    by_template[route_template(f[1].to_s)].concat(f[2..].map(&:to_f))
  when "SQLITE" then sqlite_version = f[1]
  when "RSS"
    # boot final peak, in kB, read by the binary from its own
    # /proc/self/status. 0 is the driver's "no /proc here" — carry it as
    # null so the page shows a gap rather than a zero-byte process.
    rss_boot  = f[1].to_i.nonzero?
    rss_final = f[2].to_i.nonzero?
    rss_peak  = f[3].to_i.nonzero?
  when "DONE"
    visits_per_iter = f[1].to_i
    warmup_used = f[2].to_i
  end
end
die("replay", "driver produced no parity rows") if routes.empty?
die("replay", "driver produced no timed iterations") if iters.empty?

sorted = iters.sort
mid = sorted.size / 2
median = sorted.size.odd? ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2.0
# The mean is ruby-bench's reported statistic ("Average of last N,
# non-warmup iters"); the median stays as a robustness cross-check.
mean = iters.sum / iters.size
fails = routes.reject { |r| r["ok"] }

summary = {
  "generated_at" => Time.now.utc.to_s,
  "stack"        => "spinel",
  # What was SERVED, and what it was seeded from. `memory` is the flag the
  # report and the trust banner read to decide whether this lane ran the same
  # database shape as the lanes beside it; it was false, and the page said so
  # rather than implying parity. It is now true because the shape changed, not
  # because the caveat became inconvenient.
  "db"           => MEM_URI,
  # The SQLite build the binary itself reported (`select sqlite_version()`
  # through its own linked library) — see the SQLITE line in the driver.
  # The interpreted lanes record theirs the same way; the report compares.
  "sqlite"       => sqlite_version,
  "seeded_from"  => DB,
  "memory"       => true,
  "story_id"     => STORY,
  "comment_id"   => COMMENT,
  "total"        => routes.size,
  "pass"         => routes.size - fails.size,
  "thin"         => routes.count { |r| r["thin"] },
  "routes"       => routes,
  # Same key the CRuby/JRuby lanes use, so the aggregator, the trust
  # banner and the report need no spinel-specific branch.
  "sequence_timing" => {
    "sequence"           => opts[:sequence],
    "visits_per_iter"    => visits_per_iter,
    "warmup"             => warmup_used,
    "iterations"         => iters.size,
    "ms_per_iter_mean"   => mean.round(2),
    "ms_per_iter_median" => median.round(2),
    "ms_per_iter_min"    => sorted.first.round(2),
    "ms_per_iter_max"    => sorted.last.round(2),
    "iter_ms"            => iters.map { |x| x.round(2) },
    "per_route"          => summarize_samples(by_template),
    "failed_visits"      => seq_fails.size,
    "partial"            => !seq_fails.empty?,
  },
  # Same shape scripts/lobsters-replay emits, so bench-lobsters flattens it
  # to rss_boot_kb/rss_final_kb/rss_peak_kb with no spinel-specific branch
  # and the report's memory section picks the lane up unchanged. Measured by
  # the BINARY from its own /proc/self/status, not by this wrapper sampling a
  # child: same source and same statistic as the other lanes, so the bars
  # compare like with like. `engine` is "spinel" rather than a RUBY_ENGINE
  # because the numbers describe the compiled binary. nil off Linux — the
  # peak is never guessed from a current-RSS reading.
  "rss" => { "boot_kb" => rss_boot, "final_kb" => rss_final,
             "peak_kb" => rss_peak, "engine" => "spinel" },
  # AOT facts the interpreted lanes have no analogue for. Compile time is
  # real work this lane does that the others don't; it belongs on the page
  # rather than folded into (or hidden from) ms/iter.
  "aot" => { "build_seconds" => BUILD_SECONDS, "c_warnings" => C_WARNINGS,
             "spinel_warnings" => SPINEL_WARNINGS,
             "binary_bytes" => (File.size(BIN) rescue nil),
             "spinel" => SPINEL_VERSION, "cc" => CC_VERSION },
}
summary["sequence_failures"] = seq_fails unless seq_fails.empty?

File.write(opts[:json], JSON.pretty_generate(summary))
if opts[:md]
  md = +"# Lobsters spinel lane\n\n_#{summary['pass']}/#{summary['total']} routes return 200_\n\n"
  md << "| route | status | bytes | ms |\n|-------|-------:|------:|---:|\n"
  routes.each { |r| md << "| `#{r['route']}` | #{r['ok'] ? r['status'] : "**#{r['status']}**"} | #{r['bytes']} | #{r['ms']} |\n" }
  md << "\n#{median.round(2)} ms/iter median over #{iters.size} iterations of #{visits_per_iter} visits"
  md << " (#{seq_fails.size} failing visits — PARTIAL)" unless seq_fails.empty?
  md << "\n"
  File.write(opts[:md], md)
end

puts "spinel: #{summary['pass']}/#{summary['total']} routes 200, " \
     "#{mean.round(2)} ms/iter (avg) over #{iters.size} iters" \
     "#{seq_fails.empty? ? '' : " (PARTIAL: #{seq_fails.size}/#{visits_per_iter} failing visits)"}"
exit [fails.size, 99].min
