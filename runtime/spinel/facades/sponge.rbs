# Typing contract for the Sponge façade (see sponge.rb beside this
# file). Returns are the real shapes consumers chain on; every body
# raises via GemFacade.fail! before its unreachable typed tail.
class Sponge
  MAX_TIME: Integer
  MAX_DNS_TIME: Integer

  class Response
    def body: () -> String
    def code: () -> String
    def []: (String _name) -> String
  end

  attr_reader debug: bool
  attr_writer debug: bool
  attr_reader last_res: untyped
  attr_writer last_res: untyped
  attr_reader timeout: Integer
  attr_writer timeout: Integer
  attr_reader ssl_verify: bool
  attr_writer ssl_verify: bool

  def self.fetch: (String url, ?untyped headers, ?Integer limit) -> Sponge::Response
  def initialize: () -> void
  def set_cookie: (String host, String name, String val) -> void
  def cookies: (String host) -> String
  def fetch: (String url, ?untyped method, ?untyped fields, ?untyped raw_post_data, ?untyped headers, ?Integer limit) -> Sponge::Response
  def get: (String url) -> Sponge::Response
  def post: (String url, untyped fields) -> Sponge::Response
end

module OpenSSL
  module RandomSource
    def self.random_bytes: (Integer n) -> String
  end

  # `sponge.rb` closes with `Random = RandomSource` — the implementation
  # module cannot BE named Random (spinel#2455: it collides with the
  # builtin PRNG's C typedef), so the name app code calls is a constant
  # alias. RBS here has no alias form and our parser has no case for one,
  # so the signature is declared under both names rather than inherited
  # through the alias.
  #
  # This is load-bearing, not tidiness. Lobsters reaches entropy as
  # `OpenSSL::Random.random_bytes(1)`; with only RandomSource declared
  # that call typed untyped, which widened `str` in `Utils.random_str`,
  # which made `CandidateId#to_s` untyped, which put a
  # `def to_s: () -> untyped` in the program — and one of those widens
  # every poly `.to_s` (matz/spinel#4090). Ten links later the cookie
  # jar's `@inbound[k.to_s] = v` had untyped KEYS and the C build stopped
  # on a PolyPolyHash reaching a Hash[String, String] slot.
  module Random
    def self.random_bytes: (Integer n) -> String
  end
end
