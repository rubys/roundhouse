require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs << "test"
  # Not "runtime": its logger.rb, zlib.rb and timeout.rb would answer a gem's `require "logger"` in place of Ruby's own.
  t.libs << "app"
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = false
end

task :lint do
  ruby "tools/check_spinel_subset.rb"
end

task default: [:test, :lint]
