# Pins @seconds (and every unit constructor's n) to real numbers so the
# temporal arithmetic in ago/from_now stays Time-typed under AOT
# inference — an untyped @seconds widens `Time.now.utc - @seconds` to
# poly, which the declared Time return then contradicts.
module ActiveSupport
  class Duration
    @seconds: (Integer | Float)

    def initialize: ((Integer | Float) seconds) -> void
    def self.time_operand: (untyped value) -> untyped
    def self.seconds: ((Integer | Float) n) -> Duration
    def self.second: ((Integer | Float) n) -> Duration
    def self.minutes: ((Integer | Float) n) -> Duration
    def self.minute: ((Integer | Float) n) -> Duration
    def self.hours: ((Integer | Float) n) -> Duration
    def self.hour: ((Integer | Float) n) -> Duration
    def self.days: ((Integer | Float) n) -> Duration
    def self.day: ((Integer | Float) n) -> Duration
    def self.weeks: ((Integer | Float) n) -> Duration
    def self.week: ((Integer | Float) n) -> Duration
    def self.fortnights: ((Integer | Float) n) -> Duration
    def self.fortnight: ((Integer | Float) n) -> Duration
    def self.months: ((Integer | Float) n) -> Duration
    def self.month: ((Integer | Float) n) -> Duration
    def self.years: ((Integer | Float) n) -> Duration
    def self.year: ((Integer | Float) n) -> Duration
    def ago: () -> Time
    def until: () -> Time
    def from_now: () -> Time
    def since: () -> Time
    def to_i: () -> Integer
    def to_f: () -> Float
    def zero?: () -> bool
    def positive?: () -> bool
    def negative?: () -> bool
    def to_s: () -> String
    def seconds: () -> (Integer | Float)
    def value: () -> (Integer | Float)
    def ==: (untyped other) -> bool
    def <=>: (untyped other) -> (Integer | nil)
    def coerce: (untyped other) -> Array[untyped]
    def <: (untyped other) -> bool
    def <=: (untyped other) -> bool
    def >: (untyped other) -> bool
    def >=: (untyped other) -> bool
  end
end
