# Typing for runtime/spinel/digest_md5.rb — Digest::MD5 for the
# compiled family (spinel's digest package binds SHA-256 and SHA-1 only).
module Digest
  module MD5
    S: Array[Integer]
    K: Array[Integer]
    def self.rotl: (Integer x, Integer c) -> Integer
    def self.words: (String data, Integer at) -> Array[Integer]
    def self.digest: (String message) -> String
    def self.hexdigest: (String message) -> String
    def self.base64digest: (String message) -> String
  end
end
