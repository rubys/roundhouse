# Typing contract for the RQRCode raising façade (rqrcode_facade.rb
# beside this file). Dropped alongside the façade when the spin-shaped
# spinel tree swaps in the real rqrcode package (its surface is
# inferred from the package source).
module RQRCode
  class QRCode
    @data: String

    def initialize: (String _data) -> void
    def as_svg: (?offset: Integer, ?fill: untyped, ?color: untyped, ?module_size: Integer?, ?shape_rendering: String?, ?viewbox: bool) -> String
  end
end
