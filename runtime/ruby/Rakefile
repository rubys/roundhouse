# Framework Ruby unit-test runner.
#
# Usage:
#   rake -f runtime/ruby/Rakefile test
#   ruby runtime/ruby/test/active_record/<thing>_test.rb   # one file
#
# Tests run under stock CRuby — no spinel, no transpile, no app
# fixture. Sweeps `runtime/ruby/test/**/*_test.rb` and runs them
# as a single Minitest process; fast feedback for framework-source
# changes. CI gates this before any target's transpile.

require "rake/testtask"

# Gem-backed Rails 8.1.4 inflector differential. It needs the real
# `I18n.load_path` before the runtime shim is defined, so it cannot
# share a process with the rest of the suite.
INFLECTIONS = "test/active_support_inflections_test.rb"

Rake::TestTask.new(:framework_test_suite) do |t|
  t.libs << "."
  t.libs << "test"
  t.test_files = FileList["test/**/*_test.rb"].exclude(INFLECTIONS)
  t.warning = false
  t.verbose = false
end

task :active_support_inflections do
  # `-Itest` only: `-I.` would put the runtime I18n shim ahead of the gem.
  ruby "-Itest", INFLECTIONS
end

task test: [:framework_test_suite, :active_support_inflections]
task default: :test
