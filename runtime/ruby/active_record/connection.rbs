# Typing contract for the raw-SQL connection facade. Rows are
# Hash[String, untyped] by design — raw SQL's row shape (aliased
# aggregates, computed columns) is genuinely dynamic; see connection.rb.
module ActiveRecord
  class IntegerKeyCast
    @valid: bool
    @value: Integer
    def valid: () -> bool
    def value: () -> Integer
    def initialize: (bool valid, Integer value) -> void
    def self.input_text: (Integer | Float | String | nil id) -> String
    def self.parse: (Integer | Float | String | nil id) -> ::ActiveRecord::IntegerKeyCast
    def self.number_start: (String text) -> Integer
    def self.digit_value: (String char) -> Integer
    def self.exceeds_limit: (String digits, String limit) -> bool
  end

  class Result
    @rows: Array[Hash[String, untyped]]

    def initialize: (Array[Hash[String, untyped]] rows) -> void
    def rows: () -> Array[Hash[String, untyped]]
    def to_a: () -> Array[Hash[String, untyped]]
    def first: () -> Hash[String, untyped]?
    def each: () { (Hash[String, untyped]) -> void } -> Array[Hash[String, untyped]]
  end

  class Connection
    def adapter_name: () -> String
    def quote: (String | Symbol | Integer | Float | bool | nil value) -> String
    def quote_string: (String str) -> String
    def execute: (String sql) -> Result
    def select_rows: (String sql) -> Array[Array[untyped]]
    def select_value: (String sql) -> untyped
    def exec_query: (String sql) -> Result
    def select_all: (String sql) -> Result
    def exec_update: (String sql, ?String? name, ?Array[String | Integer | Float | bool | nil] binds) -> Integer
    def exec_delete: (String sql, ?String? name, ?Array[String | Integer | Float | bool | nil] binds) -> Integer
    def exec_insert: (String sql, ?String? name, ?Array[String | Integer | Float | bool | nil] binds) -> Result
  end

  class Base
    @__pending_preload: PendingPreload?
    def _pend_preload: (PendingPreload pending) -> nil
    def _await_preload: () -> nil
    # Request values stay intact until the schema-selected scalar adapter.
    def self.find: (Integer | Float | String | nil id) -> Base
    def self.find_by!: (Hash[String | Symbol, untyped] conditions) -> Base
    def self._find_primary_key_input: (Integer | Float | String | nil id) -> Base?
    def self._cast_primary_key: (Integer | Float | String | nil id) -> (Integer | String | nil)
    def self.connection: () -> Connection
    def self.sanitize_sql: (Array[untyped] statement) -> String
    def self.sanitize_sql_array: (Array[untyped] statement) -> String
    def self.uncached: () { () -> untyped } -> untyped
    def self.transaction: (?isolation: untyped, ?requires_new: untyped, ?joinable: bool) { () -> untyped } -> untyped
    def with_lock: (?(bool | String)? lock, ?isolation: untyped, ?requires_new: untyped, ?joinable: bool) { () -> untyped } -> untyped
    def self.delete_all: () -> Integer
    def self.update_counters: (Integer | String id, Hash[Symbol, untyped] counters) -> Integer
    def self.upsert: (Hash[Symbol, untyped] attrs, ?unique_by: (String | Symbol | Array[Symbol]), ?on_duplicate: String?, ?returning: untyped) -> Integer
    def self._conflict_predicate: (String columns) -> String
    def self.upsert_all: (Array[Hash[Symbol, untyped]] rows, ?unique_by: (String | Symbol | Array[Symbol]), ?on_duplicate: String?, ?returning: untyped) -> Integer
    def self.record_timestamps=: (bool value) -> bool
    def self.record_timestamps: () -> bool
    def update_column: (String | Symbol name, untyped value) -> bool
    def _as_json_only: (Array[Symbol] only) -> Hash[String, untyped]
    # Nil and uncastable request keys reject before the scalar adapter.
    def self.exists?: (Integer | Float | String | nil id) -> bool
    def self._exists_primary_key_input: (Integer | Float | String | nil id) -> bool
    # Ruby-family overrides of base.rb's Array / COUNT fallbacks.
    def self.where: (Hash[Symbol, untyped] conditions) -> Relation
    def self.find_by: (Hash[String | Symbol, untyped] conditions) -> Base?
    def self.find_sole_by: (Hash[String | Symbol, untyped] conditions) -> Base
    def self.sole: () -> Base
    def self.all: () -> Relation
    def self.none: () -> Relation
    def self.page: (?(Integer | String | nil) num) -> Relation
    def self.in_batches: (?of: Integer, ?order: Symbol?) ?{ (Relation) -> void } -> Relation
    def self.paginate: (?(Integer | String | nil) num, ?page: (Integer | String | nil), ?per_page: (Integer | String | nil)) -> Relation
    def self.any?: () -> bool
    def self.none?: () -> bool
    def _note_hydrated: () -> void
    def _note_unloaded: (Hash[String, untyped] row) -> nil
    def has_attribute?: (Symbol name) -> bool
    def attribute_previously_was: (String name) -> untyped
    def self.first: () -> Base?
    def self.take: () -> Base?
    def self._hydrate_all: (String sql) -> Array[Base]
    def update_attribute: (Symbol name, untyped value) -> bool
    # Ruby-family overrides of base.rb's dirty-tracking stubs.
    def __track_saved_changes: (bool was_new) -> void
    def saved_changes: () -> Hash[String, untyped]
    def changes_to_save: () -> Hash[String, untyped]
    def attribute_was: (String name) -> untyped
  end
end
