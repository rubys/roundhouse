module ActiveRecord
  # Lazy chainable query builder. Chain methods return `self` (typed as
  # Relation); terminals execute and return rows / scalars. The element
  # type is `untyped` in v1 — the lowered model methods carry the model
  # identity; per-element typing is a later (generic-Relation) refinement.
  class Relation
    # Model handle is `Base` (class object collapsed onto `Ty::Class{Base}`
    # in send.rs). Do not spell `Class` — that leaves `@model` as Ty::Var
    # and breaks Bar A.
    def initialize: (Base model) -> void

    def where: (?untyped condition, *untyped args) -> Relation

    # Query ivars the body reads after builders write them. Declared so
    # probes / RBS-seeded typing do not freeze on `initialize`'s `nil`
    # assignment (first-write harvest) and leave `page` / `current_page`
    # / loaded Enumerable terminals as Ty::Var.
    @limit: Integer?
    @offset: Integer?
    @records: Array[untyped]?

    @from: String?
    @ctes: Array[String]
    def with_recursive: (Hash[Symbol, Array[Relation]] ctes) -> Relation
    def from: (String source) -> Relation
    def cte_prefix: () -> String
    def from_source: () -> String

    # The association scope (`where_scope`) and what it presets on a
    # create (`scope_attributes`). The ivar is declared as well as the
    # reader: a consumer that only reads signatures would otherwise seed
    # it from the bare `{}` in `initialize`, which carries no element
    # type — the same trap `Base`'s `@errors` documents.
    @scope_attributes: Hash[Symbol, untyped]
    def where_scope: (Hash[Symbol, untyped] condition) -> Relation
    def scope_attributes: () -> Hash[Symbol, untyped]
    def not: (?untyped condition, *untyped args) -> Relation
    def excluding: (*untyped records) -> Relation
    def without: (*untyped records) -> Relation
    def or: (Relation other) -> Relation
    def add_condition: (untyped condition, Array[untyped] args, bool negate) -> bool
    def order: (*untyped parts) -> Relation
    # The in-memory sort `order` applies to a LOADED relation (see the
    # .rb). Element type stays untyped until Relation[T]; the array
    # representation is honest — only index/length/map appear here
    # (unlike `preloaded`, which must stay bare for Spinel integer seeds).
    def sort_in_place!: (Array[untyped] sorted, Array[String] terms) -> bool
    def order_column: (String term) -> String?
    def order_descending?: (String term) -> bool
    def reverse_order_term: (String term) -> String
    def reverse_one_order_term: (String term) -> String
    def loaded_tail: (Array[untyped] loaded, Integer n) -> Array[untyped]
    # The keys are whatever the ordered column holds, and `<=>` on two
    # of them is an Integer or nil -- the only honest spellings.
    def compare_order_keys: (untyped a, untyped b) -> Integer?
    def order_key_of: (Base record, String col) -> untyped
    def where!: (?untyped condition, *untyped args) -> Relation
    def order!: (*untyped parts) -> Relation
    def reorder: (*untyped parts) -> Relation
    def limit: (Integer n) -> Relation
    def offset: (Integer n) -> Relation
    # Kaminari's pagination surface (see the .rb): `page` / `per` take
    # whatever the request handed over (a params String, an Integer or
    # nil) and read it through `to_s`.
    def page: (?untyped num) -> Relation
    def per: (untyped num) -> Relation
    def limit_value: () -> Integer?
    def offset_value: () -> Integer?
    def current_page: () -> Integer
    def total_count: () -> Integer
    def total_pages: () -> Integer
    def first_page?: () -> bool
    def last_page?: () -> bool
    def out_of_range?: () -> bool
    def next_page: () -> Integer?
    def prev_page: () -> Integer?
    def group: (*untyped parts) -> Relation
    def having: (untyped condition, *untyped args) -> Relation
    def joins: (untyped spec) -> Relation
    def join_fragment: (untyped spec) -> String
    def left_outer_joins: (untyped spec) -> Relation
    def left_joins: (untyped spec) -> Relation
    # Two methods sharing a name: field args PROJECT columns and keep
    # the Relation; a block is Enumerable's filter over the loaded
    # records and answers an Array (zero args means the block form —
    # see the body). Declared as the PROJECTION form only: the sidecar
    # parser takes one signature per method, and every strict-target
    # call site in the corpus is the projection. `filter` below is the
    # same method under Ruby's other name and DOES declare the block
    # shape, so a strict target that needs it has a spelling.
    def select: (*untyped specs) -> Relation
    def distinct: () -> Relation
    def includes: (*untyped names) -> Relation
    def preload: (*untyped names) -> Relation
    def eager_load: (*untyped names) -> Relation
    def skip_preloading!: () -> Relation
    def preload_associations: (Array[untyped] records) -> Array[untyped]
    def references: (*untyped names) -> Relation
    def merge: (Relation other) -> Relation
    def where_clauses: () -> Array[String]
    def arel: () -> Arel::SelectManager
    def none: () -> Relation
    def reload: () -> Relation
    def load: () -> Relation
    def load_async: () -> Relation
    # `records` is `untyped`, NOT `Array[untyped]`: the body only stores
    # the argument (`@records = records if loaded`), so it does not care
    # about the array's REPRESENTATION — and that is all
    # `Array[untyped]` claims. A seed spinel trusts, so a caller holding
    # an `Array[Integer]` contradicts it: campfire's
    # `User#reachable_messages` passes `@reachable_messages_cache`,
    # seeded `[]` in the constructor and therefore inferred as an int
    # array. Same over-claim as `map`/`collect` below.
    def preloaded: (untyped records, bool loaded) -> Relation
    def klass: () -> Class

    def to_a: () -> Array[untyped]
    def load_records: () -> Array[untyped]
    def loaded_records: () -> Array[untyped]
    def to_set: () -> Set[untyped]
    def to_ary: () -> Array[untyped]
    def ==: (untyped other) -> bool
    def filter: () { (untyped) -> bool } -> Array[untyped]
    def map: () { (untyped) -> untyped } -> untyped
    def collect: () { (untyped) -> untyped } -> untyped
    # `other` is `untyped`, NOT `Array[untyped]`, on all four set
    # operators: each body only hands the argument on to Array's own
    # operator (`to_a + other`), so it does not care about the array's
    # REPRESENTATION — and that is all `Array[untyped]` claims. spinel
    # trusts the seed, and lobsters' `Story#merged_comments` passes
    # `[self.id]`, an `Array[Integer]`, which contradicted it and held
    # the AOT lane at the seed check from 2026-08-30. Same over-claim as
    # `preloaded` above and `map`/`collect` below.
    def +: (untyped other) -> Array[untyped]
    def &: (untyped other) -> Array[untyped]
    def |: (untyped other) -> Array[untyped]
    def -: (untyped other) -> Array[untyped]
    def set_operand: (untyped other) -> Array[untyped]
    def operand_ids: (untyped other) -> Array[untyped]
    def ids_of: (Array[untyped] records) -> Array[untyped]
    def id_filter: (Array[untyped] records, Array[untyped] ids, bool keep) -> Array[untyped]
    def include?: (Base record) -> bool
    def each: () { (untyped) -> void } -> Relation
    def index_by: () { (untyped) -> untyped } -> Hash[untyped, untyped]
    def find_each: () { (untyped) -> void } -> Relation
    # `map`/`collect` return `untyped`, NOT `Array[untyped]`: the result's
    # element type is whatever the BLOCK returns, which this RBS has no
    # type variable to say. `Array[untyped]` is a seed spinel TRUSTS, so
    # it declared the receiving local `sp_PolyArray *` while the inlined
    # body built an `sp_IntArray *` for `{ |a| a.id }` — and the C build
    # stopped with no diagnostic naming the seed. The two agreed only for
    # as long as every id was boxed. Widen to `untyped` so the body
    # decides the shape; `Array[U]` waits on Relation[T].
    def group_by: () { (untyped) -> untyped } -> Hash[untyped, Array[untyped]]
    def partition: () { (untyped) -> bool } -> Array[Array[untyped]]
    def detect: () { (untyped) -> bool } -> untyped
    def sort_by: () { (untyped) -> untyped } -> Array[untyped]
    def inject: (untyped initial) { (untyped, untyped) -> untyped } -> untyped
    def each_with_object: (untyped memo) { (untyped, untyped) -> untyped } -> untyped
    def first: () -> Base?
    def take: () -> Base?
    def first!: () -> Base
    def last: () -> Base?
    def first_n: (Integer n) -> Array[untyped]
    def last_n: (Integer n) -> Array[untyped]
    def count: () -> Integer
    def sum: (untyped expr) -> Float
    def group_count: () -> Hash[untyped, Integer]
    def empty?: () -> bool
    def any?: () -> bool
    def blank?: () -> bool
    def present?: () -> bool
    def presence: () -> Relation?
    def none?: () -> bool
    def one?: () -> bool
    def many?: () -> bool
    def all?: () { (untyped) -> bool } -> bool
    def exists?: (?Integer? id) -> bool
    def probe_existence: (Integer n) -> Integer
    def more_than?: (Integer n) -> bool
    def length: () -> Integer
    def size: () -> Integer
    def delete_all: () -> Integer
    def destroy_all: () -> Array[untyped]
    def destroy_by: (untyped conditions) -> Array[untyped]
    def delete_by: (untyped conditions) -> Integer
    def update_all: (untyped updates) -> Integer
    def touch_all: (?Symbol? name) -> Integer
    # The WHERE a bulk write takes — a plain clause, or an
    # `IN (SELECT …)` subquery when the scope carries a join.
    def scoped_write_where: () -> String
    # `pluck`/`pick` hand back whatever the COLUMN holds — Integer for an
    # INTEGER column, Float for REAL, String for TEXT, nil for NULL —
    # because they read straight through `select_rows` without a cast.
    # Pinning these to String used to be harmless: the spinel FFI shim
    # returned everything as text anyway, so the seed and the runtime
    # agreed. Once `Db.column_value` began answering the native-type
    # contract the other shims already met, the String pin became the
    # thing FORCING the coercion back — `pluck(:thread_id)` handed back
    # `"19948"` where the model attribute held `19948`, and every Hash
    # lookup between them missed (lobsters /threads).
    #
    # `untyped` is the honest type at this level: the column's type is
    # not knowable from `Relation`. Typing it precisely means the
    # lowerer monomorphizing per call site from the schema.
    # `ids` is Array[Integer] for integer-key apps; string/uuid apps
    # widen it via `project::widen_key_contract` (#310).
    def pluck: (untyped col) -> Array[untyped]
    def pick: (untyped col) -> untyped
    def ids: () -> Array[Integer]
    def find: (Integer | String | Array[Integer | String] id) -> untyped
    def find_ids: (Array[Integer | String] ids) -> Array[untyped]
    def find_by: (untyped conditions) -> Base?
    def find_by!: (untyped conditions) -> Base
    def first_or_initialize: () -> Base
    def find_or_create_by: (Hash[Symbol, untyped] conditions) -> Base

    def to_sql: () -> String
    def to_subquery_sql: () -> String
    def select_sql_with: (String default_cols) -> String
    def count_sql: () -> String
    def exists_sql: (Integer n) -> String
    def hash_conditions: (untyped hash) -> String
    def column_predicate: (String col, untyped val) -> String
    def substitute_binds: (String sql, Array[untyped] args) -> String
    def substitute_named_binds: (String sql, Hash[Symbol, untyped] binds) -> String
    def named_bind_start?: (String ch) -> bool
    def named_bind_char?: (String ch) -> bool
    def escape_list: (Array[untyped] vals) -> String
    def order_term: (untyped p) -> String
  end
end
