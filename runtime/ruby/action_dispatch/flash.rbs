module ActionDispatch
  # Per-app flash store with typed `notice`/`alert` fields plus HWIA-
  # shape shim methods. Field-set is closed (mirrors the lowerer's
  # `is_flash_name`); shim keys are String | Symbol.
  class Flash
    @notice: String?
    @alert: String?
    # Snapshot of the values loaded from the previous request; the
    # `to_persisted` sweep carries forward only entries that differ.
    @notice_was: String?
    @alert_was: String?

    # `attr_accessor :notice, :alert` — getter+setter pair per name.
    def notice: () -> String?
    def notice=: (String?) -> String?
    def alert: () -> String?
    def alert=: (String?) -> String?
    # `attr_reader :notice_was, :alert_was` — getters only.
    def notice_was: () -> String?
    def alert_was: () -> String?

    def initialize: (?Hash[String, String]? other) -> void

    def now: () -> FlashNow
    def mark_shown: (String | Symbol key) -> void
    def []: (String | Symbol key) -> String?
    def []=: (String | Symbol key, String? value) -> String?
    def fetch: (String | Symbol key, ?String? default) -> String?
    def key?: (String | Symbol key) -> bool
    def has_key?: (String | Symbol key) -> bool
    def include?: (String | Symbol key) -> bool
    def delete: (String | Symbol key) -> String?
    def length: () -> Integer
    def size: () -> Integer
    def empty?: () -> bool
    def keys: () -> Array[String]
    def values: () -> Array[String]
    def each: () { (String, String?) -> void } -> Flash
    def to_h: () -> Hash[String, String]
    def to_persisted: () -> Hash[String, String]
    def merge: (Hash[String, String] other) -> Flash
  end

  # `flash.now` — writes through to the Flash and marks the key shown,
  # so `to_persisted` drops it.
  class FlashNow
    @flash: Flash

    def initialize: (Flash flash) -> void
    def []=: (String | Symbol key, String? value) -> String?
    def []: (String | Symbol key) -> String?
  end
end
