module ActiveSupport
  def self.underscore: (String text) -> String
  # Literal substring delete — one pattern (String#remove multi-arg
  # stays dynamic; lowering grounds only the single-arg form).
  def self.remove: (String text, String pattern) -> String
  def self.demodulize: (String text) -> String
  # Regular-suffix singularize only (see runtime body).
  def self.singularize: (String text) -> String
  def self.humanize: (String? text) -> String
  def self.titleize: (String? text) -> String

  module Inflector
    # Default Rails 8.1.4 behavior without configured acronym tables.
    def self.camelize: (String text, ?bool uppercase_first_letter) -> String
    def self.deconstantize: (String text) -> String
    def self.foreign_key: (String class_name, ?bool separate_class_name_and_id_with_underscore) -> String
    def self.upcase_first: (String text) -> String
    def self.downcase_first: (String text) -> String
    # Rails default integer ordinal suffix; no locale/configuration table.
    def self.ordinalize: (Integer number) -> String
  end
end
