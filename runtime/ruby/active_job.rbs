module ActiveJob
  PERFORMED: Array[String]
  def self.record_performed: (String job_name) -> nil
  def self.performed: () -> Array[String]

  ENQUEUE_ONLY: Array[String]
  # `untyped` rather than `^() -> nil`: the RBS reader does not
  # support ProcType yet, and a Proc is opaque to this analyzer anyway.
  PENDING: Array[untyped]
  DRAINED: Array[String]
  def self.enqueue_only: () -> bool
  def self.enqueue_without_running: () -> nil
  def self.run_enqueued: () -> nil
  def self.drain_registered: () -> bool
  def self.register_drain: () -> nil
  def self.enqueue: (untyped work) -> nil
  def self.pending_count: () -> Integer
  def self.drain: () -> Integer

  class Base
    def self.queue_as: (?Symbol? name) -> nil
    def self.enqueue_after_transaction_commit=: (bool value) -> nil
    def self.retry_on: (untyped error, ?untyped? opts) -> nil
    def self.discard_on: (untyped error) -> nil
  end
end
