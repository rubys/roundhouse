# Typing contract for active_storage.rb beside this file.
#
# `attached?` is the one question this half of Active Storage can
# answer; the rest raise (see the body for why).
module ActiveStorage
  class Attached
    @record_type: String
    @record_id: Integer
    @name: String
    # The remembered attachment row: `attachment_id` 0 = nothing attached.
    @row_loaded: bool
    @attachment_id: Integer
    @blob_filename: String
    @blob_content_type: String
    def initialize: (String record_type, Integer record_id, String name) -> void
    def load_row: () -> nil
    def _preload_row: (Integer attachment_id, String filename, String content_type) -> nil
    def attached?: () -> bool
    def variable?: () -> bool
    def variant: (untyped transformations) -> untyped
    def url: () -> String
    def filename: () -> String?
    def content_type: () -> String?
    def video?: () -> bool
    def image?: () -> bool
    def audio?: () -> bool
    def representable?: () -> bool
    def analyze: () -> nil
    # `data` is the file's CONTENTS — the lowering reads the io at the
    # call site so nothing here has to name a File.
    def attach: (String data, String filename, String content_type) -> void
    def blob_key: (String filename) -> String
    def purge: () -> void
    # `Attached::One#destroy` — see the .rb: purge under Rails' name.
    def destroy: () -> void
  end
end

# See the .rb: the class-side surface an app reaches directly. Both
# raise — no storage service is modeled — and both are typed as what
# Rails answers so a call site that chains off one still resolves.
module ActiveStorage
  class Service
    def path_for: (String key) -> String
  end

  class Blob
    def self.service: () -> ActiveStorage::Service
    def self.create_and_upload!: (String io, String filename, String content_type) -> ActiveStorage::Blob
  end
end

# See the .rb: Active Storage's engine-mounted route helpers, reopened
# onto the app's generated RouteHelpers so a view that writes one
# compiles on every target and raises in one named place.
module RouteHelpers
  def self.rails_blob_path: (untyped attachment, ?disposition: String?, ?only_path: bool?) -> String
  def self.rails_blob_url: (untyped attachment, ?disposition: String?, ?only_path: bool?) -> String
end
