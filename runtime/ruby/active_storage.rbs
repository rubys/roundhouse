# Typing contract for active_storage.rb beside this file.
#
# Rows are answered here; bytes go through `Service`, whose methods
# raise in the shared runtime and are reopened per target; variants are
# identity (see the .rb header).
module ActiveStorage
  def self.default_variable_content_types: () -> Array[String]
  def self.variable_content_types: () -> Array[String]
  def self.variable_content_type?: (String content_type) -> bool
  def self.url_filename: (String filename) -> String

  class Service
    def path_for: (String key) -> String
    def upload: (String key, String data) -> void
    def download: (String key) -> String
    def delete: (String key) -> void
    def exist?: (String key) -> bool
  end

  class BlobMetadata
    @width: Integer
    @height: Integer
    def initialize: (Integer width, Integer height) -> void
    def []: (Symbol key) -> Integer?
    def width: () -> Integer
    def height: () -> Integer
    def to_json: () -> String
    def self.int_field: (String json, String name) -> Integer
    def self.parse: (String json) -> ActiveStorage::BlobMetadata
  end

  class Blob
    @id: Integer
    @key: String
    @filename: String
    @content_type: String
    @byte_size: Integer
    @metadata: ActiveStorage::BlobMetadata
    def initialize: (Integer id, String key, String filename, String content_type, Integer byte_size, ActiveStorage::BlobMetadata metadata) -> void
    def id: () -> Integer
    def key: () -> String
    def filename: () -> String
    def content_type: () -> String
    def byte_size: () -> Integer
    def metadata: () -> ActiveStorage::BlobMetadata
    def self.columns: (String alias_prefix) -> String
    def self.from_row: (Hash[String, untyped] row) -> ActiveStorage::Blob
    def self.find: (Integer id) -> ActiveStorage::Blob?
    def self.find_by_key: (String key) -> ActiveStorage::Blob?
    def self.find_signed: (String signed_id) -> ActiveStorage::Blob?
    def signed_id: () -> String
    def self.service: () -> ActiveStorage::Service
    def self.generate_key: (String filename, Integer byte_size) -> String
    # `data` is the file's CONTENTS — the lowering reads the io at the
    # call site so nothing here has to name a File.
    def self.create_and_upload!: (String data, String filename, String content_type) -> ActiveStorage::Blob
    # Rails' attachable coercion (an uploaded file, a blob, …). Raises
    # here; the ruby family reopens it with the class tests.
    def self.from_attachable: (untyped value) -> ActiveStorage::Blob?
    def download: () -> String
    def purge: () -> nil
    def video?: () -> bool
    def image?: () -> bool
    def audio?: () -> bool
    def variable?: () -> bool
    def url: (String disposition) -> String
  end

  class ImageAnalyzer
    def self.dimensions: (String data, String content_type) -> Array[Integer]
  end

  class VariantWithRecord
    @attached: ActiveStorage::Attached
    @name: String
    def initialize: (ActiveStorage::Attached attached, String name) -> void
    def processed: () -> ActiveStorage::VariantWithRecord
    def image: () -> ActiveStorage::Attached
    def blob: () -> ActiveStorage::Blob?
    def key: () -> String
    def url: () -> String
  end

  class Attached
    @record_type: String
    @record_id: Integer
    @name: String
    # The remembered attachment row: `attachment_id` 0 = nothing attached.
    @row_loaded: bool
    @attachment_id: Integer
    @blob: ActiveStorage::Blob?
    def initialize: (String record_type, Integer record_id, String name) -> void
    def load_row: () -> nil
    def _preload_row: (Integer attachment_id, ActiveStorage::Blob? blob) -> nil
    def attached?: () -> bool
    def blob: () -> ActiveStorage::Blob?
    def filename: () -> String?
    def content_type: () -> String?
    def key: () -> String
    def signed_id: () -> String
    def byte_size: () -> Integer
    def metadata: () -> ActiveStorage::BlobMetadata
    def video?: () -> bool
    def image?: () -> bool
    def audio?: () -> bool
    def variable?: () -> bool
    def previewable?: () -> bool
    def representable?: () -> bool
    def analyze: () -> nil
    # The named variant (`:thumb`) or an inline transformation hash;
    # identity either way, the name survives into the URL.
    def variant: (Symbol | Hash[Symbol, untyped] transformations) -> ActiveStorage::VariantWithRecord
    def representation: (Symbol | Hash[Symbol, untyped] transformations) -> ActiveStorage::VariantWithRecord
    def variant_name: (Symbol | Hash[Symbol, untyped] transformations) -> String
    def preview: (Symbol | Hash[Symbol, untyped] transformations) -> ActiveStorage::VariantWithRecord
    def url: () -> String
    def attach_blob: (ActiveStorage::Blob blob) -> nil
    def attach: (String data, String filename, String content_type) -> nil
    def purge: () -> nil
    # `Attached::One#destroy` — see the .rb: purge under Rails' name.
    def destroy: () -> nil
  end
end

# See the .rb: Active Storage's engine-mounted route helpers, reopened
# onto the app's generated RouteHelpers so a view that writes one
# compiles on every target.
module RouteHelpers
  def self.rails_blob_path: (ActiveStorage::Attached attachment, ?disposition: String?, ?only_path: bool?) -> String
  def self.rails_blob_url: (ActiveStorage::Attached attachment, ?disposition: String?, ?only_path: bool?) -> String
  def self.rails_representation_path: (ActiveStorage::VariantWithRecord variant, ?only_path: bool?) -> String
  def self.rails_representation_url: (ActiveStorage::VariantWithRecord variant, ?only_path: bool?) -> String
end
