# Typing contract for active_storage.rb beside this file.
#
# `attached?` is the one question this half of Active Storage can
# answer; the rest raise (see the body for why).
module ActiveStorage
  class Attached
    @record_type: String
    @record_id: Integer
    @name: String
    def initialize: (String record_type, Integer record_id, String name) -> void
    def attached?: () -> bool
    def variable?: () -> bool
    def variant: (untyped transformations) -> untyped
    def url: () -> String
    def filename: () -> String?
    def content_type: () -> String?
    def blob_column: (String column) -> String?
    def video?: () -> bool
    def image?: () -> bool
    def audio?: () -> bool
    def representable?: () -> bool
    def analyze: () -> nil
    # `data` is the file's CONTENTS — the lowering reads the io at the
    # call site so nothing here has to name a File.
    def attach: (String data, String filename, String content_type) -> void
    def blob_key: (String filename) -> String
    def purge: () -> void
  end
end
