module Rails
  def self.env: () -> Env
  def self.env_name: () -> String?
  def self.env_name=: (String? name) -> String?
  def self.secret_key_base: () -> String?
  def self.secret_key_base=: (String? key) -> String?
  def self.root: () -> AppPath
  def self.public_path: () -> AppPath
  def self.cache: () -> Cache
  def self.logger: () -> Logger
  def self.application: () -> Application

  class AppPath
    @base: String

    def initialize: (String base) -> void
    def join: (String part) -> AppPath
    def +: (String part) -> AppPath
    def to_s: () -> String
    def to_path: () -> String
  end

  class Env
    @name: String

    def initialize: (String name) -> void
    def development?: () -> bool
    def production?: () -> bool
    def test?: () -> bool
    def staging?: () -> bool
  end

  class Cache
    @entries: Hash[String, String]
    @expires_at: Hash[String, Integer]
    def initialize: () -> void
    def fetch: (untyped key, ?Hash[untyped, untyped] opts) { () -> untyped } -> untyped
    def fetch_str: (String key, Integer ttl) { () -> String } -> String
    def read: (untyped key) -> untyped
    def write: (untyped key, untyped value) -> untyped
    def delete: (untyped key) -> untyped
    def exist?: (untyped key) -> bool
  end

  class Logger
    def info: (untyped message) -> void
    def error: (untyped message) -> void
    def warn: (untyped message) -> void
    def debug: (untyped message) -> void
    def fatal: (untyped message) -> void
  end

  class Application
    def session_cookie_key: () -> String
    def secret_key_base: () -> String
    def config_time_zone: () -> String
  end
end
