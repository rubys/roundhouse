module ActionController
  def self.header_key_ok?: (String? k) -> bool
  def self.header_value_ok?: (String? v) -> bool
  def self.header_control?: (String c) -> bool
  def self.sanitize_location: (String path) -> String
  def self.strip_leading_controls: (String s) -> String
  def self.strip_trailing_controls: (String s) -> String
  def self.location_host: (String url) -> String
  def self.find_substr: (String hay, String needle) -> Integer
  def self.find_last: (String hay, String needle) -> Integer
  def self.forgery_flag: () -> bool
  def self.set_forgery_flag: (bool value) -> void
  def self.masked_authenticity_token: () -> String
  def self.csrf_token_valid?: (String given, String expected) -> bool

  class HeaderStore
    @keys: Array[String]
    @vals: Array[String?]
    def initialize: () -> void
    def []: (String key) -> String?
    def []=: (String key, String? value) -> void
    def size: () -> Integer
    def key_at: (Integer i) -> String
    def val_at: (Integer i) -> String
  end
  # Symbolic-status to integer-code mapping (`STATUS_CODES`) is a
  # Ruby-level frozen Hash literal — module-level constant, not a
  # method. RBS doesn't require declaring constants for the strict
  # test (the test exercises method bodies); it's read inside
  # `resolve_status`, which raises when the symbol isn't in it.

  # Base controller. Holds per-request state (params, session, flash)
  # and response state (status, body, location). Subclasses define
  # their actions and override process_action. (`cookies` is a
  # CRuby-only overlay feature — see runtime/action_controller_cookies.rb
  # — so it isn't declared on the shared/transpiled Base.)
  class Base
    def self.allow_forgery_protection: () -> bool
    def self.allow_forgery_protection=: (bool) -> void
    # `attr_accessor` produces getter+setter pairs for each name.
    # `params` is a String-keyed Hash whose values are recursive
    # `Roundhouse::ParamValue` — String leaves, nested Hashes, and
    # Arrays (Rails-shape `comment[author][name]=x`, `tags[]=a`).
    # Each target's runtime declares its own recursive realization
    # (`runtime/crystal/param_value.cr`, `runtime/typescript/
    # param_value.ts`, etc.); the body-typer carries the class id
    # uniformly. `request_method` and `request_path` are populated
    # by the dispatcher before invoking the action.
    def params: () -> Hash[String, Roundhouse::ParamValue]
    def params=: (Hash[String, Roundhouse::ParamValue]) -> Hash[String, Roundhouse::ParamValue]
    def session: () -> ActionDispatch::Session
    def session=: (ActionDispatch::Session) -> ActionDispatch::Session
    def reset_session: () -> ActionDispatch::Session
    def assign_http_session: (ActionDispatch::Session value) -> ActionDispatch::Session
    def flash: () -> ActionDispatch::Flash
    def flash=: (ActionDispatch::Flash) -> ActionDispatch::Flash
    def request_method: () -> String
    def request_method=: (String) -> String
    def request_path: () -> String
    def request_path=: (String) -> String
    def request_format: () -> Symbol
    def request_format=: (Symbol) -> Symbol
    def query_string: () -> String
    def query_string=: (String) -> String
    def accepts_any_format: () -> bool
    def accepts_any_format=: (bool) -> bool
    def path_parameters: () -> Hash[String, String]
    def path_parameters=: (Hash[String, String]) -> Hash[String, String]
    @headers: ActionController::HeaderStore
    def action_name: () -> String
    def assign_action_name: (Symbol name) -> String

    # Rails' demodulized underscored leaf (`ArticlesController` →
    # `"articles"`) and the path form that keeps namespaces
    # (`Admin::UsersController` → `"admin/users"`).
    def controller_name: () -> String
    def controller_path: () -> String

    # `attr_reader` — getter only. Setters are internal (assigned via
    # `@status =`, `@body =`, `@location =` from render/redirect_to/head).
    def status: () -> Integer
    def body: () -> String
    def response_body: () -> String
    def response_body=: (String? value) -> String
    def location: () -> String?
    def content_type: () -> String
    def media_type: () -> String
    def content_type=: (String value) -> String

    # True once render/redirect_to/head has produced a response — the
    # halting check the synthesized before_action preamble runs after
    # each filter that can render or redirect (Rails: a filter that
    # responds halts the chain and skips the action).
    def performed?: () -> bool

    def initialize: () -> void

    # Subclasses override; base raises NotImplementedError. The
    # contract is what subclasses MUST satisfy; declare the contract
    # type even though the Base body itself never returns one — `raise`
    # is divergent and doesn't contradict the declared return.
    %a{abstract}
    def process_action: (Symbol _action_name) -> void

    # `render(body, status:, content_type:, location:)` — sets @body,
    # @status, and optionally @content_type / @location. `status:` is
    # monomorphic Symbol (was untyped Symbol|Integer; real-blog only
    # passes Symbol forms — `:ok`, `:created`, `:unprocessable_entity`
    # etc. — and STATUS_CODES maps them). Callers needing a literal
    # integer code coerce upstream.
    def render: (
      String body,
      ?status: Symbol,
      ?content_type: String?,
      ?location: String?
    ) -> void

    # `redirect_to(path, notice:, alert:, status:)` — sets @location,
    # @status, @flash entries. `status:` typed Symbol (see render).
    def redirect_to: (
      String path,
      ?notice: String?,
      ?alert: String?,
      ?status: Symbol
    ) -> void

    # `head(:no_content, content_type: "application/json")` — empty
    # body, status only; content_type optional.
    def head: (Symbol status, ?content_type: String?, ?location: String?) -> void
    def response: () -> Base
    def fresh_when: (untyped subject) -> void
    def stale?: (?etag: untyped) -> bool
    # Integer SECONDS — `lower::duration::rewrite_expires_in` grounds the
    # corpus' `1.year` / `1.week` before the call reaches here.
    def expires_in: (Integer seconds, ?public: bool, ?stale_while_revalidate: Integer) -> void
    def cache_control_max_age: () -> Integer
    def cache_control_public: () -> bool
    def headers: () -> ActionController::HeaderStore
    def send_data: (String data, ?type: String, ?disposition: String) -> void
    def verify_authenticity_token: () -> void
    def verified_request?: () -> bool
    def csrf_session_secret: () -> String
    def csrf_header_token: () -> String
    def request_for_csrf: () -> untyped
    def same_host_location: (String loc) -> String
    def request_host_for_redirect: () -> String

    # Monomorphic on Symbol — body looks up STATUS_CODES. Integer
    # pass-through was previously supported via `is_a?(Integer)`
    # narrowing; that branch is removed since real-blog never uses it.
    def resolve_status: (Symbol s) -> Integer
  end
end
