# Typing contract for cookies.rb beside this file. Getter+setter def pairs
# per the runtime .rbs convention; keys are String | Symbol (controllers
# index with Symbol constants and String literals both). Values written
# stay untyped — campfire assigns `@room.id` (Integer) and `raw_set`
# coerces with `to_s`.
module ActionController
  class CookieJar
    # THE STORES, DECLARED. Both are seeded `{}` in the constructor, and
    # an undeclared ivar is inferred from that bare literal — so `to_h`'s
    # `@inbound.merge(@out)` came out `Hash[String, untyped]` and
    # OVERRODE the `Hash[String, String]` declared for it three lines
    # down. campfire's `parsed_cookies` then handed a `sp_StrPolyHash *`
    # to `CookieJar.build`, whose parameter the same file declares
    # `Hash[String, String]`: one contract, contradicted by an ivar
    # nobody had described.
    #
    # Honest, not convenient: `raw_set` is `@out[key.to_s] = value.to_s`,
    # so the store really is String-valued — which is what the `[]=`
    # comment below already says.
    @inbound: Hash[String, String]
    @out: Hash[String, String]
    @flag_httponly: Hash[String, String]
    @flag_samesite: Hash[String, String]
    @flag_secure: Hash[String, String]
    @flag_expires: Hash[String, String]

    def initialize: (?Hash[String, String] inbound) -> void
    def []: (String | Symbol key) -> String
    # The written value is untyped and the STORE is String: `raw_set`
    # coerces, because a cookie is a String on the wire and campfire
    # writes `cookies.permanent[:last_room] = @room.id`, an Integer.
    # Returning the stored String rather than the argument keeps the
    # return concrete; Ruby's `x[k] = v` evaluates to `v` regardless.
    def []=: (String | Symbol key, untyped value) -> String
    def permanent: () -> ActionController::PermanentCookieJar
    def signed: () -> ActionController::SignedCookieJar
    def encrypted: () -> ActionController::EncryptedCookieJar
    def raw: (String | Symbol key) -> String
    def raw_set: (String | Symbol key, untyped value) -> String
    def record_flags: (String | Symbol key, bool httponly, String | Symbol same_site, bool secure) -> String
    def flag_httponly?: (String | Symbol key) -> bool
    def flag_samesite: (String | Symbol key) -> String
    def flag_secure?: (String | Symbol key) -> bool
    def record_permanent: (String | Symbol key) -> String
    def flag_expires: (String | Symbol key) -> String
    def self.permanent_expires: () -> String
    def delete: (String | Symbol key) -> String
    def pending: () -> Hash[String, String]
    def to_h: () -> Hash[String, String]
    def to_hash: () -> Hash[String, String]
    def each: () { (String, String) -> void } -> ActionController::CookieJar
  end

  class SignedCookieJar
    @jar: ActionController::CookieJar
    @permanent: bool

    def initialize: (ActionController::CookieJar jar, ?bool permanent) -> void
    # NULLABLE, unlike the unsigned jar's read — see the .rb.
    def []: (String | Symbol key) -> String?
    def []=: (String | Symbol key, untyped value) -> untyped
    def permanent: () -> ActionController::SignedCookieJar
    def delete: (String | Symbol key) -> String
    def self.value_of: (Hash[Symbol, untyped] | String | Integer | Symbol | bool value) -> String
  end

  # `cookies.encrypted`: reads answer what the cookie's JSON holds (a
  # Hash, a String, an Integer...), so the read is untyped and nilable;
  # writes take any value JSON can carry.
  class EncryptedCookieJar
    @jar: ActionController::CookieJar
    @permanent: bool

    def initialize: (ActionController::CookieJar jar, ?bool permanent) -> void
    def []: (String | Symbol key) -> untyped
    def []=: (String | Symbol key, untyped value) -> untyped
    def permanent: () -> ActionController::EncryptedCookieJar
    def delete: (String | Symbol key) -> String
    def self.value_of: (untyped value) -> untyped
    def self.parse: (String json) -> untyped
    def self.permanent_time: () -> ::Time
  end

  class PermanentCookieJar
    @jar: ActionController::CookieJar

    def initialize: (ActionController::CookieJar jar) -> void
    def []: (String | Symbol key) -> String
    # The value union `SignedCookieJar.value_of` already names, not
    # `untyped`: a new writer must not add to the Bar B residual
    # (tests/runtime_src_integration.rs), and these are the shapes a
    # cookie write takes.
    def []=: (String | Symbol key, Hash[Symbol, untyped] | String | Integer | Symbol | bool value) -> String
    def signed: () -> ActionController::SignedCookieJar
    def encrypted: () -> ActionController::EncryptedCookieJar
    def delete: (String | Symbol key) -> String
  end

  class Base
    def cookies: () -> ActionController::CookieJar
    def cookies=: (ActionController::CookieJar value) -> ActionController::CookieJar
  end
end

# Rails' own name for the jar, as a constructor onto the implementation
# above — see the comment at the foot of cookies.rb.
module ActionDispatch
  module Cookies
    class CookieJar
      def self.build: (ActionDispatch::Request request, Hash[String, String] cookies) -> ActionController::CookieJar
    end
  end
end
