# Typing contract for the per-request context statics (current.rb
# beside this file). Getter+setter def pairs per the runtime .rbs
# convention.
module ActionController
  class Base
    def request: () -> ActionDispatch::Request?
    def request=: (ActionDispatch::Request?) -> ActionDispatch::Request?
    def request_host_for_redirect: () -> String
    def request_protocol_for_url: () -> String
    def request_for_csrf: () -> ActionDispatch::Request?
    def csrf_header_token: () -> String
    def fresh_when: (untyped subject) -> void
    def stale?: (?etag: untyped) -> bool
    def conditional_get_verb_ok?: () -> bool
    def conditional_get_verb: () -> String
    def fresh_when_etag_source: (untyped subject) -> String?
    def weak_etag_for: (String src) -> String
    def request_if_none_match: () -> String?
    def if_none_match_matches?: (String inm, String tag) -> bool
    def if_none_match_parts_match?: (Array[String] parts, Integer i, String want) -> bool
    def if_none_match_members: (String inm) -> Array[String]
    def if_none_match_members_at: (String s, Integer i, String buf, bool in_quote, Array[String] out) -> Array[String]
    def normalize_etag: (String value) -> String?
  end

  module Current
    def self.request: () -> ActionDispatch::Request?
    def self.request=: (ActionDispatch::Request? value) -> ActionDispatch::Request?
    def self.controller: () -> ActionController::Base?
    def self.controller=: (ActionController::Base? value) -> ActionController::Base?
    def self.session: () -> ActionDispatch::Session?
  end
end
