# Typing contract for the ruby-family ViewHelpers extensions.
module ActionView
  module ViewHelpers
    def self.content_security_policy_nonce: () -> String
    def self.class_names: (*untyped args) -> String
    def self.number_with_delimiter: (Integer value) -> String
    def self.sanitize_to_id: (String name) -> String
    def self.capture: () { () -> untyped } -> String
    def self.concat: (String string) -> String
    def self.polymorphic_url: (untyped record, ?only_path: bool) -> String
    def self.hidden_field_tag: (untyped name, ?untyped value, ?Hash[Symbol, untyped] opts) -> String
    def self.number_with_precision: (untyped value, ?precision: Integer) -> String
    def self.number_to_human: (Integer value, ?format: String) -> String
    # `::Time`, not `Time` — these sigs sit inside `module ActionView`,
    # where a bare `Time` resolves to `ActionView::Time` and types the
    # params as an unknown class, leaving the whole body's arithmetic
    # untyped. (Same shadowing shape the view-constant rooting fixes on
    # the emit side.)
    def self.time_ago_in_words: (::Time from_time, ?include_seconds: bool) -> String
    def self.distance_of_time_in_words: (::Time from_time, ::Time to_time, ?include_seconds: bool) -> String
    def self.strip_tags: (String html) -> String
    def self.sanitize: (String html) -> String
    def self.sanitize_allowing: (String html, Array[String] tags, Array[String] attributes) -> String
    # The safe-list engine and its ported rule tables.
    def self.sanitize_engine: (String s, Array[String] tags, Array[String] attributes) -> String
    def self.sanitize_default_tags: () -> Array[String]
    def self.sanitize_default_attributes: () -> Array[String]
    def self.sanitize_uri_attributes: () -> Array[String]
    def self.sanitize_allowed_protocols: () -> Array[String]
    def self.sanitize_data_mediatypes: () -> Array[String]
    def self.sanitize_void_elements: () -> Array[String]
    def self.sanitize_rawtext_elements: () -> Array[String]
    def self.sanitize_unservable_tags: () -> Array[String]
    def self.sanitize_space?: (String c) -> bool
    def self.sanitize_tag_name: (String raw) -> String
    def self.sanitize_foreign_end: (String s, Integer from, String name) -> Integer
    def self.sanitize_rawtext_close_at: (String s, Integer from, String name) -> Integer
    def self.sanitize_open_tag: (String name, String raw, Array[String] attrs) -> String
    def self.sanitize_blank_value?: (String value) -> bool
    def self.sanitize_text: (String t) -> String
    def self.sanitize_attr_value: (String value) -> String
    def self.sanitize_uri_allowed?: (String value) -> bool
    def self.sanitize_uri_separator_length: (String t, Integer i) -> Integer
    def self.sanitize_uri_strip: (String value) -> String
    def self.sanitize_uri_decode: (String value, bool first_pass) -> String
    def self.sanitize_codepoint_char: (Integer cp) -> String?
    def self.tag_open_at?: (String s, Integer i) -> bool
    def self.tag_end_index: (String s, Integer i) -> Integer?
    def self.entity_reference_length: (String s, Integer i) -> Integer
    # `auto_link` and its scanner. `html` is the caller's attribute hash
    # (campfire passes `{ target: "_blank" }`) — one element type, not a
    # bag; `link` is `:all` / `:urls` / `:email_addresses`.
    def self.auto_link: (String text, ?html: Hash[Symbol, String], ?link: Symbol, ?sanitize: bool) -> String
    def self.auto_link_anchor_open?: (String tag) -> bool
    def self.auto_link_anchor_close?: (String tag) -> bool
    def self.auto_link_url_length: (String s, Integer i) -> Integer
    def self.auto_link_url_prefix_end: (String s, Integer i) -> Integer
    def self.auto_link_scheme?: (String name) -> bool
    def self.auto_link_url_char?: (String c) -> bool
    def self.auto_link_word_char?: (String c) -> bool
    def self.auto_link_url: (String matched, Hash[Symbol, String] html) -> String
    def self.auto_link_url_tail_char?: (String c) -> bool
    def self.auto_link_bracket_opening: (String c) -> String
    def self.auto_link_count: (String s, String c) -> Integer
    def self.auto_link_anchor: (String href, String text, Hash[Symbol, String] html) -> String
    def self.auto_link_email_length: (String s, Integer i) -> Integer
    def self.auto_link_email_local_char?: (String c) -> bool
    def self.auto_link_email_start_char?: (String c) -> bool
    def self.auto_link_email_domain_char?: (String c) -> bool
  end
end
