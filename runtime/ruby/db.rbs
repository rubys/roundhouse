# Typing contract for the Db primitive surface — backend-agnostic.
# Every Db shim (cruby/sqlite-gem, spinel-FFI/sqlite, future
# postgres/etc.) satisfies this signature. See runtime/spinel/db.rb for
# the description and project_level_3_adapter_emit.md for the
# architectural role.
#
# `prepare` returns an opaque stmt handle that subsequent step?/column_*/
# finalize calls take by reference. Under the cruby shim it's a per-call
# Integer id; under the planned FFI shim it'll be a `:ptr`. Body-typer
# treats it as Integer here — sufficient for the lowered IR; per-target
# narrowing happens at emit time.
module Db
  def self.configure: (String, ?pool_size: Integer) -> void
  # `ActiveRecord::Base.connection_db_config` and `transaction_open?`
  # (runtime/spinel/active_record_db_config.rb): the configured
  # database, the adapter name Rails reports for it, and whether the
  # holder is in a transaction of its own (not the request snapshot).
  def self.database_path: () -> String
  def self.adapter_name: () -> String
  def self.transaction_open?: () -> bool
  def self.close: () -> void
  def self.exec: (String) -> void
  def self.prepare: (String) -> Integer
  # Reads with too many SQL shapes bypass the cache; finalize releases them.
  def self.prepare_uncached: (String) -> Integer
  def self.step?: (Integer) -> bool
  def self.column_int: (Integer, Integer) -> Integer
  def self.column_float: (Integer, Integer) -> Float
  def self.column_text: (Integer, Integer) -> String
  # Nullable-column reads: NULL comes back as nil, not the type's zero.
  # The lowerer emits these for columns the schema declares nullable —
  # a nullable UNIQUE column must not read back "" for every unset row,
  # and `where(fk: nil)` must match the rows that never set it.
  def self.column_int_opt: (Integer, Integer) -> Integer?
  def self.column_float_opt: (Integer, Integer) -> Float?
  def self.column_text_opt: (Integer, Integer) -> String?
  def self.column_bool_opt: (Integer, Integer) -> bool?
  def self.finalize: (Integer) -> void
  # Placeholder binding (roundhouse#12) — bind a `?` param (1-based) on a
  # prepared stmt before the first step?, when the ROUNDHOUSE_PARAM_BINDS
  # gate emits parameterized queries. Keys the prepared-statement cache
  # on the static query shape instead of per-value. Every Db shim
  # (cruby-gem + spinel-FFI) implements these.
  def self.bind_int: (Integer, Integer, Integer?) -> void
  def self.bind_text: (Integer, Integer, String) -> void
  # A nullable boolean binds SQL NULL, never the false/0 representation.
  def self.bind_bool: (Integer, Integer, bool?) -> void
  def self.bind_int_opt: (Integer, Integer, Integer?) -> void
  def self.bind_text_opt: (Integer, Integer, String?) -> void
  def self.bind_bool_opt: (Integer, Integer, bool?) -> void
  # A write with a RETURNING clause (roundhouse#91): runs like `exec`
  # (and clears the query cache like it), then answers a handle over the
  # returned rows: step?/column_*/finalize as for a read. `changes` is
  # the write's affected-row count.
  def self.exec_returning: (String) -> Integer
  def self.last_insert_rowid: () -> Integer
  def self.changes: () -> Integer
  # Query-log capture (issue #27) — records the SQL each prepare/exec
  # issues during the block, returned as an Array of SQL strings. The
  # test-side analog of Rails' `capture_sql`; `record_query` is the
  # funnel hook prepare/exec call.
  def self.capture_sql: () { () -> void } -> Array[String]
  def self.record_query: (String) -> void
  # SQL-value escaping primitives. Lowerer-emitted code uses these
  # to inline values into SQL strings (spinel FFI can't bind_text;
  # the cruby gem also accepts inlined values).
  def self.escape_string: (String) -> String
  def self.escape_int: (Integer) -> String
  def self.escape_int_list: (Array[Integer]) -> String
  # Nullable-column writes: nil renders the SQL keyword NULL, so a
  # column the schema calls nullable round-trips as nil rather than as
  # the type's zero.
  def self.escape_string_opt: (String?) -> String
  def self.escape_int_opt: (Integer?) -> String
  def self.escape_float_opt: (Float?) -> String
  def self.escape_bool_opt: (bool?) -> String
  # Per-thread `ActiveRecord::Base.transaction` nesting depth
  # (connection.rb): 0 outside any open transaction, incremented by a
  # joining nested call. A typed accessor instead of a raw
  # `Thread.current`/`Fiber[]` read so connection.rb's `self.transaction`
  # body stays concretely typed — each shim boxes it behind its own
  # in-lease storage convention (`Thread.current` in the spinel-FFI
  # shim, `Fiber[]` in the cruby/jruby gem shims, same as their own
  # `current_dbh`/`current_conn`).
  def self._txn_depth: () -> Integer
  def self._txn_depth=: (Integer) -> Integer
end
