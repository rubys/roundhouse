#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "roundsnap"

out_dir = nil
units_path = nil
OptionParser.new do |o|
  o.banner = "Usage: roundsnap-compile --out DIR [--units FILE|-]"
  o.on("--out DIR", "Output directory for manifest.json and iseq/") { |v| out_dir = v }
  o.on("--units FILE", "JSON array of units (default: stdin)") { |v| units_path = v }
end.parse!

abort "roundsnap-compile: --out is required" if out_dir.nil? || out_dir.empty?

raw = if units_path.nil? || units_path == "-"
  $stdin.read
else
  File.read(units_path)
end

units = JSON.parse(raw)
abort "roundsnap-compile: units JSON must be an Array" unless units.is_a?(Array)

manifest = Roundsnap::Compiler.compile!(units: units, out_dir: out_dir)
n = manifest.fetch("units").size
puts "wrote #{n} unit(s) to #{out_dir}"
